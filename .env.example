# Local development environment (copy to the files noted, fill real values).
# In production/dev these are Cloudflare Worker secrets (wrangler secret put),
# NOT committed. Real .env / .dev.vars are gitignored.

# → .dev.vars   (wrangler-injected secrets for `astro dev` / the Worker)
EMDASH_OAUTH_GITHUB_CLIENT_ID=your-github-oauth-client-id
EMDASH_OAUTH_GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# → .env
EMDASH_ENCRYPTION_KEY=generate-a-strong-random-key
# Pin so preview tokens verify across workers (optional but recommended):
# EMDASH_PREVIEW_SECRET=another-strong-random-key

# ── CI / deploy (set as GitHub repo secrets, not files) ──────────────────────
# CLOUDFLARE_API_TOKEN=...      # Workers + D1 + R2 edit
# CLOUDFLARE_ACCOUNT_ID=...
# VITOPS_DEV_D1_ID=...          # from `wrangler d1 create vitops-dev`
# EMDASH_TOKEN=...              # admin API token, for schema/content promotion
# PROMOTE_TOKEN=...             # optional: PAT/App token to auto-merge into main
