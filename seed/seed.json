                },
                {
                  "_key": "d08",
                  "tone": "brand-secondary",
                  "color": "amber-300",
                  "eyebrow": "Marketing",
                  "title": "Get found by more customers",
                  "body": "We manage your website, Google listing, ads and social media to bring in more leads.",
                  "cta_label": "Explore marketing",
                  "href": "/digital-marketing"
                }
              ]
            },
            {
              "_type": "vitops_section",
              "_version": 1,
              "_key": "h14",
              "layout": "stack",
              "kicker": "The problem",
              "heading": "You didn’t start a business to manage software or post on Instagram.",
              "sub": "But someone has to do it. Most owners end up with one of these options.",
              "body": [
                {
                  "_type": "vitops.cards",
                  "_key": "p13",
                  "columns": "3",
                  "cards": [
                    {
                      "_key": "c10",
                      "title": "Hire someone",
                      "body": "A full-time IT or marketing person is expensive. A small team often doesn’t have enough work to keep them busy."
                    },
                    {
                      "_key": "c11",
                      "title": "Do it yourself",
                      "body": "Every hour you spend on admin is an hour you’re not spending on customers."
                    },
                    {
                      "_key": "c12",
                      "title": "Put it off",
                      "body": "Security gaps grow, you pay for software you don’t use, and competitors show up ahead of you in search."
                    }
                  ]
                },
                {
                  "_type": "vitops.stats",
                  "_key": "h17",
                  "tone": "neutral",
                  "color": "",
                  "stats": [
                    {
                      "_key": "i15",
                      "value": "11 hrs/week",
                      "label": "Owners spend about 11 hours a week on admin. That’s almost twice the time they spend on sales and growth."
                    },
                    {
                      "_key": "i16",
                      "value": "82%",
                      "label": "of owners who hand off work grew their revenue in two years. Only 66% of owners who don’t hand off work did."
