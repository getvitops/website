{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vitops",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Custom domain — Cloudflare provisions the DNS record + TLS cert on deploy.
  // Requires the zone (vitops.ca) to already exist in this Cloudflare account.
  "routes": [
    {
      "pattern": "vitops.ca",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vitops",
      "migrations_dir": "../../../../migrations",
      "database_id": "2a948eed-4119-4710-9dc0-3147ad0f254c",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "vitops",
    },
  ],
  // Cloudflare Email Sending — the contact form (src/pages/api/contact.ts)
  // calls env.EMAIL.send(). The `from` domain (send.vitops.ca) is onboarded
  // for Email Sending (the apex vitops.ca is not); sending from any other
  // domain fails DKIM and bounces.
  "send_email": [{ "name": "EMAIL" }],
  // Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
  "triggers": {
    "crons": ["* * * * *"],
  },
  // ── Dev environment ──────────────────────────────────────────────────────
  // NOTE: wrangler `"env": { "dev": … }` blocks do NOT work here — the
  // @astrojs/cloudflare adapter regenerates dist/server/wrangler.json at build
  // and strips the top-level `env` key, so `wrangler deploy --env dev` never
  // sees it. Instead we post-process the generated config into a flat dev
  // config and deploy that. See scripts/build-dev-wrangler.mjs and the
  // `deploy:dev` script in package.json. Dev binds isolated vitops-dev D1 + R2
  // so Claude's content/schema edits on dev never touch prod.
  //
  // One-time prereqs (your Cloudflare account — run via `! wrangler ...`):
  //   wrangler d1 create vitops-dev        → export VITOPS_DEV_D1_ID=<id>
  //   wrangler r2 bucket create vitops-dev
  //   (dev.vitops.ca custom domain is provisioned on first deploy; the
  //    vitops.ca zone must already exist in the account)
}
