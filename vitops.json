      ]
    },
    "fonts": [
      {
        "name": "Geist",
        "provider": "google",
        "cssVariable": "--font-geist",
        "weights": [400, 500, 600],
        "styles": ["normal"],
        "subsets": ["latin"],
        "preload": true
      },
      {
        "name": "Geist Mono",
        "provider": "google",
        "cssVariable": "--font-geist-mono",
        "weights": [400, 500],
        "styles": ["normal"],
        "subsets": ["latin"]
      }
    ],
    "seo": {
      "defaultDescription": "Marketing and software management for small businesses in Ottawa and across Ontario."
    },
    "notifications": {
      "email": "hi@vitops.ca"
    },
    "templates": {
      "contact": {
        "type": "form",
        "action": "/api/track",
        "method": "post",
        "honeypot": true,
        "fields": [
          {
            "name": "interest",
            "type": "select",
            "label": "I’m interested in",
            "options": [
              {
                "label": "Managed software",
                "value": "Managed software"
              },
              {
                "label": "Digital Marketing",
                "value": "Digital Marketing"
              },
              {
                "label": "A package",
                "value": "A package"
              },
              {
                "label": "Not sure yet",
                "value": "Not sure yet"
              }
            ]
          },
          {
            "name": "name",
            "type": "text",
            "label": "Name",
            "required": true
          },
          {
            "name": "email",
            "type": "email",
            "label": "Work email",
            "required": true
          },
          {
            "name": "company",
            "type": "text",
            "label": "Company (optional)"
          },
          {
            "name": "message",
            "type": "textarea",
            "label": "Are you running ads now? (Google, Facebook and Instagram, or not yet)"
          },
          {
            "name": "topics",
            "type": "checkbox",
            "label": "Want a free review? Pick what we should look at",
            "options": [
              {
                "label": "Website",
                "value": "Website"
              },
              {
                "label": "Search and AI",
                "value": "Search and AI"
              },
              {
                "label": "Ads",
                "value": "Ads"
              },
              {
                "label": "Google profile",
                "value": "Google profile"
              },
              {
                "label": "Social media",
                "value": "Social media"
              },
              {
                "label": "Reviews and email",
                "value": "Reviews and email"
              },
              {
                "label": "Software",
                "value": "Software"
              },
              {
                "label": "Software costs",
                "value": "Software costs"
              },
              {
                "label": "Security and access",
                "value": "Security and access"
              },
              {
                "label": "AI tools",
                "value": "AI tools"
              },
              {
                "label": "Not sure",
                "value": "Not sure"
              }
            ]
          },
          {
            "name": "website_url",
            "type": "text",
            "label": "Your website"
          },
          {
            "name": "team_size",
            "type": "select",
            "label": "How many people are on your team?",
            "options": [
              {
                "label": "Just me",
                "value": "Just me"
              },
              {
                "label": "2 to 15",
                "value": "2 to 15"
              },
              {
                "label": "16 to 50",
                "value": "16 to 50"
              },
              {
                "label": "50+",
                "value": "50+"
              }
            ]
          }
        ]
      }
    },
    "chrome": {
      "masthead": {
        "position": "sticky",
        "surface": "glass",
        "layout": "full",
        "width": "content",
        "elevation": {
          "border": true
        },
        "height": "4rem"
      },
      "nav": {
        "compact": "drawer",
        "drawerSide": "end"
      }
    },
    "analytics": {
      "plausibleDomain": "vitops.ca"
    },
    "tracking": {
      "enabled": true,
      "category": "marketing",
      "platforms": ["google"]
    },
    "ads": {
      "google": {
        "accountId": "",
        "pixelId": "",
        "conversionLabel": {
          "call": "",
          "email": "",
          "form": ""
        },
        "enabled": false
      }
    },
    "crm": {
      "provider": "bigin",
      "bigin": {
        "dataCenter": "ca"
      }
    },
    "campaigns": {
      "provider": "zoho-campaigns",
      "zohoCampaigns": {
        "dataCenter": "com"
      },
      "lists": {
        "updates": {
          "label": "Email updates",
          "zohoCampaigns": {
            "listKey": ""
          }
        }
      },
      "enabled": false
    },
    "legal": {
      "cookieConsent": {
        "enabled": true
      },
      "jurisdiction": "ca",
      "privacyPolicy": {
        "enabled": true,
        "url": "https://vitops.ca/privacy",
        "lastUpdated": "2026-11-26"
      },
      "termsOfService": {
        "enabled": true,
        "url": "https://vitops.ca/terms",
        "lastUpdated": "2026-11-26"
      },
      "accessibilityStatement": {
        "enabled": true,
        "url": "https://vitops.ca/accessibility",
        "lastUpdated": "2026-11-26",
        "law": "aoda"
      }
    },
    "plan": {
      "key": "internal",
      "addons": ["server_side_tracking"]
    },
    "domains": {
      "canonical": "https://vitops.ca"
    },
    "deployment": {
      "platform": "cloudflare"
    }
  }
}
