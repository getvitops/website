{
  "name": "jury-regarding",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && vitops emdash check-prerender",
    "preview": "astro preview",
    "pull-content": "node scripts/pull-content.mjs",
    "prepare-local-db": "vitops emdash prepare-db",
    "deploy": "vitops email check && node scripts/pull-content.mjs && vitops emdash prepare-db && astro build && vitops emdash check-prerender && emdash migrate --wrangler-config wrangler.jsonc && wrangler deploy",
    "deploy:dev": "vitops email check && node scripts/pull-content.mjs && vitops emdash prepare-db && astro build && vitops emdash check-prerender && node scripts/build-dev-wrangler.mjs && emdash migrate --wrangler-config dist/server/wrangler.dev.json && wrangler deploy --config dist/server/wrangler.dev.json",
    "init:github": "vitops setup repo",
    "init:hosting": "vitops setup hosting",
    "setup": "vitops setup all",
    "typecheck": "astro check",
    "build:css": "vitops generate -i site.json -f tailwind -o src/styles",
    "lint:design": "vitops lint -i site.json -f tailwind --strict",
    "sop": "vitops generate -i site.json -f css -o .vitops/sop",
    "prepare": "vp config"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.4",
    "@astrojs/react": "^7.1.2",
    "@emdash-cms/cloudflare": "^1.4.0",
    "@getvitops/astro": "alpha",
    "@getvitops/core": "alpha",
    "@getvitops/emdash": "alpha",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "emdash": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@getvitops/cli": "alpha",
    "@iconify-json/fa7-solid": "^1.2.5",
    "lighthouse": "^13.6.0",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.157.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "emdash": {
    "seed": "seed/seed.json"
  }
}
