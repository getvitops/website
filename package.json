{
  "name": "vitops-website",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "build:dev": "astro build && node scripts/build-dev-wrangler.mjs",
    "deploy:dev": "astro build && node scripts/build-dev-wrangler.mjs && wrangler deploy --config dist/server/wrangler.dev.json",
    "typecheck": "astro check",
    "build:css": "vitops generate -i design-system.json -f tailwind -o src/styles",
    "prepare": "vp config"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.0.0",
    "@astrojs/react": "^6.0.0",
    "@emdash-cms/cloudflare": "^0.31.0",
    "@getvitops/astro": "^0.7.0",
    "@getvitops/emdash": "^0.2.0",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.0",
    "@microsoft/clarity": "^1.0.2",
    "astro": "^7.0.0",
    "astro-iconset": "^0.0.4",
    "emdash": "^0.31.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@cloudflare/workers-types": "^4.20260305.1",
    "@getvitops/cli": "^0.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vite-plus": "catalog:",
    "wrangler": "^4.111.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "emdash": {
    "label": "Marketing",
    "seed": "seed/seed.json"
  }
}
