# Dependencies
node_modules/

# Build output
dist/
# Adapter-generated at build time (immutable Cache-Control for /_astro/*)
public/_headers
# @getvitops/astro regenerates these on every build (favicons, manifest, WC bundles)
public/favicon.ico
public/favicon.svg
public/apple-touch-icon.png
public/icon-32.png
public/icon-192.png
public/icon-512.png
public/icon-mask.png
public/site.webmanifest
public/vitops/
# Written by scripts/sitemap.mjs on every build, from git history
public/sitemap-pages.xml

# Astro
.astro/

# Wrangler local state
.wrangler/

# Stray design-system export (not part of the site)
Vitops(1)/

# Data
data.db
data.db-shm
data.db-wal
uploads/

# Environment
.env
.env.*
!.env.example

# Wrangler local secrets
.dev.vars
.dev.vars.*

# IDE
.vscode/*
!.vscode/mcp.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# @getvitops/cli generate sidecars (tailwind.css is committed; these are reproducible)
src/styles/design-manifest.json
src/styles/tokens.json
# `generate` with a site config as --input also writes the legal documents into
# the output directory as HTML. The copies we actually render are the markdown
# in src/content/legal (see src/content.config.ts); these are a duplicate.
src/styles/legal/

# `vitops search notify` snapshot — the last-submitted sitemap state, used to
# resubmit only what changed. Machine-local; CI restores it from actions/cache.
.vitops/
