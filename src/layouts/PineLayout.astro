---
import { Font } from "astro:assets";
import VitopsHead from "@getvitops/astro/Head.astro";
import Analytics from "@getvitops/astro/Analytics.astro";
import CookieConsent from "@getvitops/astro/CookieConsent.astro";
import Tracking from "@getvitops/astro/Tracking.astro";
import { getSiteSettings } from "emdash";
import { EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { clarityEnabled, isProdStage } from "../lib/analytics";
// Design-system CSS, layout-scoped (getvitops css.inject: false): only pages
// rendered through PineLayout get it — keeps it out of /_emdash/admin, while
// EmDash previews (rendered through this layout) keep it.
import "../styles/site.css";
import "../styles/pine-theme.css";
// Single source of truth for the brand mark — the same file the favicon
// set is generated from. `?raw` inlines it at build time (no extra request).
import vitopsMark from "../assets/vitops-mark.svg?raw";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { title, description, image } = Astro.props;
const settings = await getSiteSettings();
const siteTitle = settings?.title || "Vitops";
const fullTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const siteDescription =
	settings?.tagline ||
	"Vitops runs the digital presence and the IT and HR operations for businesses that would rather focus on their craft.";

// Canonical must be the PUBLIC URL. Astro.originPathname is the pre-rewrite
// pathname, and the plain pathname when no rewrite happened — kept over
// Astro.url so any future internal rewrite can't leak into the canonical. The
// trailing-slash normalisation guards the same case (trailingSlash "ignore" +
// directory build format). Side effect (intended): query strings are dropped.
const canonicalPath =
	Astro.originPathname.length > 1 && Astro.originPathname.endsWith("/")
		? Astro.originPathname.replace(/\/+$/, "")
		: Astro.originPathname;

const pageCtx = createPublicPageContext({
	Astro,
	kind: "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: title ?? siteTitle,
	description: description || siteDescription,
	canonical: new URL(canonicalPath, Astro.url).href,
	image,
	seo: { ogImage: image },
	siteName: siteTitle,
});

// Two axes, two nav items. Services is what we do (the three pillars);
// Industries is who for. Industries is deliberately NOT inside the Services
// menu — it answers a different question, and nesting it collapses the
// distinction.
//
// Funding is deliberately NOT in the nav. It's a price objection handler, not a
// pillar: search traffic lands on /funding/* directly, and on-site readers meet
// it via the callout band, the CTA lines and the block on /pricing — all at the
// moment the cost question actually arises. A "Funding" nav item also reads like
// we're a grant consultancy, which we aren't. Footer keeps the links.
// See content-plan/ia.md.
const navLinks: { label: string; href: string; children?: { label: string; href: string }[] }[] = [
	{
		label: "Services",
		href: "/business-software",
		children: [
			{ label: "Business software", href: "/business-software" },
			{ label: "Back office", href: "/back-office" },
			{ label: "Digital presence", href: "/digital-presence" },
		],
	},
	{ label: "Industries", href: "/industries" },
	{ label: "Pricing", href: "/pricing" },
	{ label: "About", href: "/about" },
];

// Flattened for the drawer, where a nested disclosure buys nothing.
const drawerLinks = navLinks.flatMap((l) =>
	l.children ? l.children : [l],
);
const year = new Date().getFullYear();

// Whether this page gets analytics at all. Decided at BUILD time: public pages
// are prerendered, so there is no request to test a hostname against (see
// src/lib/analytics.ts). `site.json`'s environments.<env>.analytics records the
// same fact for the legal disclosure; this is what enforces it.
//
// The consent banner is gated on the SAME predicate: with opt-in consent and no
// analytics on dev, a banner would be asking permission for nothing.
//
// So is <Tracking />, which since toolchain 4.0 is the other thing that asks for
// a category. Everything that can raise the banner and the banner itself must
// share one gate — a demand with no banner on the page waits forever and never
// writes, silently. Keep that invariant if consent ever gates something else
// (an embed, A/B assignment).
const analyticsEnabled = clarityEnabled(Astro.originPathname);
const variant = Astro.locals.variant ?? "a";
---

<!doctype html>
<html lang="en" data-brx-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		{/*
		  Keep non-production stages out of the index.

		  `src/middleware.ts` also sets `x-robots-tag` for non-prod hosts, but it
		  cannot reach these pages: prerendered HTML is served straight from Workers
		  Assets without invoking the Worker, so middleware never runs. Without this
		  tag dev.vitops.ca is crawlable. The header still covers the routes that
		  really are server-rendered; this covers the static ones.
		*/}
		{!isProdStage && <meta name="robots" content="noindex, nofollow" />}
		<EmDashHead page={pageCtx} />
		<!-- Favicon/PWA links + the vitops web-component runtime. The runtime
		     progressively enhances the @getvitops/emdash editor blocks
		     (wc-carousel, wc-image-compare, ...) wherever Portable Text renders. -->
		<VitopsHead />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-geist-mono" />
		<!-- Microsoft Clarity, configured on the integration (astro.config.mjs)
		     and gated on the `analytics` consent category: until the visitor
		     accepts, the tag ships with type="text/plain" and the page issues no
		     request to Microsoft at all. `enabled` is the production-STAGE gate,
		     baked in at build time — inert in every non-prod build. -->
		<Analytics enabled={analyticsEnabled} />
		{analyticsEnabled && <meta name="clarity-ab-variant" content={variant} />}
		<!-- Ad-click attribution: captures a click ID / UTMs off the landing URL
		     into the first-party `_ac` cookie, which /api/contact reads back. In
		     <head> because the capture must run before the visitor can navigate
		     away. The write waits on `marketing` consent, and only asks on an
		     arrival that actually carried a click ID.

		     Gated on the same production-stage flag as Clarity, and that is
		     load-bearing rather than tidy: the <CookieConsent /> banner below is
		     gated on it too, so off production there would be nothing on the page
		     able to answer the `marketing` demand this raises. The capture would
		     wait forever and never write — silently. Ads point at vitops.ca, so
		     there is nothing to attribute off it anyway. -->
		{analyticsEnabled && <Tracking />}
	</head>
	<body>
		<header class="site-header navbar-sticky centered">
			<div class="navbar spotlight">
				<a class="brand" href="/" aria-label="vitops home">
					<span
						class="brand-mark"
						set:html={vitopsMark}
						aria-hidden="true"></span>
					<span class="brand-word">vitops</span>
				</a>

				<nav aria-label="Primary">
					<ul class="nav-items justify-center">
						{
							navLinks.map((link) =>
								link.children ? (
									<li class="has-menu">
										<button
											type="button"
											class="menu-trigger"
											aria-expanded="false"
											aria-haspopup="true"
										>
											{link.label}
											<span class="menu-caret" aria-hidden="true">
												▾
											</span>
										</button>
										<ul class="submenu">
											{link.children.map((child) => (
												<li>
													<a href={child.href}>{child.label}</a>
												</li>
											))}
										</ul>
									</li>
								) : (
									<li>
										<a href={link.href}>{link.label}</a>
									</li>
								),
							)
						}
					</ul>
				</nav>

				<div class="nav-actions">
					<a class="cta" href="/#contact"
						>Talk to us <span class="arrow"></span></a
					>
					<button
						class="drawer-open"
						type="button"
						popovertarget="site-nav-drawer"
						aria-label="Open navigation menu"
					>
						<svg
							viewBox="0 0 24 24"
							width="22"
							height="22"
							aria-hidden="true"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							><path d="M4 7h16M4 12h16M4 17h16"></path></svg
						>
					</button>
				</div>
			</div>
		</header>

		<!-- Site nav drawer: framework .drawer-menu pattern driven entirely by the
		     Popover API — popovertarget toggles it, light dismiss (Esc / outside
		     click) comes free. Only the link-click auto-close needs script. -->
		<div id="site-nav-drawer" popover class="drawer-menu">
			<button
				class="drawer-close"
				type="button"
				popovertarget="site-nav-drawer"
				popovertargetaction="hide"
				aria-label="Close navigation menu"
			>
				<svg
					viewBox="0 0 24 24"
					width="22"
					height="22"
					aria-hidden="true"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg
				>
			</button>
			<div class="nav-header">
				<a class="brand" href="/" aria-label="vitops home">
					<span
						class="brand-mark"
						set:html={vitopsMark}
						aria-hidden="true"></span>
					<span class="brand-word">vitops</span>
				</a>
			</div>
			<nav class="drawer-nav" aria-label="Menu">
				<ul class="nav-items">
					{
						drawerLinks.map((link) => (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						))
					}
				</ul>
			</nav>
			<div class="nav-actions">
				<a class="cta" href="/#contact"
					>Talk to us <span class="arrow"></span></a
				>
			</div>
		</div>

		<main>
			<slot />
		</main>

		<footer class="site-footer centered">
			<div class="footer-inner spotlight">
				<a class="brand" href="/" aria-label="vitops home">
					<span
						class="brand-mark"
						set:html={vitopsMark}
						aria-hidden="true"></span>
					<span class="brand-word">vitops</span>
				</a>
				<p class="font-caption footer-blurb">
					Vitops runs the digital presence and the day to day IT and HR
					operations for businesses that would rather spend their time on
					the work they are good at.
				</p>

				<nav class="footer-nav" aria-label="Footer">
					<div class="footer-col">
						<h2 class="font-eyebrow footer-head">Services</h2>
						<ul>
							<li><a href="/business-software">Business software</a></li>
							<li><a href="/back-office">Back office</a></li>
							<li><a href="/digital-presence">Digital presence</a></li>
							<li><a href="/industries">Industries</a></li>
							<li><a href="/pricing">Pricing</a></li>
						</ul>
					</div>
					<div class="footer-col">
						<h2 class="font-eyebrow footer-head">Funding</h2>
						<ul>
							<li><a href="/funding">All programs</a></li>
							<li><a href="/funding/dmap">DMAP</a></li>
							<li><a href="/funding/tdp">TDP</a></li>
							<li><a href="/funding/bdc-lift">BDC LIFT</a></li>
						</ul>
					</div>
					<div class="footer-col">
						<h2 class="font-eyebrow footer-head">Company</h2>
						<ul>
							<li><a href="/about">About</a></li>
							<li><a href="/#contact">Contact</a></li>
							<li><a href="mailto:hi@vitops.ca">hi@vitops.ca</a></li>
							<li><a href="/privacy">Privacy policy</a></li>
							<li><a href="/cookies">Cookie notice</a></li>
							<li><a href="/terms">Terms of service</a></li>
						</ul>
					</div>
				</nav>
				<div class="footer-base">
					<span class="footer-copy flex flex-col @md:flex-row @md:items-center">
						<span>© {year} Vitops</span>
						<span class="hidden @md:inline" aria-hidden="true">·</span>
						<span>Run the business; we run the rest.</span>
						{
							analyticsEnabled && (
								<Fragment>
									<span class="hidden @md:inline" aria-hidden="true">
										·
									</span>
									{/* Reopens <wc-consent>; the cookie notice tells
									    readers they can change their choice, so there
									    has to be something that does it. */}
									<button type="button" class="footer-consent" data-consent-open>
										Cookie preferences
									</button>
								</Fragment>
							)
						}
					</span>
				</div>
			</div>
		</footer>

		<style>
			.site-header {
				background: color-mix(in srgb, var(--color-navy-xxd) 82%, transparent);
				backdrop-filter: blur(14px);
				-webkit-backdrop-filter: blur(14px);
				border-bottom: 1px solid var(--line-1);
			}

			.navbar {
				block-size: 64px;
			}

			.brand {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				color: var(--color-pine);
				text-decoration: none;
			}

			.brand-mark {
				display: inline-flex;
				inline-size: 18px;
			}

			/* The mark is injected via set:html, so its <svg> carries no scope
			   attribute — reach it with :global. */
			.brand-mark :global(svg) {
				inline-size: 100%;
				block-size: auto;
				display: block;
			}

			.brand-word {
				font-family: var(--font-display);
				font-weight: 600;
				font-size: var(--text-l);
				letter-spacing: -0.02em;
				color: var(--color-snow);
			}

			/* Centered nav links (the framework's .nav-items is flex:1;
			   justify-center pulls the links to the middle track). */
			.nav-items a {
				font-size: var(--text-s);
				color: var(--color-mist);
				text-decoration: none;
				transition: color 0.2s ease;
			}

			.nav-items a:hover {
				color: var(--color-snow);
			}

			.nav-actions {
				flex: 0 0 auto;
				align-items: center;
			}

			/* Services dropdown. Opens on hover and on click/keyboard (the button
			   carries aria-expanded, so it works without a pointer). */
			.has-menu {
				position: relative;
			}

			.menu-trigger {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				background: none;
				border: none;
				padding: 0;
				cursor: pointer;
				font: inherit;
				font-size: var(--text-s);
				color: var(--color-mist);
				transition: color 0.2s ease;
			}

			.menu-trigger:hover,
			.menu-trigger[aria-expanded="true"] {
				color: var(--color-snow);
			}

			.menu-caret {
				font-size: 0.7em;
				transition: transform 0.2s ease;
			}

			.menu-trigger[aria-expanded="true"] .menu-caret {
				transform: rotate(180deg);
			}

			.submenu {
				position: absolute;
				inset-block-start: calc(100% + 0.75rem);
				inset-inline-start: 50%;
				translate: -50% 0;
				min-inline-size: 13rem;
				margin: 0;
				padding: 0.5rem;
				list-style: none;
				background: var(--color-navy-xxd);
				border: 1px solid var(--line-1);
				border-radius: 0.5rem;
				box-shadow: 0 12px 32px rgb(0 0 0 / 0.35);
				display: grid;
				gap: 0.15rem;
				opacity: 0;
				visibility: hidden;
				transition:
					opacity 0.15s ease,
					visibility 0.15s ease;
			}

			/* A hover bridge — without it the pointer crosses a dead gap and the
			   menu closes on the way down. */
			.submenu::before {
				content: "";
				position: absolute;
				inset-block-end: 100%;
				inset-inline: 0;
				block-size: 0.75rem;
			}

			.has-menu:hover .submenu,
			.has-menu:focus-within .submenu,
			.menu-trigger[aria-expanded="true"] + .submenu {
				opacity: 1;
				visibility: visible;
			}

			.submenu a {
				display: block;
				padding: 0.5rem 0.75rem;
				border-radius: 0.35rem;
				white-space: nowrap;
				transition: background-color 0.15s ease;
			}

			.submenu a:hover {
				background: var(--color-navy-d);
			}

			/* Hamburger: hidden wherever the inline nav is shown. */
			.drawer-open {
				display: none;
				align-items: center;
				justify-content: center;
				background: none;
				border: none;
				cursor: pointer;
				padding: 0.4rem;
				color: var(--color-mist);
				transition: color 0.2s ease;
			}

			.drawer-open:hover {
				color: var(--color-snow);
			}

			/* Skin the framework drawer to the site surface; don't rely on the
			   theme-attr mapping of --surface-bg. */
			.drawer-menu {
				background: var(--color-navy-xxd);
				color: var(--color-mist);
				border: none;
				--nav-border-color: var(--line-1);
			}

			.drawer-menu .nav-items a {
				font-size: var(--text-l);
				color: var(--color-snow);
				text-decoration: none;
			}

			.drawer-close {
				color: var(--color-mist);
			}

			/* Footer */
			.site-footer {
				border-top: 1px solid var(--line-1);
				background: var(--color-navy-xd);
				padding-block: 3.5rem 2.5rem;
			}

			.footer-inner {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				align-items: flex-start;
			}

			.footer-blurb {
				max-width: 46ch;
				margin: 0;
			}

			.footer-nav {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 2rem;
				inline-size: 100%;
				margin-top: 2rem;
			}

			.footer-head {
				margin: 0 0 0.75rem;
				font-size: var(--text-xs);
			}

			.footer-nav ul {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 0.45rem;
			}

			.footer-nav a {
				font-size: var(--text-s);
				color: var(--color-mist);
				text-decoration: none;
				transition: color 0.2s ease;
			}

			.footer-nav a:hover {
				color: var(--color-snow);
			}

			@media (max-width: 720px) {
				.footer-nav {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}

			.footer-base {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1rem;
				flex-wrap: wrap;
				inline-size: 100%;
				margin-top: 1.5rem;
				padding-top: 1.5rem;
				border-top: 1px solid var(--line-1);
				font-family: var(--font-mono);
				font-size: var(--text-xs);
				letter-spacing: 0.04em;
				color: var(--color-slate);
			}

			/* Row on wider screens, stacked (tagline on its own line) on small. */
			.footer-copy {
				gap: 0.1rem 0.4rem;
			}

			/* A button because it acts on this page rather than navigating, but
			   it sits in a run of text and should read as part of it. */
			.footer-consent {
				appearance: none;
				background: none;
				border: 0;
				padding: 0;
				font: inherit;
				letter-spacing: inherit;
				color: inherit;
				text-decoration: underline;
				text-underline-offset: 0.2em;
				cursor: pointer;
				transition: color 0.2s ease;
			}

			.footer-consent:hover {
				color: var(--color-snow);
			}

			/* Collapse the centered nav on small screens; brand + CTA stay and
			   the hamburger takes over (opens the site-nav drawer). Back to 720px
			   now that Funding has left the nav — four short items fit. */
			@media (max-width: 720px) {
				nav[aria-label="Primary"] {
					display: none;
				}

				.drawer-open {
					display: inline-flex;
				}

				/* With the inline nav (the flex:1 spacer) gone, push the
				   actions to the right edge ourselves. */
				.nav-actions {
					margin-inline-start: auto;
				}
			}
		</style>

		<script is:inline>
			// Popover light-dismiss doesn't cover clicks on links INSIDE the
			// drawer — same-page anchor jumps would leave it open over the page.
			(() => {
				const drawer = document.getElementById("site-nav-drawer");
				drawer?.addEventListener("click", (e) => {
					if (e.target instanceof Element && e.target.closest("a"))
						drawer.hidePopover();
				});

				// Services dropdown: CSS handles hover and focus-within; this adds
				// click/touch and Escape, which hover alone never covers.
				const triggers = document.querySelectorAll(".menu-trigger");
				const closeAll = (except) => {
					triggers.forEach((t) => {
						if (t !== except) t.setAttribute("aria-expanded", "false");
					});
				};
				triggers.forEach((trigger) => {
					trigger.addEventListener("click", (e) => {
						e.stopPropagation();
						const open = trigger.getAttribute("aria-expanded") === "true";
						closeAll(trigger);
						trigger.setAttribute("aria-expanded", open ? "false" : "true");
					});
				});
				document.addEventListener("click", () => closeAll());
				document.addEventListener("keydown", (e) => {
					if (e.key === "Escape") closeAll();
				});
			})();
		</script>
		{
			analyticsEnabled && (
				<Fragment>
					<CookieConsent policyUrl="/cookies" />
					<script is:inline>
						(() => {
							// A <script> body is raw text in Astro, not JSX — write plain
							// JS here. Wrapping it in {`...`} emits the braces and the
							// backticks verbatim, which parses as a block containing a
							// discarded string and silently does nothing.
							//
							// Reopening the banner needs no code: @getvitops/core/consent
							// delegates a document click listener to `[data-consent-open]`
							// itself, which is why the footer button carries that attribute
							// and nothing here binds it.

							// Segment recordings/heatmaps by A/B arm. Clarity does not
							// exist until consent is granted and the gated tag has run, so
							// this waits on the consent event rather than firing at parse
							// time. Dormant today (every visitor gets "a"), but a launched
							// test is then already attributed without a second deploy.
							const meta = document.querySelector('meta[name="clarity-ab-variant"]');
							if (!meta) return;
							const tag = () => {
								if (window.vitopsConsent?.granted?.("analytics") && window.clarity) {
									window.clarity("set", "ab_variant", meta.content);
								}
							};
							document.addEventListener("vitops:consent", tag);
							tag();
						})();
					</script>
				</Fragment>
			)
		}
	</body>
</html>
