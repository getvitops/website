---
import { Font } from "astro:assets";
import { getSiteSettings } from "emdash";
import { EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
// TEMP: framework CSS is mid-migration to the Tailwind v4 output
// (src/styles/tailwind.css, needs @tailwindcss/vite wired in astro.config).
// The old generated styles.css was removed; import commented out so the
// dev pipeline builds. Restore styling by finishing the migration.
// import "../styles/styles.css";
import "../styles/pine-theme.css";
// Single source of truth for the brand mark — the same file the favicon
// set is generated from. `?raw` inlines it at build time (no extra request).
import vitopsMark from "../assets/vitops-mark.svg?raw";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { title, description, image } = Astro.props;
const settings = await getSiteSettings();
const siteTitle = settings?.title || "Vitops";
const fullTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const siteDescription =
	settings?.tagline ||
	"Vitops runs the digital presence and the IT and HR operations for businesses that would rather focus on their craft.";

// Canonical must be the PUBLIC URL. During an A/B layer-3 render Astro.url is
// the internal /b-variant/... path; Astro.originPathname is the pre-rewrite
// pathname (and the plain pathname when no rewrite happened). Astro appends a
// trailing slash to originPathname on rewrites (trailingSlash "ignore" +
// directory build format) — normalize so A and B emit identical canonicals.
// Side effect (intended): query strings no longer leak into the canonical.
const canonicalPath =
	Astro.originPathname.length > 1 && Astro.originPathname.endsWith("/")
		? Astro.originPathname.replace(/\/+$/, "")
		: Astro.originPathname;

const pageCtx = createPublicPageContext({
	Astro,
	kind: "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: title ?? siteTitle,
	description: description || siteDescription,
	canonical: new URL(canonicalPath, Astro.url).href,
	image,
	seo: { ogImage: image },
	siteName: siteTitle,
});

const navLinks = [
	{ label: "IT & HR", href: "/#it-hr" },
	{ label: "Digital presence", href: "/#digital-presence" },
	{ label: "Pricing", href: "/pricing" },
	{ label: "Contact", href: "/#contact" },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-brx-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-geist-mono" />
	</head>
	<body>
		<header class="site-header navbar-sticky centered">
			<div class="navbar spotlight">
				<a class="brand" href="/" aria-label="vitops home">
					<span
						class="brand-mark"
						set:html={vitopsMark}
						aria-hidden="true"></span>
					<span class="brand-word">vitops</span>
				</a>

				<nav aria-label="Primary">
					<ul class="nav-items justify-center">
						{
							navLinks.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))
						}
					</ul>
				</nav>

				<div class="nav-actions">
					<a class="cta" href="/#contact"
						>Talk to us <span class="arrow">→</span></a
					>
					<button
						class="drawer-open"
						type="button"
						popovertarget="site-nav-drawer"
						aria-label="Open navigation menu"
					>
						<svg
							viewBox="0 0 24 24"
							width="22"
							height="22"
							aria-hidden="true"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							><path d="M4 7h16M4 12h16M4 17h16"></path></svg
						>
					</button>
				</div>
			</div>
		</header>

		<!-- Site nav drawer: framework .drawer-menu pattern driven entirely by the
		     Popover API — popovertarget toggles it, light dismiss (Esc / outside
		     click) comes free. Only the link-click auto-close needs script. -->
		<div id="site-nav-drawer" popover class="drawer-menu">
			<button
				class="drawer-close"
				type="button"
				popovertarget="site-nav-drawer"
				popovertargetaction="hide"
				aria-label="Close navigation menu"
			>
				<svg
					viewBox="0 0 24 24"
					width="22"
					height="22"
					aria-hidden="true"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg
				>
			</button>
			<div class="nav-header">
				<a class="brand" href="/" aria-label="vitops home">
					<span
						class="brand-mark"
						set:html={vitopsMark}
						aria-hidden="true"></span>
					<span class="brand-word">vitops</span>
				</a>
			</div>
			<nav class="drawer-nav" aria-label="Menu">
				<ul class="nav-items">
					{
						navLinks.map((link) => (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						))
					}
				</ul>
			</nav>
			<div class="nav-actions">
				<a class="cta" href="/#contact"
					>Talk to us <span class="arrow">→</span></a
				>
			</div>
		</div>

		<main>
			<slot />
		</main>

		<footer class="site-footer centered">
			<div class="footer-inner spotlight">
				<a class="brand" href="/" aria-label="vitops home">
					<span
						class="brand-mark"
						set:html={vitopsMark}
						aria-hidden="true"></span>
					<span class="brand-word">vitops</span>
				</a>
				<p class="font-caption footer-blurb">
					Vitops runs the digital presence and the day to day IT and HR
					operations for businesses that would rather spend their time on
					the work they are good at.
				</p>
				<div class="footer-base">
					<span class="footer-copy flex flex-col md-flex-row md-items-center">
						<span>© {year} Vitops</span>
						<span class="hidden md-inline" aria-hidden="true">·</span>
						<span>Run the business; we run the rest.</span>
					</span>
					<span class="status">All systems steady</span>
				</div>
			</div>
		</footer>

		<style>
			.site-header {
				background: color-mix(in srgb, var(--color-navy-xxd) 82%, transparent);
				backdrop-filter: blur(14px);
				-webkit-backdrop-filter: blur(14px);
				border-bottom: 1px solid var(--line-1);
			}

			.navbar {
				block-size: 64px;
			}

			.brand {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				color: var(--color-pine);
				text-decoration: none;
			}

			.brand-mark {
				display: inline-flex;
				inline-size: 18px;
			}

			/* The mark is injected via set:html, so its <svg> carries no scope
			   attribute — reach it with :global. */
			.brand-mark :global(svg) {
				inline-size: 100%;
				block-size: auto;
				display: block;
			}

			.brand-word {
				font-family: var(--font-display);
				font-weight: 600;
				font-size: var(--text-l);
				letter-spacing: -0.02em;
				color: var(--color-snow);
			}

			/* Centered nav links (the framework's .nav-items is flex:1;
			   justify-center pulls the links to the middle track). */
			.nav-items a {
				font-size: var(--text-s);
				color: var(--color-mist);
				text-decoration: none;
				transition: color 0.2s ease;
			}

			.nav-items a:hover {
				color: var(--color-snow);
			}

			.nav-actions {
				flex: 0 0 auto;
			}

			/* Hamburger: hidden wherever the inline nav is shown. */
			.drawer-open {
				display: none;
				background: none;
				border: none;
				cursor: pointer;
				padding: 0.4rem;
				color: var(--color-mist);
				transition: color 0.2s ease;
			}

			.drawer-open:hover {
				color: var(--color-snow);
			}

			/* Skin the framework drawer to the site surface; don't rely on the
			   theme-attr mapping of --surface-bg. */
			.drawer-menu {
				background: var(--color-navy-xxd);
				color: var(--color-mist);
				border: none;
				--nav-border-color: var(--line-1);
			}

			.drawer-menu .nav-items a {
				font-size: var(--text-l);
				color: var(--color-snow);
				text-decoration: none;
			}

			.drawer-close {
				color: var(--color-mist);
			}

			/* Footer */
			.site-footer {
				border-top: 1px solid var(--line-1);
				background: var(--color-navy-xd);
				padding-block: 3.5rem 2.5rem;
			}

			.footer-inner {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				align-items: flex-start;
			}

			.footer-blurb {
				max-width: 46ch;
				margin: 0;
			}

			.footer-base {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1rem;
				flex-wrap: wrap;
				inline-size: 100%;
				margin-top: 1.5rem;
				padding-top: 1.5rem;
				border-top: 1px solid var(--line-1);
				font-family: var(--font-mono);
				font-size: var(--text-xs);
				letter-spacing: 0.04em;
				color: var(--color-slate);
			}

			/* Row on wider screens, stacked (tagline on its own line) on small. */
			.footer-copy {
				gap: 0.1rem 0.4rem;
			}

			.footer-base .status {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				color: var(--color-mist);
			}

			.footer-base .status::before {
				content: "";
				inline-size: 6px;
				block-size: 6px;
				border-radius: 50%;
				background: var(--color-pine);
				box-shadow: 0 0 0 3px rgba(74, 144, 117, 0.16);
				animation: pine-pulse 1.6s ease-in-out infinite;
			}

			@keyframes pine-pulse {
				0%,
				100% {
					opacity: 1;
				}
				50% {
					opacity: 0.4;
				}
			}

			/* Collapse the centered nav on small screens; brand + CTA stay and
			   the hamburger takes over (opens the site-nav drawer). */
			@media (max-width: 720px) {
				nav[aria-label="Primary"] {
					display: none;
				}

				.drawer-open {
					display: inline-flex;
				}
			}
		</style>

		<script is:inline>
			// Popover light-dismiss doesn't cover clicks on links INSIDE the
			// drawer — same-page anchor jumps would leave it open over the page.
			(() => {
				const drawer = document.getElementById("site-nav-drawer");
				drawer?.addEventListener("click", (e) => {
					if (e.target instanceof Element && e.target.closest("a"))
						drawer.hidePopover();
				});
			})();
		</script>
	</body>
</html>
