---
// Variant B hero (challenger). Same structural classes as variant A so it drops
// into the same layout — the experiment is the copy + CTA framing and glow.
// Selected per request via the variant resolver; both variants read the same
// content DB, so this is a pure design/messaging A/B.
---

<section class="hero hero-glow section centered" data-variant="b">
	<div class="hero-inner spotlight">
		<span class="font-eyebrow">One partner for presence + operations</span>
		<h1 class="font-display hero-title">
			Everything that keeps your business running — for less than one hire.
		</h1>
		<p class="font-lead hero-lead">
			Vitops handles the things you'd rather not: websites, ads, media
			campaigns, bookkeeping, payroll, business software management, and
			more. We handle the backend so you can focus on what you do best.
		</p>
		<div class="hero-cta cluster">
			<a class="cta" href="#contact">Get a plain answer <span class="arrow">→</span></a>
			<a class="cta-ghost" href="#services">See both services</a>
		</div>
	</div>
</section>

<style>
	.hero {
		overflow: hidden;
		align-items: start;
	}
	.hero-glow {
		grid-row: 1;
		align-self: start;
		/* Challenger: a warmer, amber-tinted glow to differentiate the feel. */
		background: radial-gradient(
			ellipse 80% 60% at 30% 0%,
			rgba(212, 160, 74, 0.12) 0%,
			transparent 70%
		);
	}
	.hero-inner {
		grid-row: 1;
		position: relative;
		justify-self: start;
		max-width: 48rem;
	}
	.hero-title {
		margin-block: 1.25rem 1.5rem;
		font-size: clamp(2.6rem, 6vw, 4.75rem);
		line-height: 1.02;
	}
	.hero-lead {
		color: var(--color-mist);
		max-width: 58ch;
	}
	.hero-cta {
		margin-top: 2.25rem;
	}
</style>
