---
/**
 * Structural B variant of /pricing (A/B layer 3). Served at /pricing via the
 * src/middleware.ts rewrite when the visitor's variant is "b"; never linked
 * or reachable as /b-variant/pricing (direct hits 404). Self-contained full
 * page — renders its own PineLayout. Not a route, so no `prerender` export.
 *
 * Currently an INERT clone of src/pages/pricing.astro (marker:
 * data-ab-page="b") shipped to verify the layer-3 machinery end-to-end.
 * Until a real experiment replaces this, edits to the A page must be
 * mirrored here.
 */
import PineLayout from "../../layouts/PineLayout.astro";

// --- IT & HR Operations: priced per employee, per month ---------------------
const opsTiers = [
	{
		name: "Basics",
		price: "$35",
		unit: "/ user / mo",
		features: [
			"Software selection, implementation, and integration guidance",
			"Ongoing license maintenance",
		],
		highlighted: false,
	},
	{
		name: "Foundations",
		price: "$69",
		unit: "/ user / mo",
		features: [
			"Everything in Basics, plus:",
			"Joiner / mover / leaver basics — onboarding & offboarding handled",
			"Baseline endpoint security on every device",
			"Email & ticket support, business hours",
		],
		highlighted: false,
	},
	{
		name: "Managed",
		price: "$119",
		unit: "/ user / mo",
		tag: "Fully managed",
		features: [
			"Everything in Foundations, plus:",
			"Full identity & lifecycle management (SCIM / JML automation)",
			"License tuning & right-sizing across your stack",
			"Continuous endpoint security monitoring",
			"Day-to-day software support & vendor escalation",
			"Quarterly operations review — one dashboard, one bill",
		],
		highlighted: true,
	},
];

// --- Digital Presence: priced per service -----------------------------------
const presenceServices = [
	{
		name: "Website build",
		price: "from $500",
		period: "one-time",
		featured: true,
		included: [
			"Up to 10 pages included — privacy policy and terms & conditions don't count against that total; additional pages are $50 each",
			"Managed site (WordPress or Astro), mobile-first, accessible",
			"Tuned for search and AI-answer visibility from launch",
			"Content generated with AI and quality stock assets — the fastest path to a polished web presence",
			"First 6 months of Website care & hosting, on us",
		],
	},
	{
		name: "Website care & hosting",
		price: "$40",
		period: "/ mo",
		included: [
			"Managed hosting, backups, security patching, and minor content edits",
		],
	},
	{
		name: "SEO & GEO optimization",
		price: "$650",
		period: "/ mo",
		included: [
			"Ongoing search + AI-answer-engine optimization with monthly reporting",
		],
	},
	{
		name: "Ad campaign management",
		price: "$500",
		period: "/ mo + spend",
		included: [
			"Curated Google / social campaigns, steered monthly for conversions",
			"Management fee only — ad spend billed separately, no markup",
		],
	},
	{
		name: "Social media management",
		price: "$650",
		period: "/ mo",
		included: [
			"Content calendar and posting across up to 3 platforms, kept on brand",
		],
	},
	{
		name: "Business listings",
		price: "$75",
		period: "/ mo",
		included: [
			"Google Business Profile, Bing Places, Apple Business Connect — claimed, verified, kept in sync",
		],
	},
];

const finePrint = [
	"No long-term contracts — month-to-month, always",
	"No hidden fees — ad spend and one-time project costs are always itemized separately",
	"Every plan starts with a conversation, not a form into a void",
];
---

<PineLayout
	title="Pricing"
	description="Two services, priced simply. IT & HR operations priced per employee, digital presence priced per service. Month-to-month, no setup fees, no long-term contracts.">
	<!-- PAGE INTRO -->
	<section class="pricing-hero section centered" data-ab-page="b">
		<div class="spotlight">
			<header class="section-intro">
				<span class="font-eyebrow">Pricing at a glance</span>
				<h1 class="font-display pricing-title">Two services, priced simply.</h1>
				<p class="font-lead section-lead">
					Month-to-month, no setup fees, no long-term contracts — cancel with
					30 days' notice. These prices are a starting point for planning; your
					actual quote depends on team size and scope.
				</p>
			</header>
		</div>
	</section>

	<!-- IT & HR OPERATIONS -->
	<section class="section centered" id="it-hr-pricing">
		<div class="spotlight">
			<header class="section-intro">
				<span class="font-eyebrow">IT &amp; HR Operations</span>
				<h2 class="font-title">Priced per employee, right-sized as your team grows.</h2>
			</header>

			<div class="tiers subgrid">
				{
					opsTiers.map((tier) => (
						<article
							class:list={[
								"card",
								"tier",
								tier.highlighted ? "tier--featured" : "bg-navy-d",
							]}>
							<div class="tier-head">
								<div class="tier-name-row">
									<h3 class="font-heading tier-name">{tier.name}</h3>
									{tier.tag && <span class="tier-tag">{tier.tag}</span>}
								</div>
								<p class="tier-price">
									<span class="tier-price__amount">{tier.price}</span>
									<span class="tier-price__unit">{tier.unit}</span>
								</p>
							</div>
							<ul class="feature-list">
								{tier.features.map((f) => (
									<li>{f}</li>
								))}
							</ul>
							<a
								class:list={["tier-cta", tier.highlighted ? "cta" : "cta-ghost"]}
								href="/#contact">
								Get started <span class="arrow">→</span>
							</a>
						</article>
					))
				}
			</div>

			<p class="section-note breakout">
				Running something these plans don't cover? Ask us about our other
				managed services.
			</p>
		</div>
	</section>

	<!-- DIGITAL PRESENCE -->
	<section class="section centered" id="digital-presence-pricing">
		<div class="spotlight">
			<header class="section-intro">
				<span class="font-eyebrow">Digital Presence</span>
				<h2 class="font-title">Build what you need, add more as you grow.</h2>
				<p class="font-lead section-lead">
					Priced per service — start with a site, layer on the pieces that earn
					their keep.
				</p>
			</header>

			<div class="svc-table card bg-navy-d">
				{
					presenceServices.map((svc) => (
						<div class:list={["svc-row", svc.featured && "svc-row--featured"]}>
							<div class="svc-head">
								<h3 class="font-heading svc-name">{svc.name}</h3>
								<p class="svc-price">
									<span class="svc-price__amount">{svc.price}</span>
									<span class="svc-price__period">{svc.period}</span>
								</p>
							</div>
							<ul class="svc-included">
								{svc.included.map((line) => (
									<li>{line}</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- CALLOUTS: BUNDLE + ONE-OFF -->
	<section class="section centered" id="pricing-callouts">
		<div class="spotlight">
			<div class="callout-grid">
				<article class="card callout callout--bundle">
					<span class="font-eyebrow callout-eyebrow">Vitops Complete</span>
					<h3 class="font-heading callout-title">Bundle &amp; save.</h3>
					<p class="font-body callout-copy">
						Combine any IT &amp; HR plan with two or more Digital Presence
						services and save <strong>10%</strong> on the combined monthly
						total. One team, one bill, one number to call.
					</p>
				</article>

				<article class="card bg-navy-d callout">
					<span class="font-eyebrow callout-eyebrow callout-eyebrow--muted">
						Something more one-off?
					</span>
					<h3 class="font-heading callout-title">Scoped and billed hourly.</h3>
					<p class="font-body callout-copy">
						Not everything fits a monthly plan. Consulting, implementation,
						migrations, security reviews, systems rollouts, and custom
						integrations are scoped and billed hourly. Ask for our rate — we'll
						size the work plainly before anything begins.
					</p>
				</article>
			</div>
		</div>
	</section>

	<!-- FINE PRINT + CTA -->
	<section class="section centered pricing-close">
		<div class="spotlight fineprint-grid">
			<div class="fineprint">
				<span class="font-eyebrow">The fine print, in plain language</span>
				<ul class="feature-list fineprint-list">
					{finePrint.map((f) => <li>{f}</li>)}
				</ul>
			</div>

			<div class="close-cta">
				<h2 class="font-title close-title">Every business is different.</h2>
				<p class="font-body close-copy">
					Tell us your team size and what you'd like off your plate, and we'll
					put real numbers to it.
				</p>
				<div class="close-actions">
					<a class="cta" href="/#contact">Talk to us <span class="arrow">→</span></a>
					<a class="cta-ghost" href="mailto:hi@vitops.ca">hi@vitops.ca</a>
				</div>
			</div>
		</div>
	</section>
</PineLayout>

<style>
	/* Section intros — mirror the home page rhythm. */
	.section-intro {
		max-width: 60ch;
		margin-bottom: 3rem;
	}
	.section-intro .font-title {
		margin-top: 0.75rem;
		font-size: clamp(2rem, 4vw, 3rem);
	}
	.section-lead {
		margin-top: 1rem;
		color: var(--color-mist);
	}

	/* Page hero */
	.pricing-hero {
		padding-block: clamp(4.5rem, 10vw, 8rem) clamp(2rem, 4vw, 3rem);
	}
	.pricing-title {
		margin-top: 0.85rem;
		font-size: clamp(2.4rem, 6vw, 4rem);
		letter-spacing: -0.02em;
		line-height: 1.05;
	}

	.section-note {
		margin-top: 2.5rem;
		text-align: center;
		font-size: var(--text-s);
		color: var(--color-slate);
		font-style: italic;
	}

	/* ---- IT & HR tiers ----
	   Drive the framework's `.subgrid` via its public custom properties.
	   Each card is a direct child spanning 3 row tracks (grid-template-rows:
	   subgrid), so its three tranches — head, feature list, CTA — snap to the
	   same shared row lines across all cards regardless of feature count. */
	.tiers {
		--items-per-row: 3;
		--rows-per-item: 3;
		--subgrid-gap: 1.5rem; /* gap between cards (columns) */
		row-gap: 1.25rem; /* gap between tranches (rows) */
	}
	.tier {
		padding: 2rem;
	}
	.tier--featured {
		background: var(--color-navy-d);
		border: 1px solid var(--color-pine);
		box-shadow: 0 0 0 1px rgba(74, 144, 117, 0.25),
			0 24px 60px -30px rgba(74, 144, 117, 0.5);
	}
	.tier-head {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--line-1);
	}
	.tier-name-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}
	.tier-name {
		margin: 0;
		font-size: var(--text-l);
	}
	.tier-tag {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #0a0d0c;
		background: var(--color-pine);
		padding: 0.25rem 0.6rem;
		border-radius: var(--br-pill, 999px);
		white-space: nowrap;
	}
	.tier-price {
		margin: 0;
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
	}
	.tier-price__amount {
		font-family: var(--font-display);
		font-size: var(--text-3xl);
		font-weight: 700;
		color: var(--color-snow);
		letter-spacing: -0.02em;
	}
	.tier-price__unit {
		font-size: var(--text-s);
		color: var(--color-slate);
	}
	.tier-cta {
		justify-content: center;
		width: 100%;
		align-self: end; /* pin CTA to the bottom of its (shared) row track */
	}

	/* Shared feature list (matches index.astro) */
	.feature-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.7rem;
	}
	.feature-list li {
		display: flex;
		align-items: baseline;
		gap: 0.65rem;
		font-size: var(--text-s);
		color: var(--color-mist);
	}
	.feature-list li::before {
		content: "✓";
		color: var(--color-pine);
		font-weight: 600;
		font-size: 0.85em;
	}

	/* ---- Digital Presence table ---- */
	.svc-table {
		padding: 0;
		overflow: hidden;
	}
	.svc-row {
		display: grid;
		grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
		gap: clamp(1rem, 4vw, 3rem);
		padding: 1.75rem 2rem;
		border-top: 1px solid var(--line-1);
	}
	.svc-row:first-child {
		border-top: 0;
	}
	.svc-row--featured {
		background: color-mix(in srgb, var(--color-pine) 7%, transparent);
	}
	.svc-head {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.svc-name {
		margin: 0;
		font-size: var(--text-m);
	}
	.svc-price {
		margin: 0;
		display: flex;
		align-items: baseline;
		gap: 0.35rem;
		flex-wrap: wrap;
	}
	.svc-price__amount {
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 700;
		color: var(--color-pine-l);
		letter-spacing: -0.01em;
	}
	.svc-price__period {
		font-size: var(--text-xs);
		color: var(--color-slate);
	}
	.svc-included {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.55rem;
		align-content: start;
	}
	.svc-included li {
		display: flex;
		align-items: baseline;
		gap: 0.65rem;
		font-size: var(--text-s);
		color: var(--color-mist);
	}
	.svc-included li::before {
		content: "—";
		color: var(--color-pine);
		flex: 0 0 auto;
	}

	/* ---- Callouts ---- */
	.callout-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
	}
	.callout {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 2rem;
	}
	.callout--bundle {
		background: color-mix(in srgb, var(--color-pine) 10%, var(--color-navy-d));
		border: 1px solid var(--color-pine);
	}
	.callout-eyebrow {
		color: var(--color-pine-l);
	}
	.callout-eyebrow--muted {
		color: var(--color-slate);
	}
	.callout-title {
		margin: 0.35rem 0 0;
		font-size: var(--text-l);
	}
	.callout-copy {
		margin: 0.4rem 0 0;
		color: var(--color-mist);
	}
	.callout-copy strong {
		color: var(--color-snow);
	}

	/* ---- Fine print + close CTA ---- */
	.fineprint-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}
	.fineprint-list {
		margin-top: 1.25rem;
	}
	.close-title {
		font-size: clamp(1.6rem, 3vw, 2.25rem);
	}
	.close-copy {
		margin: 1rem 0 1.75rem;
		color: var(--color-mist);
		max-width: 44ch;
	}
	.close-actions {
		display: flex;
		gap: 0.85rem;
		flex-wrap: wrap;
	}

	@media (max-width: 860px) {
		.tiers {
			--items-per-row: 1;
		}
		.callout-grid,
		.fineprint-grid {
			grid-template-columns: 1fr;
		}
		.svc-row {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}
</style>
