---
// STAT BAND — sourced figures that price the problem the surrounding page
// is describing, in hours or dollars rather than adjectives. Every stat
// carries its own source line: the numbers here come from surveys run by
// vendors adjacent to the problem they measure (Salesforce, ADP, Intuit…),
// so naming the source per-figure — not a single "Sources:" line for the
// whole band — is how a skeptical reader can weigh each one on its own.
// See content-plan/time-savings-statistics.md for the full brief
// and the figures deliberately excluded (unsourced/unverifiable).
import Subgrid from "@getvitops/astro/components/Subgrid.astro";
import Counter from "@getvitops/astro/components/Counter.astro";

interface Stat {
	value: string;
	label: string;
	sourceLabel: string;
	sourceUrl: string;
}

interface Props {
	stats: Stat[];
	eyebrow?: string;
	lead?: string;
	class?: string;
	cols?: 2 | 3 | 4;
	/** Breakpoint the grid collapses to a single column at. Default "sm" (48rem). */
	stackAt?: "sm" | "md";
}

const {
	stats,
	eyebrow,
	lead,
	class: _class,
	cols = stats.length >= 4 ? 4 : 3,
	stackAt = "sm",
} = Astro.props;

// <wc-counter> parses ONE numeric run back out of its own rendered text
// (prefix, number, suffix — see @getvitops/core's `hn`). A value with a
// second number in its suffix ("32% vs. 73%") fails that parse and would
// count up to 0 before snapping to the real text. Only animate values the
// parser can actually read.
const COUNTABLE = /^[^0-9-]*-?[0-9,]*\.?[0-9]*[^0-9]*$/;
const canAnimate = (value: string) => COUNTABLE.test(value) && /[0-9]/.test(value);
---

<section class:list={["stats section centered anim-slow", _class]} data-stack-at={stackAt}>
	<div class="spotlight">
		<header class="rhythm max-w-[60ch] mb-12">
			{eyebrow && <span class="font-eyebrow">{eyebrow}</span>}
			<p class="font-eyebrow"><slot name="heading">Key stats</slot></p>
			{lead && <p class="font-lead text-neutral-muted">{lead}</p>}
		</header>
		<Subgrid
			class="stats-grid stagger [--subgrid-cols:1] @md:[--subgrid-cols:2] @3xl:[--subgrid-cols:4]"
		>
			{
				stats.map((s) => (
					<li class="card subgrid-card stat-card fade-in slide-up animate-view">
						<p class="stat-value">
							<Counter value={s.value} enhance={canAnimate(s.value)} />
						</p>
						<p class="font-body stat-label">{s.label}</p>
						<p class="source-line">
							<a class="link" href={s.sourceUrl} rel="noopener" target="_blank">
								{s.sourceLabel}
							</a>
						</p>
					</li>
				))
			}
		</Subgrid>
	</div>
</section>

<style>
	/* Slower, earlier-starting entrance for every .animate-view descendant —
	   see the identical rule + rationale in Pain.astro. */
	.anim-slow {
		--anim-start: -8vh;
		--anim-end: 40vh;
	}

	.stats-grid {
		--subgrid-row-span: 3;
		--subgrid-card-rows: 3; /* must match --subgrid-row-span; .subgrid-card's
		                           own grid-row wins the cascade over .subgrid's */
		--subgrid-gap: 1.5rem;
	}
	.stat-card {
		gap: 0.6rem;
		padding: 1.75rem;
	}
	.stat-value {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-3xl);
		font-weight: 700;
		color: var(--color-snow);
		letter-spacing: -0.02em;
		line-height: 1.05;
	}
	.stat-label {
		color: var(--color-mist);
	}
	.source-line {
		margin-top: auto;
		padding-top: 0.5rem;
		font-size: var(--text-s);
		color: var(--color-slate);
	}

	@media (max-width: 64rem) {
		.stats-grid[data-stack-at="md"] {
			--subgrid-cols: 1;
		}
	}

	@media (max-width: 48rem) {
		.stats-grid {
			--subgrid-cols: 1;
		}
	}
</style>
