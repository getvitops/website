---
// Renders an EmDash page-shaped entry. Shared by every route backed by such a
// collection — `pages` at `/<slug>` and `managed_it_services` at
// `/managed-it-services/<slug>` — so they cannot drift apart.
//
// Current shape: a `layout` blocks field (PageBlocks.astro — hero, callout,
// text, cards, … in editor-chosen order), plus `crumbs` (breadcrumb repeater),
// `schema_type` (none | organization | service) with `service_name` and
// `service_description`.
//
// LEGACY shape, rendered only when `layout` is empty — removed once every
// environment has been migrated (docs/EMDASH-TOOLCHAIN-MIGRATION-PLAN.md):
//   hero        { eyebrow, title, lead, ctaLabel?, ctaHref?, secondaryLabel?, secondaryHref?, note? }
//   cta         { title, lead?, ctaLabel?, ctaHref?, note?, links?[{ label, href }] }
//   callout     string — the slim funding band above the hero (plain text)
//   breadcrumb  [[label, href], ...]   (default: the hero eyebrow → this page)
//   schema      { graph: "organization" } | { service: { name, description } }
// `note` fields take `[label](/href)` inline links (lib/inline.ts).
import PineLayout from "../../layouts/PineLayout.astro";
import FundingCallout from "./FundingCallout.astro";
import PageHero from "./PageHero.astro";
import PageBlocks from "./PageBlocks.astro";
import PageSections from "./PageSections.astro";
import PageCta from "./PageCta.astro";
import Schema from "./Schema.astro";
import { inline } from "../../lib/inline";
import { breadcrumb, organizationGraph, service } from "../../lib/schema";

interface Props {
	/** `entry.data` of the page-shaped entry. */
	data: Record<string, any>;
	/** Public path, e.g. `/about`. */
	path: string;
}
const { data, path } = Astro.props;

const { title, hero, sections, cta, callout } = data;
const description = data.seo?.description ?? undefined;
const blocks = data.layout?.length ? data.layout : null;

// Structured data and breadcrumb: new fields first, legacy json as fallback.
const schema =
	data.schema_type === "organization"
		? { graph: "organization" }
		: data.schema_type === "service"
			? { service: { name: data.service_name ?? title, description: data.service_description ?? "" } }
			: data.schema_type === "none"
				? undefined
				: data.schema;
const heroEyebrow = blocks?.find((b: { _type: string }) => b._type === "hero")?.eyebrow ?? hero?.eyebrow;
const trail: [string, string][] | undefined = data.crumbs?.length
	? data.crumbs.map((c: { label: string; href: string }) => [c.label, c.href])
	: data.breadcrumb?.length
		? data.breadcrumb
		: undefined;
const crumbs = trail ?? [[heroEyebrow ?? title, path] as [string, string]];
---
<PineLayout title={title} description={description}>
	{schema?.graph === "organization" && <Schema data={organizationGraph} />}
	{schema?.service && <Schema data={service(schema.service.name, schema.service.description, path)} />}
	<Schema data={breadcrumb(...crumbs)} />

	{blocks && <PageBlocks value={blocks} />}

	{!blocks && callout && <FundingCallout text={callout} />}

	{
		!blocks && hero && (
			<PageHero
				eyebrow={hero.eyebrow}
				title={hero.title}
				lead={hero.lead}
				ctaLabel={hero.ctaLabel}
				ctaHref={hero.ctaHref}
				secondaryLabel={hero.secondaryLabel}
				secondaryHref={hero.secondaryHref}
				note={hero.note && inline(hero.note)}
			/>
		)
	}

	{!blocks && <PageSections sections={sections ?? []} />}

	{
		!blocks && cta && (
			<PageCta
				title={cta.title}
				lead={cta.lead}
				ctaLabel={cta.ctaLabel}
				ctaHref={cta.ctaHref}
				note={cta.note && inline(cta.note)}
				links={cta.links}
			/>
		)
	}
</PineLayout>
