---
import FaqSchema from "@getvitops/astro/schemas/FAQ.astro";

// FAQ block + FAQPage JSON-LD. Answers are written to stand alone so an answer
// engine can lift one without the surrounding page. See content-plan/geo.md.
//
// Call sites use { q, a }; the schema component wants { question, answer }.
// Mapping here keeps the shorthand at the ~60 authoring sites.
export interface FaqItem {
	q: string;
	a: string;
}
interface Props {
	items: FaqItem[];
	title?: string;
	eyebrow?: string;
}
const { items, title = "Questions we get about this.", eyebrow } = Astro.props;
---

<FaqSchema items={items.map((i) => ({ question: i.q, answer: i.a }))} />

<section class="faq section centered">
	<div class="spotlight">
		<header class="faq-intro">
			{eyebrow && <span class="font-eyebrow">{eyebrow}</span>}
			<h2 class="font-title faq-title">{title}</h2>
		</header>
		<div class="faq-list">
			{
				items.map((item) => (
					<details class="faq-item">
						<summary class="font-heading faq-q">{item.q}</summary>
						<p class="font-body faq-a">{item.a}</p>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.faq-intro {
		max-width: 60ch;
		margin-bottom: 2.5rem;
	}
	.faq-title {
		margin-top: 0.75rem;
		font-size: clamp(1.8rem, 3.6vw, 2.6rem);
	}
	.faq-list {
		border-top: 1px solid var(--line-1);
	}
	.faq-item {
		border-bottom: 1px solid var(--line-1);
	}
	.faq-q {
		cursor: pointer;
		padding-block: 1.25rem;
		font-size: var(--text-m);
		list-style: none;
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
	}
	.faq-q::-webkit-details-marker {
		display: none;
	}
	.faq-q::after {
		content: "+";
		color: var(--color-pine);
		font-weight: 600;
		flex: 0 0 auto;
	}
	.faq-item[open] .faq-q::after {
		content: "−";
	}
	.faq-a {
		color: var(--color-mist);
		max-width: 72ch;
		margin: 0;
		padding-block-end: 1.5rem;
	}
</style>
