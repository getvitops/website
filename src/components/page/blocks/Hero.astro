---
import type { PageLayoutHeroBlock } from "../../../../emdash-env";
import type { BlockComponentProps } from "emdash/ui";
import { inline } from "../../../lib/inline";
import PageHero from "../PageHero.astro";

type Props = BlockComponentProps<PageLayoutHeroBlock>;
const { value: v } = Astro.props;
---

<PageHero
	eyebrow={v.eyebrow ?? undefined}
	title={v.title}
	lead={v.lead ?? ""}
	ctaLabel={v.cta_label || undefined}
	ctaHref={v.cta_href || undefined}
	secondaryLabel={v.secondary_label || undefined}
	secondaryHref={v.secondary_href || undefined}
	note={v.note ? inline(v.note) : undefined}
/>
