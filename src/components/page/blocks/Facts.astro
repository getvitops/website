---
import type { PageLayoutFactsBlock } from "../../../../emdash-env";
import type { BlockComponentProps } from "emdash/ui";
import { inline } from "../../../lib/inline";

type Props = BlockComponentProps<PageLayoutFactsBlock>;
const { value: v } = Astro.props;
---

<section class="section centered">
	<div class="spotlight">
		<dl class="nap">
			{
				(v.items ?? []).map((i) => (
					<div class="nap-row">
						<dt class="font-caption">{i.term}</dt>
						<dd class="font-body" set:html={inline(i.value)} />
					</div>
				))
			}
		</dl>
	</div>
</section>

<style>
	.nap {
		display: grid;
		gap: 1.5rem;
		max-width: 42ch;
	}
	.nap-row dt {
		color: var(--color-slate);
		margin-bottom: 0.25rem;
	}
	.nap-row dd {
		margin: 0;
		color: var(--color-snow);
	}
</style>
