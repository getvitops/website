---
import type { PageLayoutCardsBlock } from "../../../../emdash-env";
import type { BlockComponentProps } from "emdash/ui";
import { inline, lines } from "../../../lib/inline";
import CardGrid from "../Cards.astro";
import SectionIntro from "../SectionIntro.astro";

type Props = BlockComponentProps<PageLayoutCardsBlock>;
const { value: v } = Astro.props;
const cards = (v.cards ?? []).map((c) => ({
	tag: c.tag || undefined,
	heading: c.heading,
	body: c.body ?? "",
	items: lines(c.items).length ? lines(c.items) : undefined,
}));
---

<section class="section centered">
	<div class="spotlight">
		<SectionIntro eyebrow={v.eyebrow ?? undefined} title={v.title ?? ""} lead={v.lead ?? undefined} />
		<CardGrid cards={cards} cols={v.cols === "3" ? 3 : 2} />
		{
			v.links?.length ? (
				<nav class="section-links" aria-label={v.title ?? undefined}>
					{v.links.map((l) => (
						<a class="link" href={l.href}>
							{l.label}
						</a>
					))}
				</nav>
			) : null
		}
		{v.note && <p class="font-caption follow-link" set:html={inline(v.note)} />}
	</div>
</section>

<style>
	.section-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		margin-top: 2rem;
		font-size: var(--text-s);
	}
	.follow-link {
		margin-top: 2rem;
		color: var(--color-slate);
	}
</style>
