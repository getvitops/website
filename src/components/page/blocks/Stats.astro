---
import type { PageLayoutStatsBlock } from "../../../../emdash-env";
import type { BlockComponentProps } from "emdash/ui";
import StatsGrid from "../Stats.astro";

type Props = BlockComponentProps<PageLayoutStatsBlock>;
const { value: v } = Astro.props;
const stats = (v.stats ?? []).map((s) => ({
	value: s.value,
	label: s.label,
	sourceLabel: s.source_label ?? "",
	sourceUrl: s.source_url ?? "",
}));
---

<StatsGrid
	stats={stats}
	cols={v.cols ? (Number(v.cols) as 2 | 3 | 4) : undefined}
	eyebrow={v.eyebrow ?? undefined}
	lead={v.lead ?? undefined}
/>
