---
import type { PageLayoutLeadBlock } from "../../../../emdash-env";
import type { BlockComponentProps } from "emdash/ui";
import { inline, paragraphs } from "../../../lib/inline";
import Prose from "../Prose.astro";

type Props = BlockComponentProps<PageLayoutLeadBlock>;
const { value: v } = Astro.props;
---

<Prose lead>
	{paragraphs(v.body).map((p) => <p set:html={inline(p)} />)}
</Prose>
