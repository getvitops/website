---
import type { PageLayoutCtaBlock } from "../../../../emdash-env";
import type { BlockComponentProps } from "emdash/ui";
import { inline } from "../../../lib/inline";
import PageCta from "../PageCta.astro";

type Props = BlockComponentProps<PageLayoutCtaBlock>;
const { value: v } = Astro.props;
---

<PageCta
	title={v.title}
	lead={v.lead ?? undefined}
	ctaLabel={v.cta_label || undefined}
	ctaHref={v.cta_href || undefined}
	note={v.note ? inline(v.note) : undefined}
	links={v.links ?? []}
/>
