---
// A plain measured text block — the "direct answer" opener and the longer
// argument sections. Kept narrow; answer engines lift whole paragraphs.
interface Props {
	/** Renders as the section's quotable opening paragraph. */
	lead?: boolean;
}
const { lead = false } = Astro.props;
---

<section class="prose-block section centered">
	<div class:list={["spotlight", "prose", lead && "prose-lead"]}>
		<slot />
	</div>
</section>

<style>
	.prose-block {
		padding-block: 2.5rem;
	}
	.prose {
		max-width: 72ch;
		color: var(--color-mist);
	}
	.prose :global(p) {
		margin-block: 0 1.1em;
	}
	.prose :global(p:last-child) {
		margin-block-end: 0;
	}
	.prose-lead :global(p) {
		font-size: var(--text-l);
		color: var(--color-snow);
	}
	.prose :global(strong) {
		color: var(--color-snow);
	}
	.prose :global(.pull-quote) {
		margin-block: 2rem;
		padding-inline-start: 1.5rem;
		border-inline-start: 2px solid var(--color-pine);
		font-family: var(--font-display);
		font-size: var(--text-l);
		color: var(--color-snow);
	}
</style>
