---
// The managed IT/HR stack, told as five scroll-triggered steps: choose
// products, right-size plans, connect + AI, run the day to day, one dashboard.
// Each step animates when it scrolls into view and can be replayed. Ported
// and restyled from saas-stack-animation.html onto the Pine framework tokens.
import { Icon } from "astro-iconset/components";

// Brand logos the client script stamps into the animation. Pre-rendered once
// into a hidden pool below (build-time SVG via astro-iconset), then cloned by
// the script — so there's no runtime Iconify web component / CDN request.
const SIMPLE_ICONS = [
	"adp",
	"anthropic",
	"asana",
	"astro",
	"google",
	"hubspot",
	"microsoft",
	"openai",
	"quickbooks",
	"zendesk",
];
---

<div class="stack-anim">
	<section class="anim-step" data-step="0">
		<div class="anim-step__intro">
			<span class="anim-step__num">Step 01</span>
			<h3 class="font-heading">Choose the right tools</h3>
			<p class="anim-blurb">
				You could spend weeks comparing apps. We already know what fits a team
				like yours and pick the ones you'll actually use, not one of everything.
			</p>
			<button class="anim-replay" type="button" data-replay="0">
				<span class="anim-replay__i">↻</span> Replay
			</button>
		</div>
		<div class="anim-step__viz">
			<div class="grid" id="g0"></div>
		</div>
	</section>

	<section class="anim-step" data-step="1">
		<div class="anim-step__intro">
			<span class="anim-step__num">Step 02</span>
			<h3 class="font-heading">Right-size every plan</h3>
			<p class="anim-blurb">
				Most of your team needs the basics; a few need more. We size each plan
				to real usage so you stop paying for seats no one signs into.
			</p>
			<button class="anim-replay" type="button" data-replay="1">
				<span class="anim-replay__i">↻</span> Replay
			</button>
		</div>
		<div class="anim-step__viz">
			<div class="grid" id="g1"></div>
		</div>
	</section>

	<section class="anim-step" data-step="2">
		<div class="anim-step__intro">
			<span class="anim-step__num">Step 03</span>
			<h3 class="font-heading">Implement &amp; Integrate</h3>
			<p class="anim-blurb">
				Disconnected apps are where work falls through. We wire them together,
				and add AI where it helps.
			</p>
			<button class="anim-replay" type="button" data-replay="2">
				<span class="anim-replay__i">↻</span> Replay
			</button>
		</div>
		<div class="anim-step__viz">
			<svg viewBox="0 0 700 360" style="width:100%"><g id="net"></g></svg>
		</div>
	</section>

	<section class="anim-step" data-step="3">
		<div class="anim-step__intro">
			<span class="anim-step__num">Step 04</span>
			<h3 class="font-heading">Run the day to day</h3>
			<p class="anim-blurb">
				Joiners, movers, leavers, and the tickets in between. We handle
				onboarding, offboarding, updates, and vendor escalation so none of it
				lands on you.
			</p>
			<button class="anim-replay" type="button" data-replay="3">
				<span class="anim-replay__i">↻</span> Replay
			</button>
		</div>
		<div class="anim-step__viz">
			<div class="band band-accent">
				<div class="s3-grid">
					<div class="s3-col" id="tix"></div>
					<div class="s3-col" id="seats"></div>
				</div>
			</div>
			<div class="gap" id="gap2">&darr; &nbsp;we handle updates, support, and escalation</div>
			<div class="band band-surface"><div class="bt">Apps</div><div class="vend" id="vend"></div></div>
		</div>
	</section>

	<section class="anim-step" data-step="4">
		<div class="anim-step__intro">
			<span class="anim-step__num">Step 05</span>
			<h3 class="font-heading">One view, one bill</h3>
			<p class="anim-blurb">
				One dashboard, one bill, one number to call. The whole stack managed for
				less than the cost of a single hire.
			</p>
			<button class="anim-replay" type="button" data-replay="4">
				<span class="anim-replay__i">↻</span> Replay
			</button>
		</div>
		<div class="anim-step__viz">
			<div class="metrics">
				<div class="metric"><div class="ml">Products</div><div class="mv" id="dp">6</div></div>
				<div class="metric"><div class="ml">Licenses</div><div class="mv" id="dl">0</div></div>
				<div class="metric"><div class="ml">Monthly</div><div class="mv" id="dc">$0</div></div>
			</div>
			<div class="s4-list" id="g4"></div>
		</div>
	</section>
</div>

<div id="stack-icon-pool" hidden>
	{
		SIMPLE_ICONS.map((slug) => (
			<span data-icon={`simple-icons:${slug}`}>
				<Icon name={`simple-icons:${slug}`} />
			</span>
		))
	}
</div>

<style is:global>
	/* Palette remap: the widget's private tokens point at Pine framework
	   tokens. Everything is scoped under .stack-anim so the widget's
	   generic class names (.card, .grid, .link) never fight the framework. */
	.stack-anim {
		--s0: var(--color-navy-xxd);
		--s1: var(--color-navy-d);
		--s2: var(--color-navy);
		--tp: var(--color-snow);
		--ts: var(--color-mist);
		--tm: var(--color-slate);
		--bd: var(--line-1);
		--bds: var(--line-2);
		--ac: var(--color-pine);
		--acbg: rgba(74, 144, 117, 0.14);
		--acbd: var(--color-pine);
		--pu: var(--color-cobalt);
		--pubg: rgba(111, 155, 255, 0.16);
		--okbg: rgba(74, 144, 117, 0.16);
		--ok: var(--color-pine-l);
		--wnbg: rgba(245, 185, 74, 0.14);
		--wn: var(--color-amber);
		--r: var(--br-control, 6px);

		color: var(--tp);
		line-height: 1.6;
		font-family: var(--font-sans);
	}

	.stack-anim .card {
		position: relative;
		background: var(--s2);
		border: 2px solid var(--bd);
		border-radius: 12px;
		box-shadow: none;
		padding: 14px;
		display: flex;
		flex-direction: column;
		gap: 8px;
		transition: all 0.4s ease;
		/* Resting state: all tiles fully visible, none selected. The stage-0
		   run() applies .pick once the step scrolls into view; unpicked tiles
		   keep the resting state. */
		opacity: 1;
	}
	.stack-anim .card.pick { border-color: var(--acbd); }
	/* Selection is marked by border color AND a checkmark badge — the shape
	   cue keeps picked/unpicked distinguishable for color-blind users. */
	.stack-anim .pick-badge {
		position: absolute;
		top: 10px;
		right: 10px;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: var(--ac);
		color: var(--s0);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 12px;
		font-weight: 700;
		opacity: 0;
		transform: scale(0.5);
		transition: all 0.4s ease;
	}
	.stack-anim .card.pick .pick-badge { opacity: 1; transform: scale(1); }

	.stack-anim .mk { width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; filter: grayscale(1); color: var(--tp); }
	.stack-anim .mk svg { width: 100%; height: 100%; }

	.stack-anim .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; }
	.stack-anim .nm { font-size: 14px; font-weight: 500; color: var(--tp); }
	.stack-anim .sub { font-size: 12px; color: var(--ts); }
	.stack-anim .sku { font-size: 12px; padding: 3px 8px; border-radius: var(--r); background: var(--s1); color: var(--ts); opacity: 0; transition: opacity 0.4s; }
	.stack-anim .sku.on { opacity: 1; background: var(--acbg); color: var(--ac); }
	.stack-anim .sku.hi { background: var(--acbg); color: var(--ac); }

	.stack-anim .bar { height: 5px; border-radius: 3px; background: var(--s0); overflow: hidden; }
	.stack-anim .fill { height: 100%; background: var(--ac); transition: width 0.7s cubic-bezier(0.4, 0, 0.2, 1); }
	.stack-anim .fill.p { background: var(--pu); }

	.stack-anim .link { stroke: var(--bds); stroke-width: 1.5; fill: none; transition: stroke-dashoffset 1s ease, stroke 0.4s; }

	.stack-anim .band { border-radius: 12px; padding: 14px 16px; border: 1px solid var(--bd); }
	/* Managed-operations band: neutral raised surface (was a green tint). */
	.stack-anim .band-accent { background: var(--s1); border-color: var(--bds); }
	.stack-anim .band-surface { background: var(--s1); }
	.stack-anim .s3-grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: 18px; }
	.stack-anim .s3-col { display: flex; flex-direction: column; gap: 6px; }
	.stack-anim .s3-col:nth-child(2) { gap: 10px; }
	.stack-anim .bt { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--tm); margin-bottom: 10px; }

	/* Presence metrics mini-dashboard beneath the seat bars in the seats col. */
	.stack-anim .wperf { margin-top: 20px; padding-top: 14px; border-top: 1px solid var(--bd); }
	.stack-anim .wperf__h { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--tm); margin-bottom: 12px; }
	.stack-anim .wstat { display: flex; justify-content: space-between; align-items: baseline; font-size: 12px; margin-bottom: 9px; }
	.stack-anim .wstat:last-child { margin-bottom: 0; }
	.stack-anim .wstat > span:first-child { color: var(--ts); }
	.stack-anim .wval { color: var(--tp); font-weight: 500; font-variant-numeric: tabular-nums; }
	.stack-anim .wval .wd { color: var(--ok); font-size: 11px; font-weight: 500; margin-right: 6px; opacity: 0; transition: opacity 0.4s; }

	.stack-anim .gap { height: 26px; display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 11px; color: var(--tm); opacity: 0; transition: opacity 0.5s; margin-block: 8px; }
	.stack-anim .gap.on { opacity: 1; }

	.stack-anim .tk { display: flex; align-items: center; gap: 8px; font-size: 12px; padding: 7px 10px; border-radius: var(--r); background: var(--s0); border: 1px solid var(--bd); opacity: 0; transform: translateY(10px); transition: all 0.45s; }
	.stack-anim .tk.on { opacity: 1; transform: none; }
	.stack-anim .tk.done { background: var(--okbg); border-color: transparent; color: var(--ok); }
	.stack-anim .src { font-size: 10px; padding: 1px 6px; border-radius: 20px; background: var(--pubg); color: #fff; white-space: nowrap; }

	.stack-anim .vend { display: flex; gap: 9px; flex-wrap: wrap; }
	.stack-anim .vd { width: 30px; height: 30px; border-radius: 8px; background: var(--s0); border: 1px solid var(--bd); display: flex; align-items: center; justify-content: center; transition: all 0.35s; padding: 6px; }
	.stack-anim .vd .mk { width: 100%; height: 100%; color: var(--tm); }
	.stack-anim .vd.hot { background: var(--pu); border-color: var(--pu); transform: scale(1.1); }
	.stack-anim .vd.hot .mk { color: #fff; }
	.stack-anim .vd.hot .mk svg [fill] { fill: #fff !important; }

	.stack-anim .metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 14px; }
	.stack-anim .metric { background: var(--s1); border-radius: var(--r); padding: 1rem; }
	.stack-anim .mv { font-size: 24px; font-weight: 500; color: var(--tp); }
	.stack-anim .ml { font-size: 13px; color: var(--ts); }
	.stack-anim .s4-list { display: flex; flex-direction: column; gap: 8px; }

	@media (max-width: 560px) {
		.stack-anim .s3-grid { grid-template-columns: 1fr; }
		.stack-anim .metrics { grid-template-columns: repeat(2, 1fr); }
	}
</style>

<script is:inline>
(function(){
// Brand-logo SVGs pre-rendered at build time into #stack-icon-pool (astro-iconset).
// Read them into a lookup once so the render helpers can stamp inline SVG markup
// instead of a runtime Iconify web component.
const POOL={};
// Direct-child spans only — astro-iconset also puts data-icon on the inner
// <svg>, so an unscoped [data-icon] would match the child and overwrite the
// entry with the <svg> wrapper stripped off.
document.querySelectorAll('#stack-icon-pool > [data-icon]').forEach(el=>{POOL[el.getAttribute('data-icon')]=el.innerHTML;});
function iconSvg(key,style){
  const raw=POOL[key];
  if(!raw) return '';
  return style ? raw.replace('<svg','<svg style="'+style+'"') : raw;
}
// Custom (non-simple-icons) marks: user-supplied logo assets, inlined.
const CUSTOM={rippling:{vb:"0 0 145.3 109.9",inner:"<path d=\"M17.5,30.5C17.5,18.4,11.4,8.4,0,0h26.5c9.3,7.2,15,18.2,15,30.5c0,12.3-5.7,23.3-15,30.5c8.6,3.6,13.5,12.4,13.5,25v24H16\n\t\tv-24c0-12-5.7-20.4-16-25C11.4,52.5,17.5,42.6,17.5,30.5 M69.4,30.5c0-12.1-6.1-22.1-17.5-30.5h26.5c9.3,7.2,15,18.2,15,30.5\n\t\tc0,12.3-5.7,23.3-15,30.5c8.6,3.6,13.5,12.4,13.5,25v24h-24v-24c0-12-5.7-20.4-16-25C63.3,52.5,69.4,42.6,69.4,30.5 M121.4,30.5\n\t\tc0-12.1-6.1-22.1-17.5-30.5h26.5c9.3,7.2,15,18.2,15,30.5c0,12.3-5.7,23.3-15,30.5c8.6,3.6,13.5,12.4,13.5,25v24h-24v-24\n\t\tc0-12-5.7-20.4-16-25C115.3,52.5,121.4,42.6,121.4,30.5\" fill=\"currentColor\"/>"},
wave:{vb:"0 0 65.2 56",inner:"<path d=\"M5.4,44.5c3.8,1.2,7.9-0.7,9-4.3l4.3-13.9c1.2-3.6-1-7.5-4.8-8.7l-0.3-0.1c-3.8-1.2-7.9,0.7-9,4.3L0.3,35.7\n\t\tc-1.2,3.6,1,7.5,4.8,8.7L5.4,44.5z\" fill=\"#084F99\"/><path d=\"M50.9,4.9c0.8-2,2.3-3.5,4.1-4.3c0.1,0,0.2-0.1,0.3-0.1c0.1,0,0.1,0,0.2-0.1c1.5-0.6,3.1-0.7,4.6-0.2l0.3,0.1\n\t\tc3.8,1.2,5.8,5.5,4.5,9.6c0,0-10.4,35.2-10.4,35.2C51.6,53.4,43,57.6,35.5,55.5c0,0-2-0.6-2.8-1.2C40.1,52.7,49.4,8.5,50.9,4.9z\" fill=\"#5EB7FF\"/><path d=\"M6.6,49.2c1.6,0.5,3.3,0.5,4.8,0.2c0.2-0.1,0.5-0.1,0.7-0.2c3.1-1,5.7-3.5,6.8-6.9l8.1-26.8\n\t\tc1.3-4.1,5.5-6.4,9.3-5.2l0.3,0.1c3.8,1.2,5.8,5.5,4.5,9.6c0,0-7.7,25.4-8.8,27.5c-7.9,14.3-22.7,7.3-26.9,1.3\n\t\tc0.2,0.1,0.5,0.2,0.7,0.3L6.6,49.2z\" fill=\"#1479FB\"/>"},
monday:{vb:"-1.66 -4.1 243.05 147.51",inner:"<path d=\"m28.94 143.16c-10.73-.26-19.45-5.16-24.94-14.91-5.66-10.12-5.3-20.5.84-30.37q23.51-37.72 47.23-75.33c2-3.24 4-6.56 6.14-9.7a29.41 29.41 0 0 1 49.41 31.86c-17.52 28.29-35.28 56.48-53.05 84.64-5.77 9.13-14.26 13.65-25.63 13.81z\" fill=\"#FF3D57\"/><path d=\"m120.24 143.16c-10.63-.26-19.4-4.95-25-14.74-5.74-10.12-5.49-20.48.63-30.35 14.57-23.49 29.33-46.85 44-70.27 3-4.79 5.93-9.65 9.07-14.35a29.4 29.4 0 0 1 40-9.09c13.81 8.51 18.43 26.21 9.83 40.16q-26.37 42.95-53.49 85.48c-5.57 8.77-14.02 13-25.04 13.16z\" fill=\"#FFCB00\"/><path d=\"m212.13 85.82c16.17.08 29.26 12.93 29.23 28.69 0 16-13.44 28.9-29.76 28.7s-29.18-12.91-29.16-28.74c.02-16.06 13.16-28.75 29.69-28.65z\" fill=\"#00D647\"/>"},
freshdesk:{vb:"2.7 13.6 32.7 32.7",inner:"<path d=\"M19 13.77h12.192a4.06 4.06 0 0 1 4.095 4.095v12.192a16.18 16.18 0 0 1-16.176 16.176h-.092a16.18 16.18 0 0 1-11.45-4.73 16.17 16.17 0 0 1-4.744-11.444c0-8.964 7.23-16.194 16.176-16.286z\" fill=\"#25C16F\"/><path d=\"M19 21a7.433 7.433 0 0 0-7.433 7.433v5.054a2.53 2.53 0 0 0 2.472 2.472h2.103v-5.8h-2.84v-1.623c.173-3.057 2.702-5.447 5.764-5.447s5.6 2.4 5.764 5.447v1.623h-2.877v5.8h1.9v.092a2.324 2.324 0 0 1-2.287 2.287h-2.27c-.184 0-.387.092-.387.277.01.2.177.378.387.387h2.287a2.97 2.97 0 0 0 2.951-2.951v-.184a2.444 2.444 0 0 0 1.9-2.398v-4.943C26.537 24.338 23.217 21 19 21z\" fill=\"#FFFFFF\"/>"}};
// icon: either a simple-icons slug string, or {custom:'key'}
const P=[
{n:'Rippling',s:'HRIS · identity · devices',sk:[{k:'Platform',q:22,c:8}],icon:{custom:'rippling'},pick:1},
{n:'ADP',s:'HRIS · payroll',sk:[{k:'Workforce Now',q:0,c:0}],icon:'simple-icons:adp',pick:0},
{n:'QuickBooks',s:'Accounting',sk:[{k:'Plus',q:3,c:99}],icon:'simple-icons:quickbooks',pick:1},
{n:'Asana',s:'Projects',sk:[{k:'Starter',q:22,c:11}],icon:'simple-icons:asana',pick:0},
{n:'monday.com',s:'Projects',sk:[{k:'Pro',q:0,c:0}],icon:{custom:'monday'},pick:0},
{n:'Workspace',s:'Identity + productivity',sk:[{k:'Starter',q:14,c:8.4,d:-1},{k:'Standard',q:8,c:16.8,d:1}],icon:'simple-icons:google',pick:1},
{n:'Microsoft 365',s:'Identity + productivity',sk:[{k:'Premium',q:0,c:0}],icon:'simple-icons:microsoft',pick:0},
{n:'Claude',s:'AI assistant',sk:[{k:'Team',q:15,c:30}],icon:'simple-icons:anthropic',pick:1},
{n:'ChatGPT',s:'AI assistant',sk:[{k:'Business',q:0,c:0}],icon:'simple-icons:openai',pick:0},
{n:'HubSpot',s:'CRM',sk:[{k:'Starter',q:5,c:20}],icon:'simple-icons:hubspot',pick:1},
{n:'Zendesk',s:'Support',sk:[{k:'Suite Team',q:6,c:55,d:2}],icon:'simple-icons:zendesk',pick:1},
{n:'Freshdesk',s:'Support',sk:[{k:'Pro',q:0,c:0}],icon:{custom:'freshdesk'},pick:0}];

const INT=[
 ['Rippling','Workspace'],['Rippling','Claude'],['Rippling','QuickBooks'],['Rippling','Zendesk'],
 ['Workspace','Claude'],['Workspace','HubSpot'],['HubSpot','QuickBooks'],['HubSpot','Zendesk'],['Claude','Zendesk']];
const $=i=>document.getElementById(i);
const TOT=p=>p.sk.reduce((a,s)=>a+s.q,0);

// Render a mark. mono=true -> monochrome (currentColor) for the vendor row.
function mark(p,mono){
  const ic=p.icon;
  if(typeof ic==='string'){
    return `<span class="mk">${iconSvg(ic)}</span>`;
  }
  const c=CUSTOM[ic.custom];
  const inner = mono ? c.inner.replace(/fill="#[0-9A-Fa-f]{6}"/g,'fill="currentColor"') : c.inner;
  return `<span class="mk"><svg viewBox="${c.vb}" xmlns="http://www.w3.org/2000/svg">${inner}</svg></span>`;
}

$('g0').innerHTML=P.map((p,i)=>`<div class="card" id="c${i}"><span class="pick-badge" aria-hidden="true">✓</span>${mark(p)}<div class="nm">${p.n}</div><div class="sub">${p.s}</div></div>`).join('');

const SEL=P.map((p,i)=>({...p,i})).filter(p=>p.pick);
$('dp').textContent=SEL.length;
$('g1').innerHTML=SEL.map(p=>`<div class="card pick">${mark(p)}<div class="nm">${p.n}</div>${p.sk.map((s,j)=>`<div class="sku${p.sk.length>1&&j==1?' hi':''}" id="k${p.i}_${j}">${s.k}</div>`).join('')}</div>`).join('');

// network: Rippling hub
const SPOKE=SEL.filter(p=>p.n!=='Rippling');
const CX=350,CY=175,pos={'Rippling':[CX,CY]};
SPOKE.forEach((p,i)=>{const a=i/SPOKE.length*2*Math.PI-Math.PI/2;pos[p.n]=[CX+235*Math.cos(a),CY+125*Math.sin(a)]});
// icon markup for SVG foreignObject
function netIcon(p,x,y,hub){
  const size=hub?28:22, off=size/2;
  return `<foreignObject x="${x-off}" y="${y-off}" width="${size}" height="${size}"><div xmlns="http://www.w3.org/1999/xhtml" style="width:${size}px;height:${size}px;display:flex;align-items:center;justify-content:center;filter:grayscale(1)">${markInvert(p,size)}</div></foreignObject>`;
}
function markInvert(p,size){
  const ic=p.icon;
  if(typeof ic==='string') return iconSvg(ic,`width:100%;height:100%;color:#fff`);
  const c=CUSTOM[ic.custom];
  const inner=c.inner.replace(/fill="#[0-9A-Fa-f]{6}"/g,'fill="#fff"');
  return `<svg viewBox="${c.vb}" style="width:100%;height:100%">${inner}</svg>`;
}
$('net').innerHTML=INT.map((e,i)=>{const a=pos[e[0]],b=pos[e[1]],hub=e[0]==='Rippling';
 const mx=hub?(a[0]+b[0])/2:CX,my=hub?(a[1]+b[1])/2:CY;
 return `<path class="link" id="L${i}" d="M${a[0]} ${a[1]} Q${mx} ${my} ${b[0]} ${b[1]}"/>`}).join('')
 +SEL.map(p=>{const[x,y]=pos[p.n],hub=p.n==='Rippling',r=hub?34:27;
 // Top spoke (QuickBooks): label above the node so it doesn't sit on the links.
 const ly=p.n==='QuickBooks'?y-40:y+(hub?52:44);
 return `<circle cx="${x}" cy="${y}" r="${r}" fill="var(--ac)"/>${netIcon(p,x,y,hub)}<text x="${x}" y="${ly}" text-anchor="middle" style="font-size:${hub?12:11}px;fill:var(--ts);font-weight:${hub?500:400}">${p.n}</text>`}).join('');
INT.forEach((e,i)=>{const el=$('L'+i),n=Math.ceil(el.getTotalLength())+2;el.style.strokeDasharray=n;el.style.strokeDashoffset=n;el.dataset.len=n});

// managed ops
const HEAD=22;
$('vend').innerHTML=SEL.map(p=>`<div class="vd" id="v${p.i}">${mark(p,true)}</div>`).join('')
 +`<div class="vd" id="vastro"><span class="mk">${iconSvg('simple-icons:astro')}</span></div>`;

let SQ=[14,8];
// This-month dashboard metrics; managed events (tickets) bump them.
const MBASE={vis:48210,soc:31400,conv:284};
const MEL={vis:['wVis','wVisD'],soc:['wSoc','wSocD'],conv:['wConv','wConvD']};
let MCUR=Object.assign({},MBASE);
const SB=[{n:'Workspace · Starter'},{n:'Workspace · Standard',p:1}];
$('seats').innerHTML=`<div style="font-size:11px;color:var(--tm);margin-bottom:2px;line-height:1.45">We continuously update your software licenses, website, social media, and ad campaigns to optimize performance and spending.</div>`+SB.map((s,j)=>`<div><div style="display:flex;justify-content:space-between;font-size:11px;margin-bottom:5px"><span style="color:var(--ts)">${s.n}</span><span style="color:var(--ts)"><span id="sd${j}" style="opacity:0;margin-right:5px"></span><span id="sq${j}">${SQ[j]}</span> seats</span></div><div class="bar"><div class="fill${s.p?' p':''}" id="sf${j}" style="width:${SQ[j]/HEAD*100}%"></div></div></div>`).join('')
 +`<div class="wperf"><div class="wperf__h">This month</div><div class="wstat"><span>Website visits</span><span class="wval"><span class="wd" id="wVisD"></span><span id="wVis">${MBASE.vis.toLocaleString()}</span></span></div><div class="wstat"><span>Social media views</span><span class="wval"><span class="wd" id="wSocD"></span><span id="wSoc">${MBASE.soc.toLocaleString()}</span></span></div><div class="wstat"><span>Conversions</span><span class="wval"><span class="wd" id="wConvD"></span><span id="wConv">${MBASE.conv.toLocaleString()}</span></span></div></div>`
;

const WS=P.findIndex(p=>p.n==='Workspace'),ZD=P.findIndex(p=>p.n==='Zendesk'),RI=P.findIndex(p=>p.n==='Rippling'),QB=P.findIndex(p=>p.n==='QuickBooks'),CL=P.findIndex(p=>p.n==='Claude'),HS=P.findIndex(p=>p.n==='HubSpot');
const TIX=[
 {t:'New hire, Sales',src:'Rippling',v:WS,q:[15,8]},
 {t:'Offboarding, Support',src:'Rippling',v:WS,q:[14,8]},
 {t:'Promoted, needs Standard',src:'Rippling',v:WS,q:[13,9]},
 {t:'Payroll run',v:QB},
 {t:'Updated website',v:'astro',vis:1120,conv:38},
 {t:'AI-tuned social media post',v:[CL,HS],soc:2300,conv:62},
 {t:'Zendesk API errors, escalated',v:ZD},
 {t:'Workspace security update applied',v:WS}];
$('tix').innerHTML=TIX.map((t,i)=>`<div class="tk" id="tk${i}"><span style="flex:1">${t.t}</span>${t.src?`<span class="src">via ${t.src}</span>`:''}<span id="tc${i}" style="opacity:0;font-size:11px">✓</span></div>`).join('');

$('g4').innerHTML=SEL.map(p=>`<div style="background:var(--s2);border:1px solid var(--bd);border-radius:var(--r);padding:10px 12px"><div style="display:flex;align-items:center;gap:12px"><div style="width:22px;height:22px">${mark(p)}</div><div style="flex:1;font-size:14px">${p.n}</div><span style="font-size:12px;color:var(--ts)">${TOT(p)} seats</span></div>${p.sk.map(s=>`<div style="display:flex;gap:12px;padding:6px 0 0 34px;font-size:12px;color:var(--tm)"><span style="flex:1">${s.k}</span><span>${s.q} seats</span><span style="width:66px;text-align:right;color:${s.d>0?'var(--ok)':s.d<0?'var(--wn)':'var(--tm)'}">${s.d?'('+(s.d>0?'+':'')+s.d+')':''}</span></div>`).join('')}</div>`).join('');

let anim=[];
const clrA=()=>{anim.forEach(clearTimeout);anim=[]};
function seat(j,v){const d=v-SQ[j];SQ[j]=v;$('sq'+j).textContent=v;$('sf'+j).style.width=v/HEAD*100+'%';if(!d)return;const e=$('sd'+j);e.textContent=(d>0?'+':'')+d;e.style.color=d>0?'var(--ok)':'var(--wn)';e.style.opacity=1;anim.push(setTimeout(()=>e.style.opacity=0,1400))}
// A managed event -> the matching dashboard metric climbs, with a fading
// +delta badge, mirroring the seat() feedback.
function bump(key,add){const[vid,did]=MEL[key],el=$(vid),d=$(did);if(!el)return;const from=MCUR[key],to=from+add;MCUR[key]=to;d.textContent='+'+add.toLocaleString();d.style.opacity=1;let v=from;const step=Math.max(1,Math.ceil(add/16));const t=setInterval(()=>{v+=step;if(v>=to){v=to;clearInterval(t)}el.textContent=v.toLocaleString()},45);anim.push(t);anim.push(setTimeout(()=>d.style.opacity=0,1600))}

function run(n){
 if(n===0)P.forEach((p,i)=>{const c=$('c'+i);c.className='card';if(p.pick)anim.push(setTimeout(()=>c.className='card pick',300+i*110))});
 if(n===1){SEL.forEach(p=>p.sk.forEach((s,j)=>$('k'+p.i+'_'+j).classList.remove('on')));let d=300;SEL.forEach(p=>p.sk.forEach((s,j)=>{const e=$('k'+p.i+'_'+j);anim.push(setTimeout(()=>e.classList.add('on'),d));d+=160}))}
 if(n===2)INT.forEach((e,i)=>{const el=$('L'+i);el.style.strokeDashoffset=el.dataset.len;el.style.stroke='var(--bds)';anim.push(setTimeout(()=>{el.style.strokeDashoffset=0;el.style.stroke='var(--ac)'},300+i*200))});
 if(n===3){
   SQ=[14,8];[0,1].forEach(j=>{$('sq'+j).textContent=SQ[j];$('sf'+j).style.width=SQ[j]/HEAD*100+'%';$('sd'+j).style.opacity=0});
   MCUR=Object.assign({},MBASE);for(const k in MEL){const[vid,did]=MEL[k];$(vid).textContent=MBASE[k].toLocaleString();$(did).style.opacity=0}
   TIX.forEach((t,i)=>{$('tk'+i).className='tk';$('tc'+i).style.opacity=0});
   SEL.forEach(p=>$('v'+p.i).classList.remove('hot'));$('vastro').classList.remove('hot');
   $('gap2').classList.remove('on');
   anim.push(setTimeout(()=>$('gap2').classList.add('on'),450));
   TIX.forEach((t,i)=>{const d=900+i*1600;
     anim.push(setTimeout(()=>$('tk'+i).classList.add('on'),d));
     anim.push(setTimeout(()=>{if(t.src)$('v'+RI).classList.add('hot');if(t.v!=null)[].concat(t.v).forEach(v=>{const vt=$('v'+v);if(vt)vt.classList.add('hot')})},d+450));
     anim.push(setTimeout(()=>{if(t.q){seat(0,t.q[0]);seat(1,t.q[1])}if(t.vis)bump('vis',t.vis);if(t.soc)bump('soc',t.soc);if(t.conv)bump('conv',t.conv)},d+750));
     anim.push(setTimeout(()=>{$('tk'+i).classList.add('done');$('tc'+i).style.opacity=1;$('v'+RI).classList.remove('hot');if(t.v!=null)[].concat(t.v).forEach(v=>{const vt=$('v'+v);if(vt)vt.classList.remove('hot')})},d+1200))})}
 if(n===4){$('dl').textContent=0;$('dc').textContent='$0';const S=SEL.reduce((a,p)=>a+TOT(p),0),C=SEL.reduce((a,p)=>a+p.sk.reduce((b,s)=>b+s.q*s.c,0),0);let v=0;const t=setInterval(()=>{v+=Math.ceil(S/20);if(v>=S){v=S;clearInterval(t)}$('dl').textContent=v;$('dc').textContent='$'+Math.round(v/S*C).toLocaleString()},50)}}

// Each step animates when it scrolls into view, and can be replayed.
const reduceMotion=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const steps=Array.from(document.querySelectorAll('.stack-anim .anim-step'));
const played=new Set();
if(!reduceMotion&&'IntersectionObserver'in window){
  const io=new IntersectionObserver((entries)=>{
    for(const e of entries){
      if(e.isIntersecting){const i=+e.target.dataset.step;if(!played.has(i)){played.add(i);run(i)}}
    }
  },{threshold:0.4});
  steps.forEach(s=>io.observe(s));
}else{
  // No IntersectionObserver / reduced motion: populate every step's end state.
  steps.forEach(s=>run(+s.dataset.step));
}
document.querySelectorAll('.stack-anim .anim-replay').forEach(b=>{
  b.onclick=()=>{const i=+b.dataset.replay;clrA();run(i)};
});
})();
</script>
