---
import type { BV } from './types';
import type { BlockComponentProps } from 'emdash/ui';
import Counter from '@getvitops/astro/components/Counter.astro';
import { resolveTone } from './tone';

interface Stat {
  value: string;
  unit?: string;
  text?: string;
  cite?: string;
  tone?: string;
  color?: string;
}
type Props = BlockComponentProps<BV<{ items?: Stat[] }>>;

const items = Astro.props.value.items ?? [];
---

<div class="vt-bleed centered">
  <ul class={`spotlight subgrid subgrid-cols-${Math.min(items.length || 1, 4)} subgrid-responsive`} role="list">
    {
      items.map((s) => (
        <li class="card subgrid-card vt-stat" style={resolveTone(s.tone, s.color).style}>
          <p class="vt-stat__value vt-tone-text">
            <Counter value={s.value} />
            {s.unit && <small class="text-neutral-muted">{s.unit}</small>}
          </p>
          <div class="subgrid-card__footer rhythm">
            {s.text && <p>{s.text}</p>}
            {s.cite && <cite class="font-caption text-neutral-muted">{s.cite}</cite>}
          </div>
        </li>
      ))
    }
  </ul>
</div>
