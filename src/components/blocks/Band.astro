---
import type { BV } from './types';
import type { BlockComponentProps } from 'emdash/ui';
import { resolveTone } from './tone';

interface BandValue {
  icon?: string;
  heading: string;
  body?: string;
  cta_label?: string;
  cta_href?: string;
  tone?: string;
  color?: string;
}
type Props = BlockComponentProps<BV<BandValue>>;

const { value } = Astro.props;
const t = resolveTone(value.tone, value.color);
---

<div class="region vt-band border-y vt-tone-wash" style={t.style}>
  <div class="centered">
    <div class="spotlight cluster cluster-center-between vt-band__row">
      {value.icon && <span class="vt-band__icon vt-tone-text" aria-hidden="true">{value.icon}</span>}
      <div class="vt-band__text rhythm">
        <h2 class="font-subheading">{value.heading}</h2>
        {value.body && <p class="text-neutral-muted">{value.body}</p>}
      </div>
      {value.cta_label && value.cta_href && (
        <a class="btn vt-tone-btn" href={value.cta_href}>{value.cta_label} ›</a>
      )}
    </div>
  </div>
</div>
