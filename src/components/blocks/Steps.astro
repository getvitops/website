---
import type { BV } from './types';
import type { BlockComponentProps } from 'emdash/ui';

interface Step {
  title: string;
  body?: string;
}
type Props = BlockComponentProps<BV<{ kicker?: string; heading: string; steps?: Step[] }>>;

const { value } = Astro.props;
const steps = value.steps ?? [];
---

<section class="region">
  <div class="centered rhythm">
    <div class="spotlight vt-head rhythm">
      {value.kicker && <span class="font-eyebrow text-pine-400">{value.kicker}</span>}
      <h2>{value.heading}</h2>
    </div>
    <ol class={`spotlight subgrid subgrid-cols-${Math.min(steps.length || 1, 4)} subgrid-responsive vt-steps`} role="list">
      {
        steps.map((s, i) => (
          <li class="subgrid-card vt-plain">
            <span class="vt-step-n">{i + 1}</span>
            <h3 class="font-title">{s.title}</h3>
            {s.body && <p class="text-neutral-muted">{s.body}</p>}
          </li>
        ))
      }
    </ol>
  </div>
</section>
