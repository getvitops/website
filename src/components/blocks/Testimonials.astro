---
import Subgrid from "@getvitops/astro/components/Subgrid.astro";

interface Props {
	node: {
		headline?: string;
		testimonials: Array<{
			quote: string;
			author: string;
			role?: string;
			company?: string;
			avatar?: string;
		}>;
	};
}

const { node } = Astro.props;
const { headline, testimonials } = node;
---

<section class="testimonials section">
	<div class="container">
		{headline && (
			<header class="section-header">
				<h2 class="section-headline">{headline}</h2>
			</header>
		)}
		<Subgrid class="testimonials-grid">
			{testimonials.map((testimonial) => (
				<li class="testimonial-card subgrid-card">
					<blockquote class="testimonial-quote">
						"{testimonial.quote}"
					</blockquote>
					<div class="testimonial-author flex items-center">
						{testimonial.avatar && (
							<img
								src={testimonial.avatar}
								alt={testimonial.author}
								class="testimonial-avatar"
								loading="lazy"
							/>
						)}
						<div class="testimonial-info">
							<span class="testimonial-name">{testimonial.author}</span>
							{(testimonial.role || testimonial.company) && (
								<span class="testimonial-role">
									{testimonial.role}
									{testimonial.role && testimonial.company && " at "}
									{testimonial.company}
								</span>
							)}
						</div>
					</div>
				</li>
			))}
		</Subgrid>
	</div>
</section>

<style>
	.testimonials {
		background: var(--color-surface);
	}

	/* Quote and author are the tranches subgrid aligns, so a short quote
	   doesn't leave its author sitting above its neighbours'. */
	.testimonials-grid {
		--subgrid-cols: 3;
		--subgrid-row-span: 2;
		--subgrid-card-rows: 2; /* must match --subgrid-row-span; .subgrid-card's
		                           own grid-row wins the cascade over .subgrid's */
		--subgrid-gap: var(--spacing-xl);
	}

	.testimonial-card {
		padding: var(--spacing-xl);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		gap: var(--spacing-lg);
	}

	.testimonial-quote {
		font-size: var(--font-size-lg);
		line-height: var(--leading-normal);
		color: var(--color-text);
	}

	.testimonial-author {
		gap: var(--spacing-md);
	}

	.testimonial-avatar {
		width: 48px;
		height: 48px;
		border-radius: var(--radius-full);
		object-fit: cover;
	}

	.testimonial-info {
		display: flex;
		flex-direction: column;
	}

	.testimonial-name {
		font-weight: 600;
		font-size: var(--font-size-sm);
	}

	.testimonial-role {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.testimonials-grid {
			--subgrid-cols: 2;
		}
	}

	@media (max-width: 600px) {
		.testimonials-grid {
			--subgrid-cols: 1;
		}
	}
</style>
