---
import type { BV } from './types';
import type { BlockComponentProps } from 'emdash/ui';
import { resolveTone } from './tone';

interface Pillar {
  tone?: string;
  color?: string;
  tag?: string;
  title: string;
  body?: string;
  points?: string;
  cta_label?: string;
  href?: string;
}
type Props = BlockComponentProps<
  BV<{ items?: Pillar[]; eyebrow?: string; heading?: string; lead?: string; anchor?: string }>
>;

const value = Astro.props.value;
const items = value.items ?? [];
const str = (v?: string) => (typeof v === 'string' ? v.trim() : '');
const eyebrow = str(value.eyebrow);
const heading = str(value.heading);
const lead = str(value.lead);
const anchor = /^[a-z][a-z0-9-]{0,63}$/.test(str(value.anchor)) ? str(value.anchor) : undefined;
const hasHead = Boolean(eyebrow || heading || lead);
const lines = (s?: string) => (s ?? '').split('\n').map((l) => l.trim()).filter(Boolean);
---

<div id={anchor} class:list={['vt-bleed', 'vt-grid', 'centered', anchor && 'block-anchor', hasHead && 'vt-pillars-block--headed']}>
{
  hasHead && (
    <header class="spotlight rhythm vt-pillars__head">
      {eyebrow && <p class="font-eyebrow">{eyebrow}</p>}
      {heading && <h2 class="font-title">{heading}</h2>}
      {lead && <p class="font-lead">{lead}</p>}
    </header>
  )
}
<ul class={`spotlight subgrid subgrid-cols-${Math.min(items.length || 1, 3)} subgrid-responsive vt-pillars`} role="list">
  {
    items.map((p) => {
      const t = resolveTone(p.tone, p.color);
      return (
        <li class="card subgrid-card vt-pillar" style={t.style}>
          {p.tag && <span class="font-eyebrow vt-tone-text">{p.tag}</span>}
          <h3 class="font-subheading">{p.title}</h3>
          <div class="subgrid-card__footer rhythm">
            {p.body && <p class="text-neutral-muted">{p.body}</p>}
            <ul class="vt-checks" role="list">
              {lines(p.points).map((l) => (
                <li>
                  <span class="vt-check vt-tone-fill" aria-hidden="true">✓</span>
                  {l}
                </li>
              ))}
            </ul>
            {p.cta_label && p.href && (
              <a class="btn inline-block vt-ghost vt-tone-outline" href={p.href}>{p.cta_label} ›</a>
            )}
          </div>
        </li>
      );
    })
  }
</ul>
</div>
