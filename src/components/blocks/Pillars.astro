---
import type { BV } from './types';
import type { BlockComponentProps } from 'emdash/ui';
import { blockComponents } from '@getvitops/emdash/astro';

interface Pillar {
  tone?: string;
  color?: string;
  tag?: string;
  title: string;
  body?: string;
  points?: string;
  cta_label?: string;
  href?: string;
}
type Props = BlockComponentProps<
  BV<{ items?: Pillar[]; eyebrow?: string; heading?: string; lead?: string; anchor?: string }>
>;

const value = Astro.props.value;
const items = value.items ?? [];
const str = (v?: string) => (typeof v === 'string' ? v.trim() : '');
const eyebrow = str(value.eyebrow);
const heading = str(value.heading);
const lead = str(value.lead);
const anchor = /^[a-z][a-z0-9-]{0,63}$/.test(str(value.anchor)) ? str(value.anchor) : undefined;
const hasHead = Boolean(eyebrow || heading || lead);
// Retired (UPSTREAM.md registry): the panels are a `vitops_cards` `variant: panel` block now.
// This adapter keeps content saved as `vt_pillars` rendering through it, so no local card markup remains.
const Cards = blockComponents.vitops_cards;
const cards = {
  _type: 'vitops_cards',
  variant: 'panel',
  columns: Math.min(items.length || 1, 3),
  className: 'spotlight',
  cards: items.map((p) => ({
    title: p.title,
    body: p.body,
    tags: p.tag,
    checklist: p.points,
    ctaLabel: p.cta_label,
    ctaHref: p.href,
    tone: p.tone,
    color: p.color,
  })),
};
---

<div id={anchor} class:list={['vt-bleed', 'vt-grid', 'centered', anchor && 'block-anchor', hasHead && 'vt-pillars-block--headed']}>
{
  hasHead && (
    <header class="spotlight rhythm vt-pillars__head">
      {eyebrow && <p class="font-eyebrow">{eyebrow}</p>}
      {heading && <h2 class="font-title">{heading}</h2>}
      {lead && <p class="font-lead">{lead}</p>}
    </header>
  )
}
<Cards value={cards} />
</div>
