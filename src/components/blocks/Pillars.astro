---
import type { BV } from './types';
import type { BlockComponentProps } from 'emdash/ui';
import { resolveTone } from './tone';

interface Pillar {
  tone?: string;
  color?: string;
  tag?: string;
  title: string;
  body?: string;
  points?: string;
  cta_label?: string;
  href?: string;
}
type Props = BlockComponentProps<BV<{ items?: Pillar[] }>>;

const items = Astro.props.value.items ?? [];
const lines = (s?: string) => (s ?? '').split('\n').map((l) => l.trim()).filter(Boolean);
---

<div class="vt-bleed vt-grid centered">
<ul class={`spotlight subgrid subgrid-cols-${Math.min(items.length || 1, 3)} subgrid-responsive vt-pillars`} role="list">
  {
    items.map((p) => {
      const t = resolveTone(p.tone, p.color);
      return (
        <li class="card subgrid-card vt-pillar" style={t.style}>
          {p.tag && <span class="font-eyebrow vt-tone-text">{p.tag}</span>}
          <h3 class="font-subheading">{p.title}</h3>
          <div class="subgrid-card__footer rhythm">
            {p.body && <p class="text-neutral-muted">{p.body}</p>}
            <ul class="vt-checks" role="list">
              {lines(p.points).map((l) => (
                <li>
                  <span class="vt-check vt-tone-fill" aria-hidden="true">✓</span>
                  {l}
                </li>
              ))}
            </ul>
            {p.cta_label && p.href && (
              <a class="btn inline-block vt-ghost vt-tone-outline" href={p.href}>{p.cta_label} ›</a>
            )}
          </div>
        </li>
      );
    })
  }
</ul>
</div>
