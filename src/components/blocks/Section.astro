---
import type { BV } from './types';
import { PortableText, type BlockComponentProps } from 'emdash/ui';

interface SectionValue {
  kicker?: string;
  heading: string;
  sub?: string;
  tone?: 'plain' | 'grid';
  body?: unknown[];
}
type Props = BlockComponentProps<BV<SectionValue>>;

const { value } = Astro.props;
---

<section class:list={['region', 'border-b', 'border-neutral-muted', value.tone === 'grid' && 'vt-grid']}>
  <div class="centered rhythm">
    <div class="spotlight vt-head rhythm">
      {value.kicker && <span class="font-eyebrow text-pine-400">{value.kicker}</span>}
      <h2>{value.heading}</h2>
      {value.sub && <p class="vt-sub text-neutral-muted">{value.sub}</p>}
    </div>
    {
      value.body && value.body.length > 0 && (
        <div class="spotlight vt-body">
          <PortableText value={value.body as never} />
        </div>
      )
    }
  </div>
</section>
