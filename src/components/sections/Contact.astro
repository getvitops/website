---
// CONTACT — extracted verbatim from src/pages/index.astro (A/B layer-3
// enabler refactor). Markup, scoped styles, and the form-submit script are a
// pure move. Load-bearing ids: `contact` (nav anchor), `contact-form`,
// `form-status` (script hooks).
---

<!-- CONTACT -->
<section class="contact section centered" id="contact">
	<div class="spotlight contact-grid">
		<div class="contact-intro">
			<span class="font-eyebrow">Talk to a partner</span>
			<h2 class="font-title">Tell us what you're running.</h2>
			<p class="font-body contact-copy">
				Send a note and a partner will get back to you. No forms into a
				void, no sales script. Tell us where things stand and what you would
				like off your plate, and we will tell you plainly whether we are the
				right fit.
			</p>
			<p class="font-caption">
				Or email <a class="link" href="mailto:hi@vitops.ca">hi@vitops.ca</a>.
			</p>
		</div>

		<form class="card bg-navy-d contact-form" id="contact-form" novalidate>
			<div class="field">
				<label for="cf-name">Name</label>
				<input id="cf-name" name="name" type="text" autocomplete="name" required />
			</div>
			<div class="field">
				<label for="cf-email">Work email</label>
				<input id="cf-email" name="email" type="email" autocomplete="email" required />
			</div>
			<div class="field">
				<label for="cf-company">Company <span class="opt">(optional)</span></label>
				<input id="cf-company" name="company" type="text" autocomplete="organization" />
			</div>
			<div class="field">
				<label for="cf-message">What would you like off your plate?</label>
				<textarea id="cf-message" name="message" rows="4" required></textarea>
			</div>
			<button type="submit">Send it over</button>
			<p class="form-status" id="form-status" role="status" aria-live="polite"></p>
		</form>
	</div>
</section>

<style>
	/* Contact */
	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: clamp(2rem, 5vw, 5rem);
		align-items: start;
	}
	.contact-intro .font-title {
		margin-top: 0.75rem;
		font-size: clamp(2rem, 4vw, 3rem);
	}
	.contact-copy {
		margin-block: 1.25rem;
		color: var(--color-mist);
		max-width: 46ch;
	}
	.contact-form {
		display: grid;
		gap: 1.1rem;
		padding: 2rem;
	}
	.field {
		display: grid;
		gap: 0.4rem;
	}
	.field label {
		font-size: var(--text-s);
		font-weight: 500;
		color: var(--color-snow);
	}
	.field .opt {
		color: var(--color-slate);
		font-weight: 400;
	}
	.contact-form input,
	.contact-form textarea {
		inline-size: 100%;
		background: var(--color-navy-xxd);
		color: var(--color-snow);
		border: 1px solid var(--line-2);
		border-radius: var(--br-control, 0.4rem);
		padding: 0.65rem 0.8rem;
		font-family: var(--font-sans);
		font-size: var(--text-s);
	}
	.contact-form input:focus,
	.contact-form textarea:focus {
		outline: none;
		border-color: var(--color-pine);
		box-shadow: 0 0 0 3px rgba(74, 144, 117, 0.25);
	}
	.contact-form textarea {
		resize: vertical;
	}
	.contact-form button {
		justify-self: start;
		background: var(--color-pine);
		color: #0a0d0c;
	}
	.contact-form button:hover {
		background: var(--color-pine-l);
	}
	.form-status {
		margin: 0;
		font-size: var(--text-s);
		min-block-size: 1.2em;
	}
	.form-status.ok {
		color: var(--color-pine-l);
	}
	.form-status.err {
		color: var(--color-amber);
	}

	@media (max-width: 860px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	const form = document.getElementById("contact-form") as HTMLFormElement | null;
	const status = document.getElementById("form-status");

	if (form && status) {
		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			status.className = "form-status";
			status.textContent = "Sending…";

			const data = Object.fromEntries(new FormData(form).entries());

			try {
				const res = await fetch("/api/contact", {
					method: "POST",
					headers: { "content-type": "application/json" },
					body: JSON.stringify(data),
				});
				const body = (await res.json()) as { ok: boolean; message?: string; error?: string };

				if (res.ok && body.ok) {
					status.classList.add("ok");
					status.textContent = body.message || "Thanks. A partner will be in touch shortly.";
					form.reset();
				} else {
					status.classList.add("err");
					status.textContent = body.error || "Something went wrong. Try again, or email hi@vitops.ca.";
				}
			} catch {
				status.classList.add("err");
				status.textContent = "Could not reach the server. Try again, or email hi@vitops.ca.";
			}
		});
	}
</script>
