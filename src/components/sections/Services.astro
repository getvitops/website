---
// TWO PILLARS (again). Was three while Back Office existed as its own
// pillar; folded back into Managed IT services (2026-09) once bookkeeping and
// payroll were re-scoped to software administration rather than a performed
// service. The `id="services"` anchor is load-bearing.
//
// Feature lists double as the homepage's keyword surface — the terms people
// actually search need to appear here, not only on the pillar pages.
//
// Each card is heading + feature list, deliberately. The lead paragraph that
// used to sit between them restated the list in prose; the pillar pages carry
// that narrative instead. Don't reintroduce it.
//
// Styling is framework classes (`npx vitops docs classes`): `card` pattern,
// `rhythm` for flow, `list` for the feature lists, functional colour tokens.
import Subgrid from "@getvitops/astro/components/Subgrid.astro";

const pillars = [
	{
		tag: "01 · Managed IT services",
		href: "/managed-it-services",
		heading: "The software stack, selected, wired, and run.",
		features: [
			"Software selection, implementation, and integration — including bookkeeping, payroll and HR systems",
			"AI enablement where it genuinely earns its place",
			"HRIS configured and maintained: records, time off, policy acknowledgements",
			"Joiner, mover, leaver: onboarding and offboarding, licences and access",
			"Vendor management: one number, every vendor in the stack",
			"Backup you control, and access security enforced rather than assumed",
		],
		signals: "Feeds your business's health: seats in use vs. seats paid for, systems up, requests closed.",
	},
	{
		tag: "02 · Digital marketing",
		href: "/digital-marketing",
		heading: "Everywhere your buyers look, handled.",
		features: [
			"Managed, high-performance websites",
			"SEO and answer-engine optimization for search and AI assistants",
			"Curated ad campaigns, tuned for conversions over time",
			"Social media, kept active and on brand",
			"Verified business profiles on Google, Bing, and Apple",
		],
		signals: "Feeds your business's health: visits, search and social impressions, quotes given and won.",
	},
];
---

<!-- TWO PILLARS -->
<section class="services section centered anim-slow" id="services">
	<div class="spotlight">
		<header class="rhythm max-w-[60ch] mb-12 fade-in slide-up animate-view">
			<span class="font-eyebrow">What we do</span>
			<h2 class="font-title">Two services. One partner on file.</h2>
			<p class="font-lead text-neutral-muted">
				The software your business runs on and the marketing that brings
				customers to it. Take one or take both — they're run by the same
				people either way.
			</p>
		</header>

		<Subgrid class="pillars-grid stagger">
			{
				pillars.map((p) => (
					<li class="card subgrid-card rhythm fade-in slide-up animate-view">
						<span class="font-eyebrow text-brand-primary">{p.tag}</span>
						<h3 class="font-heading">{p.heading}</h3>
						<ul class="list rhythm pt-4 border-t border-neutral" role="list">
							{p.features.map((f) => (
								<li class="font-body text-neutral-muted">{f}</li>
							))}
						</ul>
						<p class="font-caption pillar-signals">{p.signals}</p>
						<p class="font-caption">
							<a class="link" href={p.href}>
								More on {p.tag.split("· ")[1]} →
							</a>
						</p>
					</li>
				))
			}
		</Subgrid>
	</div>
</section>

<style>
	/* Slower, earlier-starting entrance for every .animate-view descendant —
	   see the identical rule + rationale in Pain.astro. */
	.anim-slow {
		--anim-start: -8vh;
		--anim-end: 40vh;
	}

	/* Tag, heading, feature list and the "More on…" caption are the tranches
	   subgrid aligns, so the shortest feature list doesn't leave its link
	   sitting above its neighbours'. Framework classes handle everything else
	   (see header comment) — this is only the subgrid custom-property contract. */
	.pillars-grid {
		--subgrid-cols: 2;
		--subgrid-row-span: 6;
		--subgrid-card-rows: 6; /* must match --subgrid-row-span; .subgrid-card's
		                           own grid-row wins the cascade over .subgrid's */
		--subgrid-gap: 1.5rem;
	}
	.pillar-signals {
		color: var(--color-slate);
	}

	/* 48rem to match the original @md: container-query breakpoint this
	   replaced (--container-md in tailwind.css) as closely as a viewport
	   query can. */
	@media (max-width: 48rem) {
		.pillars-grid {
			--subgrid-cols: 1;
		}
	}
</style>
