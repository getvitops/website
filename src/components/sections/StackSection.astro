---
// VITOPS COMPLETE — the home page's one deep section. Everything else on the
// home page is brief; this is where the bundle argument gets made, and step 04
// of the stack animation ("Run the day to day") carries it. Only that step
// renders here — the full five-step sequence is on /business-software and the
// presence animation is on /digital-presence, so the home page stays a summary.
//
// The `id="complete"` anchor is load-bearing — Hero's "See how it works" CTA
// points at it.
import StackAnimation from "../StackAnimation.astro";
---

<!-- VITOPS COMPLETE — bundle section + stack animation -->
<section class="stack-section section centered" id="complete">
	<div class="spotlight">
		<header class="section-intro fade-in slide-up animate-view">
			<span class="font-eyebrow">Vitops Complete</span>
			<h2 class="font-title">All three, run by one team.</h2>
			<p class="font-lead section-lead">
				Take one service or take all three. Taken together they stop being three
				vendors and become one operation: one team helping to choose and running
				the software, one workflow behind every joiner and leaver, one view of
				your business's health — what's coming in, what's going out, what's
				actually working — one bill, and one number to call. Here is what that
				looks like day to day.
			</p>
		</header>
		<StackAnimation steps={[3]} />
	</div>
</section>

<style>
	/* Section intros (shared block, duplicated per section — Astro scoping) */
	.section-intro {
		max-width: 56ch;
		margin-bottom: 3rem;
	}
	.section-intro .font-title {
		margin-top: 0.75rem;
		font-size: clamp(2rem, 4vw, 3rem);
	}
	.section-lead {
		margin-top: 1rem;
		color: var(--color-mist);
	}
</style>
