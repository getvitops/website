---
// Homepage hero. Was the "A" champion of an A/B pair; the challenger and the
// variant machinery were removed while traffic is too low to resolve a test.
---

<section class="hero hero-glow section centered">
	<div class="hero-inner spotlight fullbleed">
		<span class="font-eyebrow">Business software · Back office · Digital presence</span>
		<h1 class="font-display hero-title">
			The work that keeps your business running, handled by one partner.
		</h1>
		<p class="font-lead hero-lead">
			Vitops runs the software your business operates on, the bookkeeping,
			payroll and HR administration behind it, and the digital presence in
			front of it. Three services, one team on file, so the website that wins
			the customer and the systems that serve them stay in step.
		</p>
		<div class="hero-cta cluster">
			<a class="cta" href="#contact">Talk to us <span class="arrow">→</span></a>
			<a class="cta-ghost" href="#it-hr">See how it works</a>
		</div>
	</div>
</section>

<style>
	/* Hero — the glow rides the fullbleed track behind breakout-width copy. */
	.hero {
		overflow: hidden;
		align-items: start;
	}
	.hero-glow {
		grid-row: 1;
		align-self: start;
		background: radial-gradient(
			ellipse 80% 60% at 30% 0%,
			rgba(74, 144, 117, 0.1) 0%,
			transparent 70%
		);
	}
	.hero-title {
		margin-block: 1.25rem 1.5rem;
		font-size: clamp(2.6rem, 6vw, 4.5rem);
		line-height: 1;
	}
	.hero-lead {
		color: var(--color-mist);
		max-width: 56ch;
	}
	.hero-cta {
		margin-top: 2.25rem;
	}
</style>
