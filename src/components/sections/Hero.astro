---
// Homepage hero (variant A). The B challenger was deleted — no B content exists
// right now — but the variant system is intact (src/lib/variant.ts +
// src/middleware.ts). To test a new hero: add src/_b/sections/Hero.astro and
// pick() between them in src/pages/index.astro.
---

<section class="hero hero-glow section centered">
	<div class="hero-inner spotlight fullbleed">
		<span class="font-eyebrow">Managed IT services · Digital marketing</span>
		<h1 class="font-display hero-title">
			Tired of managing everything yourself? Not sure if your software is helping you succeed?
		</h1>
		<p class="font-lead hero-lead">
			Small businesses struggle when they can't commit to becoming experts across business operations, and they don't have enough revenue to hire specialists.
			Vitops handles two pillars of your operations for you: digital marketing (websites, social media, ad campaigns), and IT (software selection/setup/integration and user management).
		</p>
		<div class="hero-cta cluster">
			<a class="cta" href="#contact">Talk to us <span class="arrow"></span></a>
			<a class="cta-ghost" href="#complete">See how it works</a>
		</div>
	</div>
</section>

<style>
	/* Hero — the glow rides the fullbleed track behind breakout-width copy. */
	.hero {
		overflow: hidden;
		align-items: start;
	}
	.hero-glow {
		grid-row: 1;
		align-self: start;
		background: radial-gradient(
			ellipse 80% 60% at 30% 0%,
			rgba(74, 144, 117, 0.1) 0%,
			transparent 70%
		);
	}
	.hero-title {
		margin-block: 1.25rem 1.5rem;
		font-size: clamp(2.6rem, 6vw, 4.5rem);
		line-height: 1;
	}
	.hero-lead {
		color: var(--color-mist);
		max-width: 56ch;
	}
	.hero-cta {
		margin-top: 2.25rem;
	}
</style>
