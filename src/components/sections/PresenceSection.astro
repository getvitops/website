---
// DIGITAL PRESENCE ANIMATION — extracted verbatim from src/pages/index.astro
// (A/B layer-3 enabler refactor). The `id="digital-presence"` anchor is
// load-bearing.
import PresenceAnimation from "../PresenceAnimation.astro";
---

<!-- DIGITAL PRESENCE ANIMATION -->
<section class="presence-section section centered" id="digital-presence">
	<div class="spotlight">
		<header class="section-intro">
			<span class="font-eyebrow">Digital presence</span>
			<h2 class="font-title">Your presence, working while you work.</h2>
			<p class="font-lead section-lead">
				A fast, findable website and campaigns that get steered every month,
				not set and forgotten. Here is what that looks like.
			</p>
		</header>
		<PresenceAnimation />
	</div>
</section>

<style>
	/* Section intros (shared block, duplicated per section — Astro scoping) */
	.section-intro {
		max-width: 56ch;
		margin-bottom: 3rem;
	}
	.section-intro .font-title {
		margin-top: 0.75rem;
		font-size: clamp(2rem, 4vw, 3rem);
	}
	.section-lead {
		margin-top: 1rem;
		color: var(--color-mist);
	}
</style>
