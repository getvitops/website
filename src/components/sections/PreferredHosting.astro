---
// PREFERRED HOSTING PLATFORMS — logo strip, same pattern as PreferredVendors.
// Icons are inlined at build time via astro-iconset (no runtime requests).
// "whc" is a local icon (src/icons/whc.svg) — Web Hosting Canada isn't in
// simple-icons.
import { Icon } from "astro-iconset/components";

const platforms = [
	{ name: "Cloudflare", icon: "simple-icons:cloudflare" },
	{ name: "Azure", icon: "simple-icons:microsoftazure" },
	{ name: "IONOS", icon: "simple-icons:ionos" },
	{ name: "WHC", icon: "whc" },
];
---

<!-- PREFERRED HOSTING PLATFORMS -->
<section class="hosting-section section centered" id="hosting">
	<div class="spotlight">
		<header class="section-intro">
			<span class="font-eyebrow">Preferred hosting platforms</span>
		</header>
		<ul class="platform-strip">
			{
				platforms.map((p) => (
					<li class="platform">
						<Icon name={p.icon} />
						<span class="platform-name">{p.name}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.section-intro {
		max-width: 56ch;
		margin-bottom: 2rem;
	}

	.platform-strip {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		align-items: center;
		gap: 1.5rem 3rem;
	}
	.platform {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--color-mist);
	}
	.platform :global(svg) {
		width: 1.5rem;
		height: 1.5rem;
	}
	.platform-name {
		font-size: var(--text-s);
		letter-spacing: 0.02em;
	}

	@media (min-width: 768px) {
		.platform-strip {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
