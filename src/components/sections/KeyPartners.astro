---
// KEY PARTNERS — logo strip of the platforms we implement, manage, and host on.
// Icons are inlined at build time via astro-iconset (no runtime requests).
// "whc" is a local icon (src/icons/whc.svg) — Web Hosting Canada isn't in
// simple-icons.
//
// Rendered on the homepage and on /business-software, so the footnote link is
// root-relative (`/#contact`): the anchor lives in Contact.astro, which only the
// homepage renders. A bare `#contact` would resolve against the current page and
// dangle everywhere else. Matches PineLayout's own CTAs.
import { Icon } from "astro-iconset/components";

const partners = [
	{ name: "Zoho", icon: "simple-icons:zoho" },
	{ name: "Google", icon: "simple-icons:google" },
	{ name: "Microsoft", icon: "simple-icons:microsoft" },
	{ name: "QuickBooks", icon: "simple-icons:quickbooks" },
	{ name: "HubSpot", icon: "simple-icons:hubspot" },
	{ name: "Zendesk", icon: "simple-icons:zendesk" },
	{ name: "Anthropic", icon: "simple-icons:anthropic" },
	{ name: "Rippling", icon: "rippling" },
	{ name: "Cloudflare", icon: "simple-icons:cloudflare" },
	{ name: "Azure", icon: "simple-icons:microsoftazure" },
	{ name: "IONOS", icon: "simple-icons:ionos" },
	{ name: "WHC", icon: "whc" },
];
---

<!-- KEY PARTNERS -->
<section class="partners-section section centered" id="partners">
	<div class="spotlight">
		<header class="section-intro">
			<span class="font-eyebrow">Key partners</span>
		</header>
		<ul class="partner-strip">
			{
				partners.map((p) => (
					<li class="partner">
						<Icon name={p.icon} />
						<span class="partner-name">{p.name}</span>
					</li>
				))
			}
		</ul>
		<p class="footnote">
			Interested in something else? <a href="/#contact">Reach out</a> to see how
			we can make it work
		</p>
	</div>
</section>

<style>
	.section-intro {
		max-width: 56ch;
		margin-bottom: 2rem;
	}

	.partner-strip {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		align-items: center;
		gap: 1.5rem 3rem;
	}
	.partner {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--color-mist);
	}
	.partner :global(svg) {
		width: 1.5rem;
		height: 1.5rem;
	}
	.partner-name {
		font-size: var(--text-s);
		letter-spacing: 0.02em;
	}

	.footnote {
		margin-top: 2rem;
		font-size: var(--text-s);
		color: var(--color-mist);
	}

	@media (min-width: 768px) {
		.partner-strip {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
