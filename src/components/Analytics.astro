---
/**
 * Microsoft Clarity tag.
 *
 * Rendered in <head> by PineLayout, so it covers every public page and no
 * /_emdash/admin route (which does not use this layout).
 *
 * The gate is server-side: on any non-production host the meta tags below are
 * simply not emitted and the script no-ops. The script itself is bundled (it
 * imports the npm wrapper), so it cannot use `define:vars` — Astro forces
 * define:vars scripts inline, which forbids imports. Hence the meta-tag
 * handoff rather than an interpolated variable.
 */
import { CLARITY_PROJECT_ID, clarityEnabled } from "../lib/analytics";

const enabled = clarityEnabled(Astro.url.hostname, Astro.originPathname);
const variant = Astro.locals.variant ?? "a";
---

{
	enabled && (
		<Fragment>
			<meta name="clarity-project-id" content={CLARITY_PROJECT_ID} />
			<meta name="clarity-ab-variant" content={variant} />
		</Fragment>
	)
}

<script>
	import Clarity from "@microsoft/clarity";

	const projectId = document.querySelector<HTMLMetaElement>(
		'meta[name="clarity-project-id"]',
	)?.content;

	if (projectId) {
		Clarity.init(projectId);

		// Segment recordings/heatmaps by A/B arm. Dormant today (every visitor
		// gets `a`), but it means a launched test is already attributed in
		// Clarity without a second deploy — filter by the `ab_variant` tag.
		const variant = document.querySelector<HTMLMetaElement>(
			'meta[name="clarity-ab-variant"]',
		)?.content;
		if (variant) Clarity.setTag("ab_variant", variant);
	}
</script>
