---
// EmDash-backed funding program pages (`funding_programs` collection) rendered
// through the same ProgramPage shell the hand-written ones used. On-demand so a
// publish (e.g. a program closing) is live immediately. `funding/index.astro`
// stays a static page.
import { getEmDashEntry } from "emdash";
import ProgramPage from "../../components/page/ProgramPage.astro";

import { CMS_PAGE_CACHE } from "../../lib/cache";
import { paragraphs } from "../../lib/inline";

export const prerender = false;

const slug = Astro.params.slug ?? "";
const { entry, cacheHint } = await getEmDashEntry("funding_programs", slug);
Astro.cache.set(cacheHint);

// A bodiless 404 makes Astro serve src/pages/404.astro.
// no-store: a cached 404 carries no entry tag, so publishing the page later
// would not purge it.
if (!entry) return new Response(null, { status: 404, headers: { "cache-control": "private, no-store" } });
Astro.cache.set(CMS_PAGE_CACHE); // after the 404 return: a missing entry must not get a lifetime

const d = entry.data;
// Repeater fields (`*_items`) are what editors fill in; the legacy json fields
// are the fallback until every environment is migrated.
const facts: [string, string][] = d.fact_items?.length
	? d.fact_items.map((f: { term: string; value: string }) => [f.term, f.value])
	: d.facts;
const sections = d.section_items?.length
	? d.section_items.map((s: { title: string; body?: string | null }) => ({ title: s.title, body: paragraphs(s.body) }))
	: d.sections;
const faq = d.faq_items?.length ? d.faq_items : d.faq;
const relatedLinks = d.link_items?.length ? d.link_items : d.related_links;
---

<ProgramPage
	slug={slug}
	title={d.title}
	description={d.seo?.description ?? ""}
	eyebrow={d.eyebrow}
	h1={d.h1}
	directAnswer={d.direct_answer}
	verified={d.verified}
	sourceUrl={d.source_url}
	sourceLabel={d.source_label}
	facts={facts}
	sections={sections}
	faq={faq}
	relatedLinks={relatedLinks}
/>
