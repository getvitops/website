---
/**
 * A/B layer-3 dispatcher — the single real route behind every structural B
 * page. Reached ONLY via `next(payload)` rewrites from src/middleware.ts;
 * direct external requests to /b-variant/* are 404'd there before dispatch.
 * `Astro.locals.variant` is already set (the rewrite reuses the same context).
 *
 * B pages under src/_b/pages/ are self-contained full pages (they render
 * PineLayout themselves), so nothing is passed down.
 */
import { getBPageLoader, normalizePathname } from "../../lib/ab-pages";

export const prerender = false;

const raw = Astro.params.path ?? ""; // undefined for /b-variant itself
const loader = getBPageLoader(normalizePathname(`/${raw}`));

// Defensive only: the middleware rewrites solely when hasBPage() is true
// (same glob), so this is unreachable unless the two fall out of sync.
if (!loader) return new Response(null, { status: 404 });

const Page = (await loader()).default as any;
---

<Page />
