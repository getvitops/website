---
import PineLayout from "../../layouts/PineLayout.astro";
import PageHero from "../../components/page/PageHero.astro";
import SectionIntro from "../../components/page/SectionIntro.astro";
import Cards from "../../components/page/Cards.astro";
import Prose from "../../components/page/Prose.astro";
import PageCta from "../../components/page/PageCta.astro";
import Schema from "../../components/page/Schema.astro";
import { breadcrumb, SITE_URL } from "../../lib/schema";

export const prerender = false;

// Routing page, and the fit page. Pillars are service-shaped; buyers are
// industry-shaped. But industry is only a proxy — the real qualifier is the
// owner-was-the-practitioner profile below. The four verticals are examples of
// that profile, not the boundary of who we work with.
const profile = [
	{
		heading: "The owner came up doing the work.",
		body: "You know the craft cold. Nobody trained you to run payroll, choose an HRIS, or decide whether a licence is worth renewing, and none of it is what you wanted to spend Thursday on.",
	},
	{
		heading: "Admin competes with billable hours.",
		body: "In a business where the owner still does the work, every hour on the back office is an hour that didn't earn. That maths is different from a company where an operations manager already exists.",
	},
	{
		heading: "Past spreadsheets, short of a department.",
		body: "Usually somewhere between 5 and 150 people. Too big to keep running on memory and a shared drive; too small to justify hiring for IT, HR and marketing separately.",
	},
	{
		heading: "Something is regulated or confidential.",
		body: "Client files, patient records, safety documentation, licensing. Not always onerous, but enough that getting access control wrong has consequences beyond inconvenience.",
	},
];

const industries = [
	{
		tag: "01 · Industry",
		name: "Trades and contractors",
		href: "/industries/trades",
		body: "Crews on sites, tablets that need to work without signal, a dispatch process that can't wait for head office. Plus safety documentation that has to survive an inspection.",
	},
	{
		tag: "02 · Industry",
		name: "Real estate brokerages",
		href: "/industries/real-estate",
		body: "A roster that turns over faster than anything else we work with, board-connected tools that don't integrate cleanly, and commission administration that has to be exactly right.",
	},
	{
		tag: "03 · Industry",
		name: "Legal, accounting and professional firms",
		href: "/industries/professional-services",
		body: "Matter-based permissions, conflict checks, and retention rules where the consequence of getting access wrong is professional rather than merely awkward.",
	},
	{
		tag: "04 · Industry",
		name: "Medical and dental clinics",
		href: "/industries/clinics",
		body: "PHIPA obligations, an EMR that dictates a lot of the environment, and front-desk staff who cannot be waiting on IT while patients are in the room.",
	},
];

const listSchema = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	name: "Industries Vitops works with",
	itemListElement: industries.map((i, n) => ({
		"@type": "ListItem",
		position: n + 1,
		name: i.name,
		url: `${SITE_URL}${i.href}`,
	})),
};
---

<PineLayout
	title="Who we work with — owner-led Ontario businesses"
	description="Vitops works with owner-led Ontario businesses where the owner came up doing the work. Trades, brokerages, professional firms and clinics are where that fit shows up most often."
>
	<Schema data={listSchema} />
	<Schema data={breadcrumb(["Industries", "/industries"])} />

	<PageHero
		eyebrow="Who we work with"
		title="You were good at the work. Then you inherited a back office."
		lead="Most of our clients started the same way. Someone who was excellent at the actual job — the wiring, the filings, the treatment, the deal — started a company doing it, and the admin arrived uninvited. The industry varies. The shape rarely does."
	/>

	<Prose lead>
		<p>
			Vitops works with owner-led businesses in Ontario, typically between 5 and
			150 people, where the person who founded the company is still close to the
			work it does. The four industries below are where that pattern shows up
			most often and where we already know the tools, the compliance pressures
			and the staffing rhythms — but they're examples of the fit, not the limit
			of it.
		</p>
	</Prose>

	<section class="section centered">
		<div class="spotlight">
			<SectionIntro
				eyebrow="The fit"
				title="What our clients have in common."
				lead="This matters more than the sector. If these four describe you, the industry name on the door is mostly a detail."
			/>
			<Cards cards={profile} />
		</div>
	</section>

	<section class="section centered">
		<div class="spotlight">
			<SectionIntro
				eyebrow="Where it shows up most"
				title="Four industries built almost entirely of these businesses."
				lead="We know these four well enough to be useful in the first week — the tools, the rules, and what urgent means at four in the afternoon. If you're somewhere else, the service is the same; it just takes us a little longer to learn your particulars, and we'll say so rather than pretend otherwise."
			/>
			<div class="industry-grid">
				{
					industries.map((i) => (
						<a class="card bg-navy-d industry-card" href={i.href}>
							<span class="card-tag">{i.tag}</span>
							<h3 class="font-heading">{i.name}</h3>
							<p class="font-body card-copy">{i.body}</p>
							<span class="industry-go">
								Read more <span aria-hidden="true">→</span>
							</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<PageCta
		title="Tell us what you run."
		lead="Whether or not it's one of the four. We'll tell you honestly how much of your situation we already understand."
		links={[
			{ label: "Business software", href: "/business-software" },
			{ label: "Back office", href: "/back-office" },
			{ label: "Digital presence", href: "/digital-presence" },
			{ label: "Pricing", href: "/pricing" },
			{ label: "Funding", href: "/funding" },
		]}
	/>
</PineLayout>

<style>
	.industry-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
	}
	.industry-card {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		padding: 2rem;
		text-decoration: none;
		color: inherit;
		border: 1px solid transparent;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}
	.industry-card:hover {
		border-color: var(--line-2);
		transform: translateY(-2px);
	}
	.card-tag {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-pine-l);
	}
	.card-copy {
		color: var(--color-mist);
		margin: 0;
	}
	.industry-go {
		margin-top: auto;
		padding-top: 0.5rem;
		font-size: var(--text-s);
		color: var(--color-pine);
	}

	@media (max-width: 860px) {
		.industry-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
