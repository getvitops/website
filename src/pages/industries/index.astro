---
import PineLayout from "../../layouts/PineLayout.astro";
import PageHero from "../../components/page/PageHero.astro";
import SectionIntro from "../../components/page/SectionIntro.astro";
import PageCta from "../../components/page/PageCta.astro";
import Schema from "../../components/page/Schema.astro";
import { breadcrumb, SITE_URL } from "../../lib/schema";

export const prerender = false;

// Routing page. Pillars are service-shaped; buyers are industry-shaped. This is
// the second axis — keep it short, the substance lives on the four verticals.
const industries = [
	{
		tag: "01 · Industry",
		name: "Trades and contractors",
		href: "/industries/trades",
		body: "Crews on sites, tablets that need to work without signal, a dispatch process that can't wait for head office. Plus safety documentation that has to survive an inspection.",
	},
	{
		tag: "02 · Industry",
		name: "Real estate brokerages",
		href: "/industries/real-estate",
		body: "A roster that turns over faster than anything else we work with, board-connected tools that don't integrate cleanly, and commission administration that has to be exactly right.",
	},
	{
		tag: "03 · Industry",
		name: "Legal, accounting and professional firms",
		href: "/industries/professional-services",
		body: "Matter-based permissions, conflict checks, and retention rules where the consequence of getting access wrong is professional rather than merely awkward.",
	},
	{
		tag: "04 · Industry",
		name: "Medical and dental clinics",
		href: "/industries/clinics",
		body: "PHIPA obligations, an EMR that dictates a lot of the environment, and front-desk staff who cannot be waiting on IT while patients are in the room.",
	},
];

const listSchema = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	name: "Industries Vitops serves",
	itemListElement: industries.map((i, n) => ({
		"@type": "ListItem",
		position: n + 1,
		name: i.name,
		url: `${SITE_URL}${i.href}`,
	})),
};
---

<PineLayout
	title="IT, HR and digital presence by industry"
	description="How we run software, back office and digital presence for Ontario trades, real estate brokerages, professional firms and clinics."
>
	<Schema data={listSchema} />
	<Schema data={breadcrumb(["Industries", "/industries"])} />

	<PageHero
		eyebrow="Industries"
		title="You need a partner who knows your field."
		lead="The work is the same in outline everywhere — software, back office, presence. What differs is which parts hurt, which rules apply, and what urgent means at four in the afternoon. These four are the ones we know well enough to be useful in the first week."
	/>

	<section class="section centered">
		<div class="spotlight">
			<SectionIntro
				eyebrow="Where we're deep"
				title="Four industries, four different pressures."
			/>
			<div class="industry-grid">
				{
					industries.map((i) => (
						<a class="card bg-navy-d industry-card" href={i.href}>
							<span class="card-tag">{i.tag}</span>
							<h3 class="font-heading">{i.name}</h3>
							<p class="font-body card-copy">{i.body}</p>
							<span class="industry-go">
								Read more <span aria-hidden="true">→</span>
							</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="section centered">
		<div class="spotlight">
			<SectionIntro title="If you're not one of these." />
			<p class="font-body limit-copy">
				We still work with businesses outside these four, and the underlying
				service doesn't change. What changes is how long it takes us to be
				genuinely useful — in a field we know, that's the first week; in one we
				don't, it's more like the first month, and we'd rather say that up front
				than discover it together.
			</p>
		</div>
	</section>

	<PageCta
		title="Tell us what you run."
		links={[
			{ label: "Business software", href: "/business-software" },
			{ label: "Back office", href: "/back-office" },
			{ label: "Digital presence", href: "/digital-presence" },
			{ label: "Pricing", href: "/pricing" },
			{ label: "Funding", href: "/funding" },
		]}
	/>
</PineLayout>

<style>
	.industry-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
	}
	.industry-card {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		padding: 2rem;
		text-decoration: none;
		color: inherit;
		border: 1px solid transparent;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}
	.industry-card:hover {
		border-color: var(--line-2);
		transform: translateY(-2px);
	}
	.card-tag {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-pine-l);
	}
	.card-copy {
		color: var(--color-mist);
		margin: 0;
	}
	.industry-go {
		margin-top: auto;
		padding-top: 0.5rem;
		font-size: var(--text-s);
		color: var(--color-pine);
	}
	.limit-copy {
		max-width: 68ch;
		color: var(--color-mist);
	}

	@media (max-width: 860px) {
		.industry-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
