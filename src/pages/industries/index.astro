---
import PineLayout from "../../layouts/PineLayout.astro";
import PageHero from "../../components/page/PageHero.astro";
import SectionIntro from "../../components/page/SectionIntro.astro";
import Cards from "../../components/page/Cards.astro";
import Prose from "../../components/page/Prose.astro";
import PageCta from "../../components/page/PageCta.astro";
import Schema from "../../components/page/Schema.astro";
import { breadcrumb, SITE_URL } from "../../lib/schema";
import { INDUSTRIES } from "../../lib/industries";
import Subgrid from "@getvitops/astro/components/Subgrid.astro";

// Prerendered: no per-request data on this page. EmDash pins the site to
// output:"server" — its injected /_emdash/* dynamic routes would each need
// getStaticPaths() under output:"static" — so prerendering is opted into
// per page. Only /api/contact and the A/B dispatcher stay on-demand.
export const prerender = true;

// Routing page, and the fit page. Pillars are service-shaped; buyers are
// industry-shaped. But industry is only a proxy — the real qualifier is the
// point at which administration stops being absorbed and starts costing real
// time and money against revenue work. Owner-led businesses are a common client
// profile, not a target: describe it, don't qualify on it. The verticals listed
// are where we see the threshold crossed most often, not the boundary of who we
// work with.
const profile = [
	{
		heading: "Nobody's actual job is the back office.",
		body: "It's split between people whose real work is something else — the owner, the office manager, whoever had a gap. It gets done, but it gets done last, and it's nobody's specialism.",
	},
	{
		heading: "Admin competes directly with revenue work.",
		body: "Every hour on payroll, licences and paperwork is an hour not spent on what the business is paid for. The maths gets worse as you grow, because the admin grows faster than the number of people absorbing it.",
	},
	{
		heading: "Past spreadsheets, short of a department.",
		body: "Usually somewhere between 5 and 150 people. Too big to keep running on memory and a shared drive; too small to justify hiring for IT, HR and marketing separately.",
	},
	{
		heading: "Something is regulated or confidential.",
		body: "Client files, patient records, safety documentation, licensing. Not always onerous, but enough that getting access control wrong has consequences beyond inconvenience.",
	},
];

// Un-parked 2026-09-05 — the four per-industry pages now exist for real
// (industries/trades.astro and siblings, no more underscore prefix), so each
// card below links to its own page and the ItemList schema's `item.url`
// points at that real, dereferenceable URL rather than a same-page anchor.
//
// The list itself lives in src/lib/industries.ts, shared with IndustryPage.astro
// so it can link each vertical to its three siblings.
const industries = INDUSTRIES;

const listSchema = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	name: "Industries Vitops works with",
	itemListElement: industries.map((i, n) => ({
		"@type": "ListItem",
		position: n + 1,
		item: {
			"@type": "Thing",
			name: i.name,
			url: `${SITE_URL}/industries/${i.slug}`,
			description: i.body,
		},
	})),
};
---

<PineLayout
	title="Who we work with — Ontario businesses by industry"
	description="Vitops works with Ontario businesses at the size where administration turns into a real cost — trades, real estate, professional firms and clinics most often."
>
	<Schema data={listSchema} />
	<Schema data={breadcrumb(["Industries", "/industries"])} />

	<PageHero
		eyebrow="Who we work with"
		title="Past a certain size, the back office starts eating the work that pays."
		lead="Administration never earned anything. For a while that's fine — it gets absorbed into evenings and gaps between jobs. Then headcount, software and obligations grow faster than the people handling them, and it turns into real hours and real money taken off the work you actually get paid for."
	/>

	<section class="section centered">
		<div class="spotlight">
			<SectionIntro
				eyebrow="Where it shows up most"
				title="Four kinds of business where administration has become a measurable cost, not a rounding error."
				lead="We know these sectors well enough to be useful in the first week — the tools, the rules, and what urgent means at four in the afternoon. If you're somewhere else, the service is the same; it just takes us a little longer to learn your particulars, and we'll say so rather than pretend otherwise."
			/>
			<Subgrid class="industry-grid">
				{
					industries.map((i) => (
						<li class="card subgrid-card industry-card" id={i.slug}>
							<h3 class="font-heading">
								<a class="link stretched-link" href={`/industries/${i.slug}`}>
									{i.name}
								</a>
							</h3>
							<p class="font-body card-copy">{i.body}</p>
						</li>
					))
				}
			</Subgrid>
		</div>
	</section>

	<Prose lead>
		<p>
			Vitops works with Ontario businesses, typically between 5 and 150 people,
			that have reached the size where back-office administration is a
			measurable cost rather than a rounding error — usually somewhere between
			half a day and two days a week of someone's time, spent on work that
			generates no revenue.
		</p>
	</Prose>

	<section class="section centered">
		<div class="spotlight">
			<SectionIntro
				eyebrow="The fit"
				title="What our clients have in common."
				lead="The sector is really only a proxy — what follows is what actually decides the fit. Many of our clients are owner-led and the founder is still close to the work, but that's a pattern we notice rather than a requirement. If these describe you, the name on the door is mostly a detail."
			/>
			<Cards cards={profile} />
		</div>
	</section>

	<PageCta
		title="Tell us what you run."
		lead="Whether or not it's one of the sectors above. We'll tell you honestly how much of your situation we already understand."
		links={[
			{ label: "Managed IT services", href: "/managed-it-services" },
			{ label: "Digital marketing", href: "/digital-marketing" },
			{ label: "Pricing", href: "/pricing" },
			{ label: "Funding", href: "/funding" },
		]}
	/>
</PineLayout>

<style>
	/* Heading and body are the tranches subgrid aligns. */
	.industry-grid {
		--subgrid-cols: 2;
		--subgrid-row-span: 2;
		--subgrid-card-rows: 2; /* must match --subgrid-row-span; .subgrid-card's
		                           own grid-row wins the cascade over .subgrid's */
		--subgrid-gap: 1.5rem;
	}
	.industry-card {
		gap: 0.85rem;
		padding: 2rem;
		transition: border-color 0.15s ease;
	}
	.industry-card:hover {
		border-color: var(--color-pine);
	}
	.card-copy {
		color: var(--color-mist);
		margin: 0;
	}

	@media (max-width: 860px) {
		.industry-grid {
			--subgrid-cols: 1;
		}
	}
</style>
