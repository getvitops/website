---
import PineLayout from "../layouts/PineLayout.astro";
import PageHero from "../components/page/PageHero.astro";
import Subgrid from "@getvitops/astro/components/Subgrid.astro";

export const prerender = false;

// --- IT & HR Operations: priced per employee, per month ---------------------
const opsTiers = [
	{
		name: "Basics",
		price: "$35",
		unit: "/ user / mo",
		blurb: "We choose and maintain the stack. You still run it day to day.",
		features: [
			"Software selection, implementation, and integration guidance",
			"Ongoing license maintenance",
		],
		highlighted: false,
	},
	{
		name: "Foundations",
		price: "$69",
		unit: "/ user / mo",
		blurb: "The software side run for you, on a set cadence.",
		features: [
			"Everything in Basics, plus:",
			"Joiner / mover / leaver basics — onboarding & offboarding handled",
			"Baseline endpoint security on every device",
			"License tuning & right-sizing across your stack",
			"Quarterly operations review — one dashboard, one bill",
			"Email & ticket support, business hours",
		],
		highlighted: true,
	},
	{
		name: "Managed",
		price: "$119",
		unit: "/ user / mo",
		tag: "Fully managed",
		blurb: "Foundations, but continuous — monitored, automated, and we take the vendor calls.",
		features: [
			"Everything in Foundations, plus:",
			"Full identity & lifecycle management (SCIM / JML automation)",
			"Continuous endpoint security monitoring",
			"Day-to-day software support & vendor escalation",
		],
		highlighted: false,
	},
];

// --- Digital Presence: priced per service -----------------------------------
const presenceServices = [
	{
		name: "SEO & GEO optimization",
		price: "$650",
		period: "/ mo",
		included: [
			"Ongoing search + AI-answer-engine optimization with monthly reporting",
		],
	},
	{
		name: "Ad campaign management",
		price: "$500",
		period: "/ mo + spend",
		included: [
			"Curated Google / social campaigns, steered monthly for conversions",
			"Management fee only — ad spend billed separately, no markup",
		],
	},
	{
		name: "Social media management",
		price: "$650",
		period: "/ mo",
		included: [
			"Content calendar and posting across up to 3 platforms, kept on brand",
		],
	},
	{
		name: "Business listings",
		price: "$75",
		period: "/ mo",
		included: [
			"Google Business Profile, Bing Places, Apple Business Connect — claimed, verified, kept in sync",
		],
	},
];

// --- Back Office: priced per service ----------------------------------------
//
// Bookkeeping's rate is confirmed. Payroll, benefits administration and HR
// operations are still ⚠️ PLACEHOLDER figures — plausible Canadian SMB numbers
// chosen so the structure could be reviewed. Confirm them before production.
//
// Priced per service, NOT per seat, deliberately: software licences scale with
// headcount, but bookkeeping scales with transaction volume and entity count.
// A 12-person contractor with three entities and heavy AP is more work than a
// 40-person firm with clean books, so $/user misprices both ends.
//
// Joiner/mover/leaver is intentionally absent — it spans both halves and is
// already priced inside the IT & HR per-seat tiers. Don't double-charge it.
const backOfficeServices = [
	{
		name: "Bookkeeping",
		price: "from $400",
		period: "/ mo",
		included: [
			"Transaction coding, bank and credit card reconciliations, payables and receivables",
			"Monthly close, with the books kept current rather than rebuilt at year-end",
			"Banded by transaction volume and number of entities — we quote after a look at your last quarter",
		],
	},
	{
		name: "Managed payroll",
		price: "$185",
		period: "/ mo + $9 / employee",
		included: [
			"Pay runs, direct deposits, CRA remittances, T4s and ROEs, run to schedule",
			"Year-end filing and audit-ready documentation",
		],
	},
	{
		name: "Benefits administration",
		price: "$145",
		period: "/ mo",
		included: [
			"Enrolments, life events, terminations, and payroll deduction sync",
			"Employee questions handled directly, so they don't come to you",
			"Your broker keeps the plan — we run the daily administration of it",
		],
	},
	{
		name: "HR operations & HRIS",
		price: "$225",
		period: "/ mo",
		included: [
			"Employee records, time off, policy acknowledgements, document retention",
			"HRIS configured once and maintained, not left to drift",
		],
	},
];

// --- Website plans: three mutually exclusive tiers, pick one -----------------
const hostingTiers = [
	{
		name: "Essential",
		price: "$39",
		unit: "/ mo",
		annual: "$34/mo annual",
		setup: "$750 setup",
		features: [
			"AI-built Astro site with security updates, analytics, and transactional email",
			"2 small edits / mo",
			"Everything competitors nickel-and-dime, included: uptime monitoring, SSL, backups, staging environment",
			"Ships SEO- & AI-search (GEO) optimized at build: Core Web Vitals, structured data, sitemaps, llms.txt, FAQ schema",
		],
		highlighted: false,
	},
	{
		name: "Signal",
		price: "$89",
		unit: "/ mo",
		annual: "$79/mo annual",
		setup: "$750 setup",
		tag: "Most popular",
		features: [
			"Everything in Essential, plus:",
			"Server-side conversion tracking (Meta CAPI, Google enhanced conversions)",
			"Qualified-lead alerts — a text, email, or call when a lead matches your rules, not every form fire",
			"Automated monthly SEO & performance report: keyword ranks, Search Console, Core Web Vitals, conversion summary",
			"4 edits / mo with priority turnaround",
		],
		highlighted: true,
	},
	{
		name: "Growth",
		price: "$229",
		unit: "/ mo",
		annual: "$199/mo annual",
		setup: "$750 setup, +$500 tracking / rules config",
		features: [
			"Everything in Signal, plus the managed layer:",
			"Monthly A/B test cycle with plain-language results",
			"Quarterly 30-minute strategy call",
			"One landing page per quarter",
			"6 edits / mo",
			"Best above ~500 sessions / mo — below that, heatmap-driven iteration instead. No ads management or e-commerce.",
		],
		highlighted: false,
	},
];

const finePrint = [
	"No long-term contracts — month-to-month, always",
	"No hidden fees — ad spend and one-time project costs are always itemized separately",
	"Every plan starts with a conversation, not a form into a void",
];
---

<PineLayout
	title="Pricing"
	description="Three services, priced simply. Software operations per employee; bookkeeping, payroll and benefits administration per service; managed website plans from $39/mo. Month-to-month.">
	<!-- PAGE INTRO -->
	<PageHero
		eyebrow="Pricing"
		title="Three services, priced simply."
		lead="Month-to-month, no long-term contracts — cancel with 30 days' notice. IT & HR has no setup fee; website plans include a one-time build & setup. These prices are a starting point for planning; your actual quote depends on team size and scope."
		secondaryLabel="See what funding covers"
		secondaryHref="#pricing-funding"
	/>

	<!-- BUSINESS SOFTWARE -->
	<section class="section centered" id="it-hr-pricing">
		<div class="spotlight">
			<header class="section-intro">
				<span class="font-eyebrow">Business software</span>
				<h2 class="font-title">Priced per employee, right-sized as your team grows.</h2>
				<p class="font-body section-lead">
					The software your business runs on: selection, integration, identity and
					lifecycle, endpoint security and support. Bookkeeping, payroll and
					benefits are <a class="link" href="#back-office-pricing">priced separately</a>
					— they scale with volume, not headcount.
				</p>
			</header>

			<Subgrid class="pricing-tiers">
				{
					opsTiers.map((tier) => (
						<article
							class:list={[
								"card",
								"pricing-tier",
								tier.highlighted ? "pricing-tier--featured" : "",
							]}>
							<div class="tier-head">
								<div class="tier-name-row">
									<h3 class="font-heading tier-name">{tier.name}</h3>
									{tier.tag && <span class="tier-tag">{tier.tag}</span>}
								</div>
								<p class="tier-price">
									<span class="tier-price__amount">{tier.price}</span>
									<span class="tier-price__unit">{tier.unit}</span>
								</p>
								{tier.blurb && <p class="font-body tier-blurb">{tier.blurb}</p>}
							</div>
							<ul class="feature-list">
								{tier.features.map((f) => (
									<li>{f}</li>
								))}
							</ul>
							<a
								class:list={["tier-cta", tier.highlighted ? "cta" : "cta-ghost"]}
								href="/#contact">
								Get started <span class="arrow">→</span>
							</a>
						</article>
					))
				}
			</Subgrid>

			<p class="section-note breakout">
				Running something these plans don't cover? Ask us about our other
				managed services.
			</p>
		</div>
	</section>

	<!-- BACK OFFICE -->
	<section class="section centered" id="back-office-pricing">
		<div class="spotlight">
			<header class="section-intro">
				<span class="font-eyebrow">Back office</span>
				<h2 class="font-title">Priced per service, because the work isn't per seat.</h2>
				<p class="font-lead section-lead">
					Bookkeeping, payroll and benefits administration scale with
					transaction volume and entity count, not with how many people you
					employ — so they're priced per service, not per seat. Take one, take
					all of them, or combine them with the other two services for{" "}
					<a class="link" href="#pricing-bundles">a bundle discount</a>.
				</p>
			</header>

			<div class="svc-table card">
				{
					backOfficeServices.map((svc) => (
						<div class="svc-row">
							<div class="svc-head">
								<h3 class="font-heading svc-name">{svc.name}</h3>
								<p class="svc-price">
									<span class="svc-price__amount">{svc.price}</span>
									<span class="svc-price__period">{svc.period}</span>
								</p>
							</div>
							<ul class="svc-included">
								{svc.included.map((line) => (
									<li>{line}</li>
								))}
							</ul>
						</div>
					))
				}
			</div>

			<p class="section-note breakout">
				Onboarding and offboarding isn't listed here — it spans both halves and
				is already in the Foundations and Managed{" "}
				<a class="link" href="#it-hr-pricing">business software</a> plans.
			</p>
		</div>
	</section>

	<!-- DIGITAL PRESENCE -->
	<section class="section centered" id="digital-presence-pricing">
		<div class="spotlight">
			<header class="section-intro">
				<span class="font-eyebrow">Digital Presence</span>
				<h2 class="font-title">One managed website plan. Pick your tier.</h2>
				<p class="font-lead section-lead">
					Build, hosting, and care in a single monthly price — pick one tier,
					add services as you grow. Annual billing saves roughly two months.
				</p>
			</header>

			<Subgrid class="pricing-tiers">
				{
					hostingTiers.map((tier) => (
						<article
							class:list={[
								"card",
								"pricing-tier",
								tier.highlighted ? "pricing-tier--featured" : "",
							]}>
							<div class="tier-head">
								<div class="tier-name-row">
									<h3 class="font-heading tier-name">{tier.name}</h3>
									{tier.tag && <span class="tier-tag">{tier.tag}</span>}
								</div>
								<p class="tier-price">
									<span class="tier-price__amount">{tier.price}</span>
									<span class="tier-price__unit">{tier.unit}</span>
								</p>
								<p class="tier-sub">
									{tier.annual} · {tier.setup}
								</p>
							</div>
							<ul class="feature-list">
								{tier.features.map((f) => (
									<li>{f}</li>
								))}
							</ul>
							<a
								class:list={["tier-cta", tier.highlighted ? "cta" : "cta-ghost"]}
								href="/#contact">
								Get started <span class="arrow">→</span>
							</a>
						</article>
					))
				}
			</Subgrid>

			<article class="card sovereign">
				<div class="sovereign-head">
					<span class="font-eyebrow callout-eyebrow">Sovereign</span>
					<span class="sovereign-price">+$39 / mo · any tier</span>
				</div>
				<p class="sovereign-copy">
					Canadian-owned hosting (WHC), no US-controlled layer, Matomo
					analytics, Canadian-resident backups. A toggle you can add to any
					plan — not a tier of its own.
				</p>
			</article>

			<p class="section-note breakout">
				Extra work beyond your plan's included edits is billed at $80 / hour.
			</p>

			<h3 class="font-heading addons-head">Add-on services</h3>
			<div class="svc-table card">
				{
					presenceServices.map((svc) => (
						<div class="svc-row">
							<div class="svc-head">
								<h3 class="font-heading svc-name">{svc.name}</h3>
								<p class="svc-price">
									<span class="svc-price__amount">{svc.price}</span>
									<span class="svc-price__period">{svc.period}</span>
								</p>
							</div>
							<ul class="svc-included">
								{svc.included.map((line) => (
									<li>{line}</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- BUNDLES -->
	<!--
		Each pricing block above sells one thing at one price — no service is
		quoted twice, so there is no per-seat vs per-service crossover to reason
		about. What combining actually buys lives here instead, and the argument
		is deliberately about capability before discount: the integrations only
		exist when the same partner runs both halves. That is the company's whole
		thesis, so this section is where it gets made concretely.
	-->
	<section class="section centered" id="pricing-bundles">
		<div class="spotlight">
			<header class="rhythm max-w-[60ch] mb-12">
				<span class="font-eyebrow">Vitops Complete</span>
				<h2 class="font-title">What you get by combining them.</h2>
				<p class="font-lead text-neutral-muted">
					Each service stands on its own. Together they close loops that stay
					open when two vendors own the halves — and the combined monthly total
					drops <strong>15%</strong> from the second service on.
				</p>
			</header>

			<div class="grid gap-6 @md:grid-cols-3">
				<article class="card rhythm">
					<span class="font-eyebrow text-brand-primary">Software + Back office</span>
					<h3 class="font-heading">Onboarding stops being a handoff.</h3>
					<p class="font-body text-neutral-muted">
						The same partner runs the HRIS and the identity system, so a new
						hire's accounts, licences and permissions exist before their first
						shift — and a leaver's are gone the same day, everywhere. Split
						across two vendors, that's an email and a wait.
					</p>
				</article>

				<article class="card rhythm">
					<span class="font-eyebrow text-brand-primary">Software + Digital presence</span>
					<h3 class="font-heading">The lead lands somewhere that works.</h3>
					<p class="font-body text-neutral-muted">
						Enquiries go into a CRM we configured, route to a named person, and
						trigger a follow-up whether or not anyone's at a desk. When the site
						and the systems behind it belong to different vendors, this is
						exactly where leads go quiet.
					</p>
				</article>

				<article class="card rhythm">
					<span class="font-eyebrow text-brand-primary">All three</span>
					<h3 class="font-heading">One operator, one bill, one number.</h3>
					<p class="font-body text-neutral-muted">
						Nobody establishes whose fault something is. One quarterly review
						covers the software, the books and the campaigns together, so the
						spend and the results are read side by side rather than in three
						separate reports.
					</p>
				</article>
			</div>
		</div>
	</section>

	<!-- CALLOUT: ONE-OFF -->
	<section class="section centered" id="pricing-callouts">
		<div class="spotlight">
			<div class="callout-solo">
				<article class="card callout">
					<span class="font-eyebrow callout-eyebrow callout-eyebrow--muted">
						Something more one-off?
					</span>
					<h3 class="font-heading callout-title">Scoped and billed hourly.</h3>
					<p class="font-body callout-copy">
						Not everything fits a monthly plan. Consulting, implementation,
						migrations, security reviews, systems rollouts, and custom
						integrations are scoped and billed hourly. Ask for our rate — we'll
						size the work plainly before anything begins.
					</p>
				</article>
			</div>
		</div>
	</section>

	<!-- FUNDING: the price objection handler. This is where the cost question
	     actually arises, which is why funding lives here rather than in the nav. -->
	<section class="section centered" id="pricing-funding">
		<div class="spotlight">
			<div class="card funding-block">
				<span class="font-eyebrow">Funding</span>
				<h2 class="font-heading funding-title">
					Ontario may cover part of this.
				</h2>
				<p class="font-body funding-copy">
					Eligible Ontario for-profit SMEs can offset the setup and project side
					of this work through the province's Digital Competence Centre. As of
					July 2026, <strong>DMAP covers up to $15,000</strong> of planning, and
					<strong>TDP up to $50,000</strong> of implementation for businesses that
					have completed a DMAP and clear a $750,000 revenue floor. Ongoing
					monthly service isn't grant-funded.
				</p>
				<p class="font-body funding-copy">
					We'll tell you on the first call whether you plausibly qualify —
					including when you don't. Approval and amounts are decided by OCI, not
					by us.
				</p>
				<div class="cluster funding-actions">
					<a class="cta-ghost" href="/funding">See what's available</a>
					<span class="font-caption funding-note">
						DMAP · TDP · RMPG · BDC LIFT — what each covers and who it rules out
					</span>
				</div>
			</div>
		</div>
	</section>

	<!-- FINE PRINT + CTA -->
	<section class="section centered pricing-close">
		<div class="spotlight fineprint-grid">
			<div class="fineprint">
				<span class="font-eyebrow">The fine print, in plain language</span>
				<ul class="feature-list fineprint-list">
					{finePrint.map((f) => <li>{f}</li>)}
				</ul>
			</div>

			<div class="close-cta">
				<h2 class="font-title close-title">Every business is different.</h2>
				<p class="font-body close-copy">
					Tell us your team size and what you'd like off your plate, and we'll
					put real numbers to it.
				</p>
				<div class="close-actions">
					<a class="cta" href="/#contact">Talk to us <span class="arrow">→</span></a>
					<a class="cta-ghost" href="mailto:hi@vitops.ca">hi@vitops.ca</a>
				</div>
			</div>
		</div>
	</section>
</PineLayout>

<style>
	/* Section intros — mirror the home page rhythm. */
	.section-intro {
		max-width: 60ch;
		margin-bottom: 3rem;
	}
	.section-intro .font-title {
		margin-top: 0.75rem;
		font-size: clamp(2rem, 4vw, 3rem);
	}
	.section-lead {
		margin-top: 1rem;
		color: var(--color-mist);
	}

	.section-note {
		margin-top: 2.5rem;
		text-align: center;
		font-size: var(--text-s);
		color: var(--color-slate);
		font-style: italic;
	}

	/* ---- Plan tiers ----
	   Laid out by the framework's <Subgrid>: it renders the <ul>/<li> and puts
	   `grid-template-rows: subgrid` on each card, so the three tranches — head,
	   feature list, CTA — snap to shared row lines across all cards regardless
	   of feature count.

	   The variable names are the framework's public contract (@getvitops 0.9):
	   --subgrid-cols / --subgrid-row-span / --subgrid-gap / --subgrid-row-gap.
	   They must match exactly — an unrecognised name silently falls back to the
	   pattern's default, and the default row-span is 2 against our 3 tranches,
	   which drops the CTA out of the subgrid and onto its own auto row.

	   --subgrid-gap is BOTH the column gap and the gap between tranches, so it
	   can't be split here; --subgrid-row-gap is extra space once cards wrap.

	   The <ul> and the card <li> are emitted inside the component, so they sit
	   outside this page's style scope — hence :global(). Everything nested in
	   the card is rendered from this file and stays scoped as usual. */
	:global(.pricing-tiers) {
		--subgrid-cols: 3;
		--subgrid-row-span: 3; /* head · feature list · CTA */
		--subgrid-gap: 1.5rem;
		--subgrid-row-gap: 1.5rem; /* extra separation once cards wrap */
		list-style: none;
		margin: 0;
		padding: 0;
	}
	:global(.pricing-tier) {
		padding: 2rem;
	}
	:global(.pricing-tier--featured) {
		background: var(--color-navy-d);
		border: 1px solid var(--color-pine);
		box-shadow: 0 0 0 1px rgba(74, 144, 117, 0.25),
			0 24px 60px -30px rgba(74, 144, 117, 0.5);
	}
	.tier-head {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--line-1);
	}
	.tier-name-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}
	.tier-name {
		margin: 0;
		font-size: var(--text-l);
	}
	.tier-tag {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #0a0d0c;
		background: var(--color-pine);
		padding: 0.25rem 0.6rem;
		border-radius: var(--br-pill, 999px);
		white-space: nowrap;
	}
	.tier-blurb {
		margin-top: 0.75rem;
		font-size: var(--text-s);
		color: var(--color-mist);
	}
	.tier-price {
		margin: 0;
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
	}
	.tier-price__amount {
		font-family: var(--font-display);
		font-size: var(--text-3xl);
		font-weight: 700;
		color: var(--color-snow);
		letter-spacing: -0.02em;
	}
	.tier-price__unit {
		font-size: var(--text-s);
		color: var(--color-slate);
	}
	.tier-cta {
		justify-content: center;
		width: 100%;
		align-self: end; /* pin CTA to the bottom of its (shared) row track */
	}

	/* Shared feature list (matches index.astro) */
	.feature-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		align-content: start; /* the shared row is as tall as the longest list —
		                         start the rows rather than stretching them apart */
		gap: 0.7rem;
	}
	.feature-list li {
		display: flex;
		align-items: baseline;
		gap: 0.65rem;
		font-size: var(--text-s);
		color: var(--color-mist);
	}
	.feature-list li::before {
		content: "✓";
		color: var(--color-pine);
		font-weight: 600;
		font-size: 0.85em;
	}

	/* ---- Website plan tiers: sub-line, Sovereign add-on, add-ons head ---- */
	.tier-sub {
		margin: 0;
		font-size: var(--text-xs);
