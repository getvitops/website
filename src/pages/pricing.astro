<style>
	/* Section intros — mirror the home page rhythm. */
	.section-intro {
		max-width: 60ch;
		margin-bottom: 3rem;
	}
	.section-intro .font-title {
		margin-top: 0.75rem;
		font-size: clamp(2rem, 4vw, 3rem);
	}
	.section-lead {
		margin-top: 1rem;
		color: var(--color-mist);
	}

	.section-note {
		margin-top: 2.5rem;
		text-align: center;
		font-size: var(--text-s);
		color: var(--color-slate);
		font-style: italic;
	}

	/* ---- Plan tiers ----
	   Laid out by the framework's <Subgrid>: it renders the <ul>/<li> and puts
	   `grid-template-rows: subgrid` on each card, so the three tranches — head,
	   feature list, CTA — snap to shared row lines across all cards regardless
	   of feature count.

	   The variable names are the framework's public contract (@getvitops 0.9):
	   --subgrid-cols / --subgrid-row-span / --subgrid-gap / --subgrid-row-gap.
	   They must match exactly — an unrecognised name silently falls back to the
	   pattern's default, and the default row-span is 2 against our 3 tranches,
	   which drops the CTA out of the subgrid and onto its own auto row.

	   --subgrid-gap is BOTH the column gap and the gap between tranches, so it
	   can't be split here; --subgrid-row-gap is extra space once cards wrap.

	   The <ul> and the card <li> are emitted inside the component, so they sit
	   outside this page's style scope — hence :global(). Everything nested in
	   the card is rendered from this file and stays scoped as usual. */
	:global(.pricing-tiers) {
		--subgrid-cols: 3;
		--subgrid-row-span: 3; /* head · feature list · CTA */
		--subgrid-gap: 1.5rem;
		--subgrid-row-gap: 1.5rem; /* extra separation once cards wrap */
		list-style: none;
		margin: 0;
		padding: 0;
	}
	:global(.pricing-tier) {
		padding: 2rem;
	}

	/* ---- The single software plan ----
	   Not a tier card: with no siblings to compare against, a narrow column
	   would just be a tall list. Laid out wide instead — name and price on one
	   row, features in two columns once there's room — so the plan reads as one
	   complete thing rather than as the survivor of a ladder. It borrows
	   .pricing-tier--featured for the accent border, since it is by definition
	   the highlighted option. */
	.plan-solo {
		padding: clamp(1.75rem, 4vw, 2.5rem);
		display: grid;
		gap: 1.75rem;
	}
	.plan-head {
		display: flex;
		flex-wrap: wrap;
		align-items: start;
		justify-content: space-between;
		gap: 1rem 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--line-1);
	}
	.plan-identity {
		max-width: 46ch;
	}
	.plan-identity .tier-blurb {
		margin-top: 0.5rem;
	}
	.plan-price-block {
		display: grid;
		gap: 0.4rem;
		justify-items: start;
	}

	/* Lead-in above the plan card. Accent rule rather than a box: it's a stated
	   position, not a callout, and a bordered card here would compete with the
	   plan it introduces. */
	.neutrality-note {
		max-width: 60ch;
		margin-bottom: 2rem;
		padding-left: 1.25rem;
		border-left: 2px solid var(--color-pine);
		color: var(--color-mist);
	}
	.neutrality-note strong {
		color: var(--color-snow);
	}

	/* ---- Plan example table ----
	   Scrolls inside its own container so the page body never scrolls sideways.
	   Numeric columns right-align; the caption sits below the figures because
	   it qualifies them rather than titling them. */
	.plan-examples {
		overflow-x: auto;
		max-width: 34rem;
	}
	.plan-examples table {
		inline-size: 100%;
		border-collapse: collapse;
		font-size: var(--text-s);
	}
	.plan-examples caption {
		caption-side: bottom;
		text-align: left;
		padding-top: 0.75rem;
		color: var(--color-slate);
	}
	.plan-examples th,
	.plan-examples td {
		padding: 0.6rem 1rem 0.6rem 0;
		text-align: right;
		white-space: nowrap;
		border-bottom: 1px solid var(--line-1);
	}
	.plan-examples thead th {
		font-size: var(--text-xs);
		font-weight: 500;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-slate);
	}
	.plan-examples tbody th,
	.plan-examples thead th:first-child {
		text-align: left;
		color: var(--color-mist);
		font-weight: 500;
	}
	.plan-examples tbody td:last-child {
		color: var(--color-pine-l);
		font-variant-numeric: tabular-nums;
	}
	.plan-examples tbody tr:last-child th,
	.plan-examples tbody tr:last-child td {
		border-bottom: 0;
	}
	/* Multi-column, NOT grid. The bullets vary a lot in length, and a two-column
	   grid puts items 1 and 2 in one row whose height is set by the taller of
	   them — so the short first bullet got padded out with dead space beneath
	   it. `columns` flows the list continuously and balances the two columns
	   instead, so uneven items sit flush. Overrides `display: grid` from the
	   shared .feature-list, which also means `gap` no longer applies — the row
	   rhythm comes from the li margin, and the gutter from column-gap. */
	/* Scoped under .plan-solo for specificity: .feature-list is declared later in
	   this file at equal specificity, so a bare .plan-features rule loses
	   `display` to it and the columns never take effect. Two classes beats one
	   regardless of source order. */
	.plan-solo .plan-features {
		display: block;
		columns: 2;
		column-gap: 2.5rem;
	}
	.plan-solo .plan-features li {
		/* Without this a bullet can be split across the column break mid-sentence. */
		break-inside: avoid;
		margin-bottom: 0.7rem;
	}
	.plan-cta {
		justify-self: start;
	}

