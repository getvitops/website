---
import PineLayout from "../layouts/PineLayout.astro";
import PageHero from "../components/page/PageHero.astro";
import FundingCallout from "../components/page/FundingCallout.astro";
import SectionIntro from "../components/page/SectionIntro.astro";
import Cards from "../components/page/Cards.astro";
import Prose from "../components/page/Prose.astro";
import Faq from "../components/page/Faq.astro";
import PageCta from "../components/page/PageCta.astro";
import Schema from "../components/page/Schema.astro";
import { breadcrumb, service } from "../lib/schema";
import { FUNDING_CALLOUT, FUNDING_NOTE } from "../lib/copy";

export const prerender = false;


const problems = [
	{
		heading: "The deadlines aren't yours to move.",
		body: "CRA remittance dates, benefits enrolment windows, ROE timelines. Miss one and the penalty is out of proportion to the effort of not missing it.",
	},
	{
		heading: "Onboarding is four systems and a memory.",
		body: "HRIS, payroll, benefits, and every application they need access to. When it's held in somebody's head, the day someone forgets is the day a new hire sits idle.",
	},
	{
		heading: "Offboarding is the one that actually costs you.",
		body: "Final pay and the ROE get done because someone chases them. Revoking access across eleven systems doesn't, because nobody's chasing it. Ghost accounts are the most common security finding we make on a new account.",
	},
	{
		heading: "The systems disagree.",
		body: "Payroll thinks she's part-time, the HRIS thinks she's full-time, benefits has her on the old plan. Every mismatch surfaces eventually, usually as a deduction error someone has to explain.",
	},
];

const work = [
	{
		tag: "01 · Joiner, mover, leaver",
		heading: "One workflow, both ends.",
		body: "When someone starts, the record, the paperwork, the payroll and the benefits enrolment are ready before day one; when they leave, the final pay and the ROE go out on time. Paired with any business-software plan, the same trigger provisions their accounts, licences and permissions before day one and revokes access everywhere the same day they leave — one workflow instead of two teams emailing each other.",
	},
	{
		tag: "02 · Payroll",
		heading: "Pay runs, remittances, year-end.",
		body: "Direct deposits, CRA remittances, T4s, ROEs and the year-end, run to schedule — with documentation kept in a state you could hand to an auditor without a week of preparation.",
	},
	{
		tag: "03 · Benefits administration",
		heading: "Enrolments, life events, deductions.",
		body: "Your broker designs and sells the plan; we run the daily administration of it, keep payroll deductions synchronised with what the plan actually says, and answer the employee questions so they don't come to you.",
	},
	{
		tag: "04 · Bookkeeping",
		heading: "The books, current rather than reconstructed.",
		body: "Transaction coding, bank and credit card reconciliations, and a monthly close on a set cadence, so at any point in the year you can see where you actually are rather than finding out in March what happened last May.",
	},
];

// Ordered deliberately: what this is → what it isn't (the three "do you replace
// X" boundary questions together) → how it runs → what it runs on → compliance
// → funding. Flat list, but a reader going top to bottom gets a coherent
// argument rather than a shuffle.
//
// Anything promising account provisioning or same-day revocation MUST say it
// needs the business-software side. Joiner/mover/leaver is in that plan, run
// as a worked process — we don't sell SCIM automation. Neither is priced in these
// back-office services — an answer implying it comes with bookkeeping is
// selling something we don't price here. See the JML note in pricing.astro.
const faq = [
	{
		q: "Is this fractional HR?",
		a: "No. A fractional HR consultant gives you advice and a plan, and you implement it. We do the running: the pay runs go out, the enrolments get processed, the records stay current. If you need someone to design a compensation philosophy, that's a different kind of help and we'll point you at it.",
	},
	{
		q: "Who's the employer of record?",
		a: "You are. We administer; we don't take on employment liability or become a co-employer. That's a deliberate choice — the arrangements that do take it on cost considerably more and constrain how you hire.",
	},
	{
		q: "Do you replace our accountant?",
		a: "No. We keep the books; your CPA does year-end, tax planning, and anything a lender or buyer needs. The two roles are complementary, and accountants generally prefer working from books that were maintained rather than assembled in a hurry — it makes their half cheaper too.",
	},
	{
		q: "Do you replace our bookkeeper or office manager?",
		a: "The bookkeeping, often yes — that's a service we run outright, and clients frequently come to us to take it over. An office manager, usually not: more often we take the pieces they dread and give them their week back. Where a role genuinely overlaps we'll say so rather than quietly duplicating it, and the comparison worth doing is against what the coverage costs to hire.",
	},
	{
		q: "Can I take just one of these services?",
		a: "Yes. Bookkeeping, managed payroll and benefits administration are priced and sold separately, and plenty of clients start with one. Combining them lowers the total from the second service on, but nothing here requires you to take the rest. The HRIS itself isn't on this list — it sits in the business software plans, because the joiner/mover/leaver workflow runs against it.",
	},
	{
		q: "How current do the books stay?",
		a: "Reconciliations and coding run on a set cadence with a proper month-end close, so at any point in the year you can see where you actually are. The alternative most owners live with is finding out in March what happened last May.",
	},
	{
		q: "Does onboarding and offboarding come with this?",
		a: "The HR half does — the record, the paperwork, the payroll and benefits setup, the ROE on the way out. The part people usually mean, where accounts, licences and permissions are provisioned before day one and revoked everywhere the same day someone leaves, is identity work: it comes with the business-software plan rather than with these services. Take back office alone and we run the HR side of a joiner or leaver; take both and the two ends become one workflow with nothing handed between them.",
	},
	{
		q: "How does this connect to the software side?",
		a: "When you take both, it's the same workflow seen from two ends: HR processes a new hire and the accounts, licences and permissions follow; HR processes a termination and access revokes across every system that day. That half of it is the business-software side, which covers it as standard. It's a worked process rather than an automated pipeline — the thing that makes it reliable is that one team holds both ends, not that a script runs it. Companies that split these between two vendors are the ones with ghost accounts, and they usually don't know it.",
	},
	{
		q: "What accounting software do you use?",
		a: "Whatever you're on, if it's working — usually QuickBooks or Xero. If we also run your software stack, we own the bank feeds, receipt capture and the integrations into payroll and your CRM rather than working around whatever someone else configured; if we don't, we work with what's there.",
	},
	{
		q: "What payroll software do you use?",
		a: "Whatever you're already on, if it's sound — we'd rather not move you. Where you're choosing from scratch or the current system is fighting you, we'll recommend based on your size, complexity and province mix, and handle the migration.",
	},
	{
		q: "Do you handle Ontario-specific compliance?",
		a: "We keep records and processes aligned with ESA requirements, WSIB reporting and CRA remittance obligations, and we flag when something's changed. We don't provide legal opinions or guarantee compliance — that's your counsel's role, and anyone promising otherwise is overselling.",
	},
	{
		q: "Can government funding cover this?",
		a: "The systems work often qualifies. DMAP covers up to $15,000 of planning for eligible Ontario for-profit SMEs, and TDP up to $50,000 of implementation after a completed DMAP. Ongoing administration isn't grant-funded. We'll tell you which parts of your project plausibly qualify before you apply.",
	},
];
---

<PineLayout
	title="Bookkeeping, payroll and back-office operations"
	description="Bookkeeping kept current, managed payroll, benefits administration, and onboarding and offboarding handled end to end. Ontario SMEs, one partner on file."
>
	<Schema
		data={service(
			"Back-office operations",
			"Managed payroll, benefits administration, employee lifecycle and bookkeeping for Ontario small businesses.",
			"/back-office",
		)}
	/>
	<Schema data={breadcrumb(["Back office", "/back-office"])} />

	<FundingCallout
		text={FUNDING_CALLOUT}
	/>

	<PageHero
		eyebrow="Back office"
		title="The admin that never stops, taken off your desk."
		lead="The books, payroll, benefits changes, onboarding paperwork, the access that goes with it. None of it is hard. It's just relentless, and it lands on whoever is closest — usually you, usually at the wrong time of day."
		secondaryLabel="See pricing"
		secondaryHref="/pricing"
		note={FUNDING_NOTE}
	/>

	<Prose lead>
		<p>
			Back-office operations covers the recurring administrative work of
			employing people and running a company: keeping the books current, running
			payroll and remitting to the CRA, administering the group benefits plan,
			processing joiners, movers and leavers across every system, and keeping
			the records in a state that survives an audit.
			For most Ontario businesses under 150 people it's between half a day and
			two days a week of someone's time, and it's almost never that person's
			actual job.
		</p>
	</Prose>

	<section class="section centered">
		<div class="spotlight">
			<SectionIntro
				eyebrow="What goes wrong"
				title="It's not difficult. It's just never finished."
				lead="Every one of these tasks is manageable in isolation. What makes them expensive is that they arrive continuously, they can't be deferred, and getting one wrong is disproportionately costly."
			/>
			<Cards cards={problems} />
		</div>
	</section>

	<section class="section centered">
		<div class="spotlight">
			<SectionIntro eyebrow="What we do" title="Four running jobs, on a schedule." />
			<Cards cards={work} />
		</div>
	</section>

	<!-- BOOKKEEPING: pulled out of the grid deliberately. It's a lead driver in
	     its own right, and the differentiator below only lands with room. -->
	<section class="section centered" id="bookkeeping">
		<div class="spotlight">
			<div class="card bookkeeping-block">
				<span class="font-eyebrow">Bookkeeping</span>
				<h2 class="font-title bookkeeping-title">
					Books that are current, not reconstructed in March.
				</h2>
				<p class="font-body bookkeeping-lead">
					Most owners find out what state their books are in when their
					accountant does — months later, at a rate that reflects the cleanup.
					Kept current, the same work costs less and tells you something while
					it's still worth knowing.
				</p>

				<div class="bookkeeping-grid">
					<article>
						<h3 class="font-heading">What we run</h3>
						<p class="font-body">
							Transaction coding, bank and credit card reconciliations,
							payables and receivables, receipt and expense capture, and the
							month-end close. On a set cadence, so there is never a quarter
							nobody has looked at.
						</p>
					</article>
					<article>
						<h3 class="font-heading">Why ours is different</h3>
						<p class="font-body">
							Most bookkeepers work <em>in</em> your accounting software. We
							also run it — the bank feeds, the receipt capture, and the
							integrations to payroll and your CRM are ours too. So the payroll
							journal lands coded properly instead of as a lump someone has to
							unpick, and nothing waits on a handoff between three vendors who
							have never spoken.
						</p>
					</article>
					<article>
						<h3 class="font-heading">Where we stop</h3>
						<p class="font-body">
							Your CPA still does year-end, tax planning, and any statements a
							lender or a buyer needs. We keep the books they work from, in a
							state that doesn't need a week of repair first — which is usually
							the cheaper half of that relationship.
						</p>
					</article>
				</div>

				<div class="cluster bookkeeping-actions">
					<a class="cta" href="/#contact">Talk to us <span class="arrow">→</span></a>
					<span class="font-caption bookkeeping-note" set:html={FUNDING_NOTE} />
				</div>
			</div>
		</div>
	</section>

	<section class="section centered">
		<div class="spotlight">
			<SectionIntro
				eyebrow="What we don't do"
				title="We run it. We don't advise on it."
				lead="Worth being exact about, because the distinction gets blurred in this market and the blurring is usually deliberate."
			/>
			<div class="prose-inline">
				<p class="font-body">
					We administer systems and process. We are not your lawyer, your
					accountant, or your benefits broker, and we don't replace them. Tax
					positions stay with your CPA. Employment law questions stay with
					counsel. Plan design stays with your licensed advisor. Clinical
					decisions stay with your clinicians.
				</p>
				<p class="font-body">
					You remain the employer of record throughout — this is not a PEO
					arrangement and we don't take on that liability. What we take on is
					the running of it, which is the part actually consuming your week.
				</p>
				<p class="font-body limit">
					Under about five employees this rarely pays for itself; the admin
					isn't yet heavy enough to justify handing over. We'll tell you if we
					think you're there, and we'd rather set you up properly and revisit in
					a year.
				</p>
			</div>
			<p class="font-caption industry-row">
				This lands differently depending on what you run — <a
					class="link"
					href="/industries">see who we work with</a
				>.
			</p>
		</div>
	</section>

	<Faq items={faq} />

	<PageCta
		title="Tell us what's landing on your desk."
		lead="Describe a normal month — the pay run, the paperwork, the person who left in March whose account might still be live. We'll tell you what we'd take and what it would cost."
		note={FUNDING_NOTE}
		links={[
			{ label: "Business software", href: "/business-software" },
			{ label: "Digital presence", href: "/digital-presence" },
			{ label: "Pricing", href: "/pricing" },
		]}
	/>
</PineLayout>

<style>
	.prose-inline {
		max-width: 68ch;
		color: var(--color-mist);
		display: grid;
		gap: 1.1rem;
	}
	.prose-inline .limit {
		padding-top: 1.1rem;
		border-top: 1px solid var(--line-1);
		color: var(--color-slate);
	}
	.industry-row {
		margin-top: 2rem;
		color: var(--color-slate);
	}

	/* Bookkeeping — deliberately heavier than a card in the grid, because it
	   pulls its own weight as a lead driver. */
	.bookkeeping-block {
		padding: clamp(1.75rem, 4vw, 3rem);
		border: 1px solid color-mix(in srgb, var(--color-pine) 28%, transparent);
		background: color-mix(in srgb, var(--color-pine) 7%, var(--color-navy-d));
		display: grid;
		gap: 1rem;
	}
	.bookkeeping-title {
		margin: 0.25rem 0 0;
		font-size: clamp(1.6rem, 3.2vw, 2.2rem);
		max-width: 22ch;
	}
	.bookkeeping-lead {
		color: var(--color-mist);
		max-width: 64ch;
		margin: 0;
	}
	.bookkeeping-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
		margin-top: 1.25rem;
		padding-top: 1.75rem;
		border-top: 1px solid var(--line-1);
	}
	.bookkeeping-grid h3 {
		margin: 0 0 0.6rem;
	}
	.bookkeeping-grid p {
		margin: 0;
		color: var(--color-mist);
		font-size: var(--text-s);
	}
	.bookkeeping-actions {
		margin-top: 1.5rem;
		align-items: center;
		gap: 1rem 1.5rem;
	}
	.bookkeeping-note {
		color: var(--color-slate);
	}

	@media (max-width: 860px) {
		.bookkeeping-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
	}
</style>
