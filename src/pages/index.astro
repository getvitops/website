---
import PineLayout from "../layouts/PineLayout.astro";
import HeroA from "../components/sections/Hero.astro";
import HeroB from "../_b/sections/Hero.astro";
import Pain from "../components/sections/Pain.astro";
import Services from "../components/sections/Services.astro";
import StackSection from "../components/sections/StackSection.astro";
import PreferredVendors from "../components/sections/PreferredVendors.astro";
import PreferredHosting from "../components/sections/PreferredHosting.astro";
import PresenceSection from "../components/sections/PresenceSection.astro";
import Contact from "../components/sections/Contact.astro";
import { pick } from "../lib/variant";

export const prerender = false;

// A/B layer 2: hero challenger resolved per request. Variant is set in
// src/middleware.ts from the sticky `ab_variant` cookie.
const Hero = pick(HeroA, HeroB, Astro.locals.variant);
---

<PineLayout description="Vitops runs your digital presence and your IT and HR operations. Managed websites and ad campaigns, plus a fully managed software, identity, and device stack.">
	<Hero />
	<Pain />
	<Services />
	<StackSection />
	<PreferredVendors />
	<PreferredHosting />
	<PresenceSection />
	<Contact />
</PineLayout>
