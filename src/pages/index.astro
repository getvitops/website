---
import PineLayout from "../layouts/PineLayout.astro";
import Hero from "../components/sections/Hero.astro";
import Pain from "../components/sections/Pain.astro";
import Services from "../components/sections/Services.astro";
import StackSection from "../components/sections/StackSection.astro";
import KeyPartners from "../components/sections/KeyPartners.astro";
import Contact from "../components/sections/Contact.astro";

// Prerendered: no per-request data on this page. EmDash pins the site to
// output:"server" — its injected /_emdash/* dynamic routes would each need
// getStaticPaths() under output:"static" — so prerendering is opted into
// per page. Only /api/contact and the A/B dispatcher stay on-demand.
export const prerender = true;

---

<PineLayout
	title="Digital presence, back office, and business software, handled for you"
	description="Vitops runs your digital presence and your IT and HR operations. Managed websites and ad campaigns, plus your software stack selected, integrated, secured and run."
>
	<Hero />
	<Pain />
	<Services />
	<StackSection />
	<KeyPartners />
	<Contact />
</PineLayout>
