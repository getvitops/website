---
import PineLayout from "../layouts/PineLayout.astro";
import PageHero from "../components/page/PageHero.astro";
import SectionIntro from "../components/page/SectionIntro.astro";
import Cards from "../components/page/Cards.astro";
import Prose from "../components/page/Prose.astro";
import PageCta from "../components/page/PageCta.astro";
import Schema from "../components/page/Schema.astro";
import { breadcrumb, organizationGraph } from "../lib/schema";

export const prerender = false;

// The entity page. `organizationGraph` is the canonical Organization node —
// founders, credentials and sameAs live in src/lib/schema.ts so every mention
// of "Vitops" resolves to the same entity. See content-plan/geo.md.
//
// Bios are written without pronouns: neither founder's are on record.

const decisions = [
	{
		heading: "We publish our prices.",
		body: "Per seat, on the pricing page. Not “contact us for a quote”, which usually means the number depends on what you look like you can pay.",
	},
	{
		heading: "Month to month, 30 days' notice.",
		body: "No annual lock-in on either service. We'd rather earn it monthly than hold it contractually.",
	},
	{
		heading: "You own what we build.",
		body: "Websites on open standards, systems in your tenants, records in accounts with your name on them. If you leave, you leave with everything, and we'll help you hand it over.",
	},
	{
		heading: "We'll tell you not to buy things.",
		body: "The first pass on a new account usually finds duplicate tools and licences nobody has opened in months. Saying so is a better first month than selling you something else.",
	},
];
---

<PineLayout
	title="About Vitops — the two halves of a back office"
	description="Vitops was started by an HR operations specialist and a digital presence engineer. Here's who runs it, how we work, and who we're a good fit for."
>
	<Schema data={organizationGraph} />
	<Schema data={breadcrumb(["About", "/about"])} />

	<PageHero
		eyebrow="About"
		title="Two halves of the same job."
		lead="Vitops was started by two people who had each spent years fixing one half of the same problem, from opposite ends, for the same kind of business. The company is what happens when you stop handing the work between them."
		secondaryLabel="See pricing"
		secondaryHref="/pricing"
	/>

	<Prose lead>
		<p>
			Vitops is an Ottawa-based operations partner for Ontario small businesses,
			founded by Justin Lang and Alex Gagnon. Justin holds a PhD in Population
			Health and built ViAbilityHR, an outsourced HR firm serving Ontario small
			businesses. Alex holds a Master of Computer Science with a focus on AI and
			built Monad Media, a digital presence and IT consulting practice. Vitops
			runs both halves — the digital presence a business is seen through, and
			the software and back-office operations behind it — under one partner
			rather than two vendors.
		</p>
	</Prose>

	<section class="section centered">
		<div class="spotlight">
			<SectionIntro
				eyebrow="Why we started it"
				title="The gap was always between the two vendors, not inside either one."
			/>
			<div class="prose-inline">
				<p class="font-body">
					Justin had spent a decade studying how workplaces affect people's
					health, then built a company running HR, payroll and absence
					management for Ontario small businesses. Alex had spent those years
					building websites, search presence and the systems underneath them for
					the same kind of company.
				</p>
				<p class="font-body">
					Working the same market from opposite ends, we kept arriving at the
					same finding from different directions. The HR side would fix an
					onboarding process and then wait days on whoever handled IT to
					actually create the accounts. The technology side would build a site
					that generated leads for a business with no process to answer them.
					Neither problem was inside either discipline. Both were in the seam
					between them, and the seam was exactly where nobody was accountable.
				</p>
				<blockquote class="pull-quote font-quote">
					Every vendor we watched do this well did half of it, and then waited
					on someone else.
				</blockquote>
				<p class="font-body">
					That seam is what Vitops is for. When the same partner runs the
					joiner-mover-leaver process and the identity system it writes into,
					onboarding isn't a handoff. When the same partner runs the campaign
					and the CRM the lead lands in, nothing is anyone else's fault.
				</p>
			</div>
		</div>
	</section>

	<section class="section centered">
		<div class="spotlight">
			<SectionIntro eyebrow="Co-founder" title="Justin Lang — back office and workplace health." />
			<div class="prose-inline">
				<p class="font-body">
					Justin holds a PhD in Population Health and spent more than a decade
					studying how workplaces shape people's health and wellness —
					specifically how absence, disability and injury move through a
					business, and how much of the cost is process rather than
					circumstance.
				</p>
				<p class="font-body">
					That research became ViAbilityHR, an Ottawa outsourced HR firm running
					payroll, benefits administration, compliance and integrated absence
					management for Ontario small businesses. The recurring finding there
					was that most small employers weren't underserved because HR is hard;
					they were underserved because everything available to them was an
					enterprise system with the price cut and the fit left alone.
				</p>
				<p class="font-body">
					At Vitops, Justin owns the back office: payroll, benefits, HR
					operations, and the employee lifecycle end of joiner-mover-leaver.
				</p>
				<p class="font-caption">
					<a
						class="link"
						href="https://www.linkedin.com/in/justinl-viabilityhr"
						rel="noopener">LinkedIn</a
					>
				</p>
			</div>
		</div>
	</section>

	<section class="section centered">
		<div class="spotlight">
			<SectionIntro eyebrow="Co-founder" title="Alex Gagnon — software, presence and AI." />
			<div class="prose-inline">
				<p class="font-body">
					Alex holds a Master of Computer Science with a focus on artificial
					intelligence, and built Monad Media, an Ottawa practice doing digital
					presence and IT consulting for Canadian startups and small businesses
					— websites, hosting, search, and the systems around them.
				</p>
				<p class="font-body">
					The position there was that performance and technical search health
					are not upsells to be sold separately; they're either in the build or
					the build is deficient.
				</p>
				<p class="font-body">
					At Vitops, Alex owns the software stack and the digital presence:
					selection, implementation and integration, AI enablement where it
					earns its place, and the website, search and campaign work in front of
					it.
				</p>
				<p class="font-body credentials">
					Master of Computer Science, focused on artificial intelligence.
					Microsoft Certified: Azure Solutions Architect Expert, and certified
					in Security, Compliance and Identity.
				</p>
				<p class="font-caption">
					<a
						class="link"
						href="https://www.linkedin.com/in/alex-gagnon-658108189/"
						rel="noopener">LinkedIn</a
					>
				</p>
			</div>
		</div>
	</section>

	<section class="section centered">
		<div class="spotlight">
			<SectionIntro
				eyebrow="How the work is owned"
				title="Two of us. One of us on your account."
				lead="Worth being precise about, because “one point of contact” is a claim every provider makes and most of them mean an account manager."
			/>
			<div class="prose-inline">
				<p class="font-body">
					Each account has one of us on it as the owner — the person who makes
					the decisions, does the work, and picks up when something breaks. Not
					a queue, and not someone relaying your question to the person who
					actually knows.
				</p>
				<p class="font-body">
					What the second founder gives you is that the other half of the job
					doesn't become somebody else's vendor. When your onboarding process
					needs to write into your identity system, that's one conversation
					between two people who built the company together, not a ticket
					between two firms who've never met.
				</p>
				<p class="font-body limit">
					The honest constraint: this doesn't scale indefinitely, so we take on
					a limited number of accounts. If we're at capacity we'll say so rather
					than stretching and doing it badly.
				</p>
			</div>
		</div>
	</section>

	<section class="section centered">
		<div class="spotlight">
			<SectionIntro
				eyebrow="How we work"
				title="Four things we've decided, so you don't have to ask."
			/>
			<Cards cards={decisions} />
		</div>
	</section>

	<section class="section centered">
		<div class="spotlight">
			<SectionIntro eyebrow="Fit" title="Who this works for, and who it doesn't." />
			<div class="fit-grid">
				<article class="fit">
					<h3 class="font-heading">Works well for</h3>
					<p class="font-body">
						Ontario owner-led businesses roughly between 5 and 150 people — past
						spreadsheets and the owner-as-accidental-IT stage, not ready for an
						internal department. Trades and contractors, real estate
						brokerages, legal and accounting firms, medical and dental clinics:
						the four we know deeply enough to be useful in the first week.
					</p>
					<p class="font-caption">
						<a class="link" href="/industries">More on industries →</a>
					</p>
				</article>
				<article class="fit">
					<h3 class="font-heading">Not a good fit</h3>
					<p class="font-body">
						Under about five employees, where the admin isn't yet heavy enough
						to be worth handing over. Anyone wanting an enterprise brand
						campaign — a different discipline, and not ours. Anyone needing
						desk-side hardware repair; we manage warranties and get replacements
						enrolled, but somebody local is physically handling the device. And
						anyone who wants a vendor rather than a partner. This works when
						we're in the operating decisions, not taking tickets.
					</p>
				</article>
			</div>
		</div>
	</section>

	<section class="section centered">
		<div class="spotlight">
			<SectionIntro
				eyebrow="Coverage"
				title="Ottawa first, Ontario throughout, Canada remotely."
			/>
			<div class="prose-inline">
				<p class="font-body">
					We're based in Ottawa and work with businesses across the region —
					downtown, Kanata, Stittsville, Nepean, Barrhaven, Riverside South,
					Manotick, Orleans, Vanier, Gloucester and the surrounding communities.
				</p>
				<p class="font-body">
					Everything we do is delivered securely online, so we work throughout
					Ontario — Toronto, Mississauga, Brampton, Hamilton, Kitchener, London,
					Windsor — and with businesses elsewhere in Canada, including Halifax,
					Calgary, Edmonton and Vancouver.
				</p>
			</div>
		</div>
	</section>

	<section class="section centered">
		<div class="spotlight">
			<SectionIntro
				eyebrow="What we're not"
				title="The boundaries, stated plainly."
			/>
			<div class="prose-inline">
				<p class="font-body">
					We administer systems and operations. We're not your accountant, your
					lawyer, your benefits broker, or your clinician. Tax positions stay
					with your CPA, legal opinions with your counsel, plan design with your
					licensed advisor, clinical decisions with the people qualified to make
					them. On funding, approval and amounts are decided by OCI, not by us.
				</p>
				<p class="font-body">
					You remain the employer of record for your staff. This is not a PEO
					arrangement and we don't take on employment liability.
				</p>
			</div>
		</div>
	</section>

	<PageCta
		title="Tell us what you're running."
		links={[
			{ label: "Business software", href: "/business-software" },
			{ label: "Digital presence", href: "/digital-presence" },
			{ label: "Back office", href: "/back-office" },
			{ label: "Industries", href: "/industries" },
			{ label: "Pricing", href: "/pricing" },
			{ label: "Funding", href: "/funding" },
		]}
	/>
</PineLayout>

<style>
	.prose-inline {
		max-width: 68ch;
		color: var(--color-mist);
		display: grid;
		gap: 1.1rem;
	}
	.prose-inline .limit {
		padding-top: 1.1rem;
		border-top: 1px solid var(--line-1);
		color: var(--color-slate);
	}
	.credentials {
		margin-top: 0.5rem;
		padding-inline-start: 1.25rem;
		border-inline-start: 2px solid var(--color-pine);
		color: var(--color-snow);
	}
	.pull-quote {
		margin: 1rem 0;
		padding-inline-start: 1.5rem;
		border-inline-start: 2px solid var(--color-pine);
		font-size: var(--text-l);
		color: var(--color-snow);
	}
	.fit-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
	}
	.fit {
		padding-inline-start: 1.25rem;
		border-inline-start: 1px solid var(--line-1);
	}
	.fit h3 {
		margin: 0 0 0.75rem;
	}
	.fit p {
		color: var(--color-mist);
	}

	@media (max-width: 860px) {
		.fit-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
