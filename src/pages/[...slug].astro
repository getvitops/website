---
import { getEmDashCollection } from 'emdash';
import { PortableText } from 'emdash/ui';
import PageBlocks from '../components/PageBlocks.astro';
import Layout from '../layouts/Layout.astro';

// Prerendered: every published `pages` entry becomes a static file at its slug. A URL not in
// the list has no route, so Astro serves the prerendered 404 with a real 404 status (no
// Astro.rewrite('/404'): rewriting an on-demand route to a prerendered one is a 500).
export const prerender = true;

export async function getStaticPaths() {
  const { entries, error } = await getEmDashCollection('pages');
  // Fail the build rather than ship a site with no pages.
  if (error) throw error;
  return entries
    .filter((entry) => entry.data.slug !== 'home') // served by index.astro
    .map((entry) => ({ params: { slug: entry.data.slug as string }, props: { page: entry } }));
}

const { page } = Astro.props;

// `page.data` is typed `unknown` until `.emdash/types.ts` is generated from a
// running site (`pnpm dev`, then `emdash types`), so a fresh scaffold would fail
// `astro check`; the cast keeps it passing both before and after, where the
// generated type is already `string`.
const title = page.data.title as string | undefined;
const layout = page.data.layout as unknown[] | undefined;
---

<Layout title={title} entry={page}>
  {
    layout && layout.length > 0 ? (
      <PageBlocks value={layout} />
    ) : (
      <article class="centered rhythm region">
        <h1>{title}</h1>
        {page.data.content && <PortableText value={page.data.content} />}
      </article>
    )
  }
</Layout>
